        if (GameState.pFocus < 40) return;
        GameState.pFocus -= 40;
        GameState.slowMoActive = true;
        if (GameState.incomingShot) {
          GameState.incomingShot.overlapTime += 450;
          GameState.incomingShot.expireTime += 650;
        }
        SoundEngine.playHit('perfect');
        showCanvasBanner('⏱️ 极速慢放开启!', '判定窗口扩大 +50%', '#38bdf8');
        updateAllUI();
      });
      document.getElementById('btnSkillSteady').addEventListener('click', () => {
