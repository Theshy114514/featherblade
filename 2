          { id: 'f_rush', name: '🩸 制胜扣杀·瞬步扑杀 [点击屏幕/1]', desc: '赛场血芒撕裂网前 · 直接得1分', color: 'from-rose-700/80 to-slate-950 border-amber-400' },
          { id: 'f_smash', name: '☄️ 制胜扣杀·天陨断头杀 [2]', desc: '腾空雷霆血色重炮 · 直接得1分', color: 'from-amber-600/80 to-rose-950 border-amber-300' },
          { id: 'f_drop', name: '💀 制胜扣杀·死角斩魂吊 [3]', desc: '极致羞辱制胜扣杀 · 直接得1分', color: 'from-purple-700/80 to-slate-950 border-amber-400' }
        ];
        finishers.forEach(f => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `shot-btn bg-gradient-to-b ${f.color} border-2 rounded-xl p-2 text-left flex flex-col justify-between perfect-glow`;
          btn.innerHTML = `<div class="font-black text-xs sm:text-sm text-white">${f.name}</div><div class="text-[10px] text-amber-200">${f.desc}</div>`;
          btn.addEventListener('click', () => executeBreakFinisher(f));
          container.appendChild(btn);
        });
        return;
      }

      // PHASE 4: 感官慢动作镜头 II · 步伐强绑定专属球路抉择 + 重心正负零 (+-0) 反馈
      qteBar.classList.add('hidden');
      const fw = FOOTWORK_DIRS[GameState.selectedFootworkDir] || FOOTWORK_DIRS.down;
      const prevSym = GameState.cogSymbol || '0';

      badge.textContent = `👁️ 感官慢动作 II · ${fw.arrow}${fw.name}`;
      badge.className = 'px-2 py-0.5 rounded text-[10px] font-black bg-amber-500/30 text-amber-200 border border-amber-400 shrink-0 animate-pulse';

      prompt.textContent = `当前步伐【${fw.name}】仅解锁对应区域专属球路！当前重心 [${prevSym}]（注意：[+]与[-]直接切换未经过[0]会触发失衡慢0.5秒）：`;

      const st = getCurrentStage();
      const activeImm = st.immunity === '动态轮换' ? GameState.aiDynamicImmunity : st.immunity;
      const hermesDiscount = hasBoon('hermes') ? 0.5 : 1.0;
      const openCourtInfo = getAiOpenCourtInfo();

      // 严格按照所选八向步伐的 allowedShots 过滤球路（网前步伐绝不出现杀球/平高/高远，后场步伐绝不出现搓球/放网/勾对角！）
      const allowedNames = fw.allowedShots || ['高远球', '吊球', '重杀'];
      allowedNames.slice(0, 4).forEach((shotName, idx) => {
        const s = SHOTS[shotName];
        if (!s) return;

        const cogInfo = getShotCogInfo(s.name);
        const nextSym = cogInfo.sym;
        const willImbalance = (prevSym === '+' && nextSym === '-') || (prevSym === '-' && nextSym === '+');
        const willRecoverZero = (GameState.cogImbalanced && nextSym === '0');

        const isImmune = activeImm === s.name && !(GameState.zeusCharged && s.trajType === 'smash');
        const isOpenCourtShot = openCourtInfo && openCourtInfo.shots.includes(s.name);
        const isComboRec = isShotRecommendedForCombo(s.name) || willRecoverZero;

        let styleCls = 'from-slate-900 to-slate-950 border-amber-500/50';
        if (nextSym === '+') {
          styleCls = 'from-rose-950/90 to-slate-950 border-rose-500/85';
        } else if (nextSym === '-') {
          styleCls = 'from-cyan-950/90 to-slate-950 border-cyan-400/85';
        } else {
          styleCls = 'from-emerald-950/90 to-slate-950 border-emerald-400/85';
        }

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `shot-btn bg-gradient-to-b ${styleCls} border ${
          (isComboRec || isOpenCourtShot) ? 'border-amber-400 perfect-glow' : ''
        } rounded-xl p-2 text-left flex flex-col justify-between hover:brightness-125`;

        const dispCost = Math.max(1, Math.round(s.cost * hermesDiscount));
        let symBadgeHtml = '';
        if (willImbalance) {
          symBadgeHtml = `<span class="text-[9px] px-1 rounded bg-rose-600 text-white font-black animate-pulse">⚠️[${prevSym}]→[${nextSym}]失衡慢0.5s</span>`;
        } else if (willRecoverZero) {
          symBadgeHtml = `<span class="text-[9px] px-1 rounded bg-emerald-400 text-slate-950 font-black">✅[0]解除失衡</span>`;
        } else if (nextSym === '+') {
          symBadgeHtml = `<span class="text-[10px] px-1.5 rounded bg-amber-500/30 text-amber-200 border border-amber-400/50 font-mono font-black">[+] 高重心</span>`;
        } else if (nextSym === '-') {
          symBadgeHtml = `<span class="text-[10px] px-1.5 rounded bg-cyan-500/30 text-cyan-200 border border-cyan-400/50 font-mono font-black">[-] 低重心</span>`;
        } else {
          symBadgeHtml = `<span class="text-[10px] px-1.5 rounded bg-emerald-500/30 text-emerald-200 border border-emerald-400/50 font-mono font-black">[0] 标准重心</span>`;
        }

        btn.innerHTML = `
          <div class="flex items-center justify-between gap-1">
            <span class="font-black text-xs sm:text-sm text-white truncate">${s.icon} ${s.name} [${idx + 1}]</span>
            ${symBadgeHtml}
          </div>
          <div class="text-[10px] text-amber-200/90 truncate">🏸动作：${cogInfo.racketAct}</div>
          <div class="text-[9px] text-slate-300 truncate">${isImmune ? '⚠️Boss免疫90%' : `耗体${dispCost} · 破绽+${s.postureDmg} · ${s.desc}`}</div>
        `;

        btn.addEventListener('click', () => {
          const now = performance.now();
          if (GameState.swingLock || now - GameState.pressSwipe.lastFiredAt < 180) return;
          GameState.pressSwipe.active = false;
          GameState.pressSwipe.lastFiredAt = now;
          executePlayerOffenseShot(s, 0, 0);
        });

        container.appendChild(btn);
      });
    }

    // ==================== 9. PRE-SWING WINDUP (110ms) + HIT STOP (80ms) + 3D SHUTTLE LAUNCH ====================
    function launchShuttle(sx, sy, tx, ty, opts = {}) {
      const sh = GameState.shuttle;
      const trajType = opts.trajType || 'high';
      sh.startX = sx;
      sh.startY = sy;
      sh.x = sx;
      sh.y = sy;
      sh.targetX = tx;
      sh.baseTargetX = tx;
      sh.targetY = ty;
      sh.spinType = opts.spinType || null;
      sh.spinDir = opts.spinDir || 0;
      sh.spinAngle = Math.atan2(ty - sy, tx - sx);
      sh.spinSpeed = (trajType === 'smash' || trajType === 'flat') ? 0.46 : (trajType === 'high' ? 0.28 : 0.20);
      sh.squashTimer = 95;
      sh.trajType = trajType;
      sh.speed = opts.speed || (trajType === 'smash' ? 0.068 : (trajType === 'high' ? 0.023 : (trajType === 'flat' ? 0.052 : 0.036)));
      sh.gravity = opts.gravity || (trajType === 'smash' ? 0.60 : (trajType === 'high' ? 0.45 : 0.50));
      sh.drag = opts.drag || (trajType === 'smash' ? 0.08 : (trajType === 'high' ? 0.40 : 0.52));
      sh.startZ = trajType === 'smash' ? 0.62 : 0.24;
      sh.z = sh.startZ;
      sh.progress = 0;
      sh.inFlight = true;
      sh.landed = false;
      sh.trail = [];
      sh.ghosts = [];

      if (opts.trailColor) sh.trailColor = opts.trailColor;
      else if (trajType === 'smash') sh.trailColor = '#f43f5e';
      else if (trajType === 'high') sh.trailColor = '#f59e0b';
      else if (trajType === 'drop') sh.trailColor = '#c084fc';
      else sh.trailColor = '#38bdf8';
    }
    const launchShuttlecock = launchShuttle;

    function performSwingThenLaunch(vis, poseType, swingType, isJump, launchCallback, lockTag = 'swingWindup') {
      if (lockTag === 'playerSwing') {
        if (GameState.swingLock) return false;
        GameState.swingLock = true;
      }
      vis.poseType = poseType;
      vis.swingType = swingType;
      vis.swingAnim = 1.0;
      if (isJump) {
        vis.jumpHeight = 1.0;
        if (vis === GameState.playerVisual) spawnPlayerSmashAfterimages();
      }
      SoundEngine.playSwish();

      scheduleAction(110, () => {
        if (lockTag === 'playerSwing') GameState.swingLock = false;
        // 羽毛球触球顿帧：普通击球强制冻结 40ms，重杀冻结 80ms，配合拍线绷紧高频音与镜头特写推拉
        GameState.hitStop = (swingType === 'smash' || isJump) ? 80 : 40;
        vis.impactSpark = 1.0;
        SoundEngine.playStringTension();
        // 【击球特写】：当触发击球（hitStop > 0）时，瞬间将 camZoom 设为 1.35，camFocus 设为击球点
        GameState.camZoom = 1.35;
        GameState.camFocus = { x: vis.x, y: vis.y };
        GameState.camZoomOutElapsedMs = 0;
        GameState.camState.zoom = 1.35;
        GameState.camState.focusX = vis.x;
        GameState.camState.focusY = vis.y;
        GameState.camState.targetZoom = 1.35;
        GameState.camState.targetFocusX = vis.x;
        GameState.camState.targetFocusY = vis.y;
        GameState.camState.holdTimer = 60;
        GameState.camState.blurTimer = (swingType === 'smash' || isJump) ? 170 : 90;
        launchCallback();
      }, lockTag);
      return true;
    }

    function executePlayerServe(serveType, cost) {
      if (GameState.paused || GameState.swingLock || GameState.phase !== 'serve') return;
      // 立即切换阶段为 'shuttle_to_ai'，彻底杜绝发球连点！
      GameState.phase = 'shuttle_to_ai';
      GameState.timeScale = 1.0;
      GameState.timeScaleTimer = 0;
      applyCogSymbolTransition('0', serveType === 'high' ? '高远球' : '放网');
      syncCenterFootworkCompass();
      renderActionDeck();
      SoundEngine.startBgm();
      const actualCost = hasBoon('hermes') ? cost * 0.5 : cost;
      GameState.pStamina = Math.max(10, GameState.pStamina - actualCost);
      GameState.rallyCount = 1;
      GameState.playerLastActionTime = performance.now();
      GameState.lastPlayerShot = serveType === 'high' ? '高远球' : (serveType === 'flat' ? '平高球' : '放网');
      GameState.lastPlayerTraj = serveType === 'high' ? 'high' : (serveType === 'flat' ? 'flat' : 'drop');

      if (GameState.tutorialStep === 1 || GameState.tutorialStep === 2) {
        GameState.tutorialStep = 3;
      }

      const sx = GameState.playerVisual.x;
      const sy = GameState.playerVisual.y;

      performSwingThenLaunch(
        GameState.playerVisual,
        serveType === 'high' ? 'clear_retreat' : 'deep_lunge',
        serveType === 'high' ? 'clear' : (serveType === 'net' ? 'net' : 'drive'),
        false,
        () => {
          SoundEngine.playHit('normal');
          if (serveType === 'high') {
            addAiPosture(12);
            GameState.aiPos = 'back';
            startEaseOutMove(GameState.aiVisual, 0.5, 0.14, 0.36);
            startEaseOutMove(GameState.playerVisual, 0.5, 0.85, 0.34);
            spawnFloatingText(0.5, 0.25, '🚀高远压底线! 敌破绽+12', '#f59e0b');
            launchShuttle(sx, sy, 0.5, 0.14, { trajType: 'high', speed: 0.024, drag: 0.42 });
          } else if (serveType === 'flat') {
            addAiPosture(10);
            GameState.aiPos = 'mid';
            startEaseOutMove(GameState.aiVisual, 0.32, 0.24, 0.30);
            startEaseOutMove(GameState.playerVisual, 0.5, 0.83, 0.30);
            spawnFloatingText(0.32, 0.24, '⚡平快偷袭! 敌破绽+10', '#38bdf8');
            launchShuttle(sx, sy, 0.32, 0.24, { trajType: 'flat', speed: 0.050, drag: 0.14 });
          } else {
            addAiPosture(10);
            if (hasBoon('dionysus')) {
              GameState.aiPoisonTimer = 3000;
              spawnFloatingText(0.5, 0.32, '🍷网前绞肉机! 3秒持续涨破绽', '#c084fc');
            }
            GameState.aiPos = 'front';
            startEaseOutMove(GameState.aiVisual, 0.5, 0.36, 0.30);
            startEaseOutMove(GameState.playerVisual, 0.5, 0.82, 0.32);
            launchShuttle(sx, sy, 0.5, 0.36, { trajType: 'drop', speed: 0.035, drag: 0.50 });
          }
          updateAllUI();
        },
        'playerSwing'
      );

      scheduleAction(480, () => {
        if (!checkAiPostureBreak()) triggerAiIncomingShot();
      }, 'triggerAiNext');
    }

    // ==================== 10. AI WEIGHTED CARD-DRAW ENGINE & EXPEDITION 33 / FEATHERBLADE DEFLECT ====================
    function weightedRandomDraw(deck) {
      const totalWeight = deck.reduce((sum, card) => sum + Math.max(1, card.weight), 0);
      let r = Math.random() * totalWeight;
      for (const card of deck) {
        const w = Math.max(1, card.weight);
        if (r < w) return card;
        r -= w;
      }
      return deck[0];
    }

    function triggerAiIncomingShot() {
      if (GameState.paused || GameState.phase === 'break_finisher' || GameState.aiStunTimer > 0) return;
      SoundEngine.startBgm();
      const st = getCurrentStage();
      GameState.rallyCount++;
      GameState.aiLastActionTime = performance.now();

      if (st.name === '安塞虫' && GameState.rallyCount % 3 === 0) {
        GameState.aiPosture = Math.max(0, GameState.aiPosture - 5);
      }
      if (st.name === '牢李' && GameState.rallyCount % 5 === 0) {
        GameState.aiStamina = Math.min(GameState.aiStaminaMax, GameState.aiStamina + 10);
        GameState.aiPosture = Math.max(0, GameState.aiPosture - 4);
      }
      if (st.immunity === '动态轮换' && GameState.rallyCount % 3 === 0) {
        const pool = ['高远球', '吊球', '搓球', '平高球', '重杀'];
        GameState.aiDynamicImmunity = pool[Math.floor(Math.random() * pool.length)];
      }

      const lastTraj = GameState.lastPlayerTraj || 'high';
      let deck = [];
      if (lastTraj === 'high' || lastTraj === 'flat') {
        deck = [
          { name: '高远球',   zone: 'back',  trajType: 'high',  isSmash: false, weight: 45, speed: 0.023, reachRadius: 0.28, threatPx: 42 },
          { name: '吊球',     zone: 'front', trajType: 'drop',  isSmash: false, weight: 35, speed: 0.035, reachRadius: 0.23, threatPx: 32 },
          { name: '平高球',   zone: 'back',  trajType: 'flat',  isSmash: false, weight: 15, speed: 0.044, reachRadius: 0.24, threatPx: 35 },
          { name: '强行杀球', zone: 'mid',   trajType: 'smash', isSmash: true,  weight: 12, speed: 0.064, reachRadius: 0.19, threatPx: 26 }
        ];
      } else if (lastTraj === 'drop') {
        deck = [
          { name: '挑后场',   zone: 'back',  trajType: 'high', isSmash: false, weight: 65, speed: 0.023, reachRadius: 0.28, threatPx: 42 },
          { name: '回放网前', zone: 'front', trajType: 'drop', isSmash: false, weight: 35, speed: 0.034, reachRadius: 0.23, threatPx: 32 }
        ];
      } else {
        deck = [
          { name: '挡网',   zone: 'front', trajType: 'drop', isSmash: false, weight: 70, speed: 0.034, reachRadius: 0.24, threatPx: 34 },
          { name: '挑底线', zone: 'back',  trajType: 'high', isSmash: false, weight: 30, speed: 0.023, reachRadius: 0.28, threatPx: 42 }
        ];
      }

      const py = GameState.playerVisual.y;
      deck.forEach(card => {
        if (py > 0.81 && card.zone === 'front') card.weight += 35;
        if (py < 0.66 && card.zone === 'back') card.weight += 35;
        if ((st.trait.includes('重炮') || st.role.includes('Boss')) && card.isSmash) card.weight += 22;
        if (GameState.sameShotStreak >= 2 && (card.isSmash || card.zone === 'front')) {
          card.weight = Math.round(card.weight * 2.2);
        }
      });

      // 【AI 阅读玩家习惯：连续2拍打向同一侧，AI 提前移动 0.1 坐标并提高抓推拦截权重】
      const pDirs = GameState.recentPlayerDirs;
      const repeatedSide = (pDirs.length >= 2 && pDirs[pDirs.length - 1] === pDirs[pDirs.length - 2] && pDirs[pDirs.length - 1] !== 'M')
        ? pDirs[pDirs.length - 1]
        : null;
      if (repeatedSide) {
        const shiftX = repeatedSide === 'R' ? 0.10 : -0.10;
        GameState.aiVisual.x = Math.max(0.14, Math.min(0.86, GameState.aiVisual.x + shiftX));
        GameState.aiVisual.targetX = GameState.aiVisual.x;
        deck.push({
          name: '抓推拦截',
          zone: 'mid',
          trajType: 'smash',
          isSmash: true,
          weight: 55,
          speed: 0.066,
          reachRadius: 0.21,
          threatPx: 28
        });
      }

      // Soft Ball check: Forced by player tactical suppression (压反手/前后拉扯) OR high AI flaw (>60) / low AI stamina (<38%)
      const aiHighPosture = GameState.aiPosture >= 60;
      const aiStamRatio = GameState.aiStamina / GameState.aiStaminaMax;
      const forcedSoft = GameState.forceNextAiSoft;
      GameState.forceNextAiSoft = false;
      const softBallProb = (GameState.tutorialStep === 3 || forcedSoft) ? 1.0 : ((aiHighPosture || aiStamRatio < 0.38) ? 0.48 : 0.20);

      let chosen;
      if (GameState.tutorialStep === 3) {
        chosen = { name: '教学慢速高球', zone: 'mid', trajType: 'high', isSmash: false, isSoftBall: true, speed: 0.023, reachRadius: 0.34, threatPx: 44 };
      } else if (Math.random() < softBallProb) {
        chosen = Math.random() < 0.55
          ? { name: '半场软高球', zone: 'mid',   trajType: 'high', isSmash: false, isSoftBall: true, speed: 0.024, reachRadius: 0.28, threatPx: 42 }
          : { name: '网前软挡球', zone: 'front', trajType: 'drop', isSmash: false, isSoftBall: true, speed: 0.033, reachRadius: 0.25, threatPx: 36 };
      } else if (aiStamRatio >= 0.50 && Math.random() < 0.20) {
        // 【AI 假动作机制：20% 概率做出起跳重杀动作，实际打出网前吊球，此时豁免玩家Z轴高度限制】
        chosen = {
          name: '假杀真吊(AI假动作)',
          zone: 'front',
          trajType: 'drop',
          isSmash: false,
          isAiFeint: true,
          bypassZGate: true,
          isSoftBall: false,
          speed: 0.036,
          reachRadius: 0.25,
          threatPx: 35
        };
      } else {
        const card = weightedRandomDraw(deck);
        chosen = { ...card, isSoftBall: false };
      }

      // Apply Athena's Shield (+30% judgment circle radius)
      const athenaScale = (hasBoon('athena') || hasBoon('ironwall')) ? 1.30 : 1.0;
      chosen.reachRadius = chosen.reachRadius * athenaScale;
      chosen.threatPx = Math.round(chosen.threatPx * athenaScale);

      GameState.aiDrawCard = {
        text: chosen.isSoftBall ? `💫 ${chosen.name}` : `🎴 ${chosen.name}`,
        type: chosen.trajType,
        isSmash: chosen.isSmash,
        isSoft: chosen.isSoftBall,
        life: 1.0
      };

      GameState.aiStamina = Math.max(10, GameState.aiStamina - (chosen.isSmash ? 6 : 3));

      let targetX, targetY;
      if (GameState.tutorialStep === 3) {
        targetX = GameState.playerVisual.x;
        targetY = GameState.playerVisual.y;
      } else {
        const openCourtX = GameState.playerVisual.x < 0.5 ? 0.76 : 0.24;
        const fuzzX = (Math.random() * 2 - 1) * 0.15;
        const baseX = chosen.isSoftBall
          ? 0.50 + (Math.random() - 0.5) * 0.16
          : (GameState.sameShotStreak >= 2 ? openCourtX : (0.50 + fuzzX * 1.6));
        targetX = Math.max(0.16, Math.min(0.84, baseX));
        targetY = chosen.isSoftBall
          ? 0.66
          : (chosen.zone === 'front' ? 0.61 : (chosen.zone === 'back' ? 0.86 : 0.74));
      }

      const now = performance.now();
      const baseDur = GameState.slowMoActive ? 1580 : (GameState.difficulty === 'novice' ? 1280 : 980);

      GameState.incomingShot = {
        ...chosen,
        targetX,
        targetY,
        startTime: now + 110,
        overlapTime: now + 110 + baseDur,
        expireTime: now + 110 + baseDur + (GameState.difficulty === 'novice' ? 1350 : 950)
      };

      GameState.phase = 'ai_incoming';
      GameState.recommendedDirs = computeRecommendedFootworkDirs(targetX, targetY);

      // 【第一段感官慢动作镜头】：对手出球瞬间自动切入感官慢动作 (Time Scale = 0.22)，唤醒中央八点步伐罗盘！
      // 若上一拍因 '+' 与 '-' 未经过 '0' 导致重心失衡，玩家反应比平时慢 0.5 秒 (500ms 延迟解锁)！
      const penaltyMs = GameState.cogImbalanced ? 500 : 0;
      GameState.sensoryLockUntilMs = now + 110 + penaltyMs;
      GameState.timeScale = 0.24;
      GameState.timeScaleTimer = baseDur + 950;
      if (penaltyMs > 0) {
        GameState.incomingShot.expireTime -= 320; // 反应慢0.5秒导致有效窗口更紧迫
      }

      syncCenterFootworkCompass();
      renderActionDeck();
      updateAllUI();

      performSwingThenLaunch(
        GameState.aiVisual,
        (chosen.isSmash || chosen.isAiFeint) ? 'jump_smash' : (chosen.trajType === 'drop' ? 'deep_lunge' : 'clear_retreat'),
        (chosen.isSmash || chosen.isAiFeint) ? 'smash' : (chosen.trajType === 'drop' ? 'lunge' : 'clear'),
        (chosen.isSmash || chosen.isAiFeint),
        () => {
          SoundEngine.playHit(chosen.isSmash ? 'smash' : 'normal');
          launchShuttle(GameState.aiVisual.x, GameState.aiVisual.y, targetX, targetY, {
            trajType: chosen.trajType,
            speed: chosen.speed
          });
        },
        'aiSwing'
      );
    }

    // China Jump (中国跳) & Malay Step (马来步) Assault
    function executeAssaultStrike(assaultName) {
      if (GameState.paused || GameState.swingLock || GameState.phase !== 'ai_incoming' || !GameState.incomingShot) return;
      const inc = GameState.incomingShot;
      const adr = getAdrenalineInfo(GameState.combo);

      const cost = hasBoon('hermes') ? 7.5 : 15;
      GameState.pStamina = Math.max(0, GameState.pStamina - cost);
      GameState.playerLastActionTime = performance.now();
      if (GameState.tutorialStep === 3) GameState.tutorialStep = 4;

      GameState.playerVisual.x = inc.targetX;
      GameState.playerVisual.y = inc.targetY;
      startEaseOutMove(GameState.playerVisual, 0.50, 0.82, 0.36);
      GameState.pCog = Math.min(100, GameState.pCog + 14);

      const aresMult = hasBoon('ares') ? 2.0 : 1.0;
      const doublePostureDmg = Math.round(42 * aresMult * (1 + GameState.permBonus.postureDmgPct) * (1 + 0.25 * (adr.mult - 1)));
      addAiPosture(doublePostureDmg);
      GameState.playerPosture = Math.max(0, GameState.playerPosture - 10);
      syncPostureAlias();

      GameState.combo += 2;
      GameState.maxCombo = Math.max(GameState.maxCombo, GameState.combo);
      GameState.counterWindowActive = true;
      GameState.xp += 25;

      const tx = GameState.aiVisual.x < 0.5 ? 0.76 : 0.24;
      const ty = 0.20;
      startEaseOutMove(GameState.aiVisual, tx, 0.22, 0.34);

      GameState.phase = 'shuttle_to_ai';
      GameState.incomingShot = null;
      updatePlayerGridFromCoords();
      updateAllUI();
      renderActionDeck();

      performSwingThenLaunch(
        GameState.playerVisual,
        'jump_smash',
        'smash',
        true,
        () => {
          GameState.bassDropTimer = 520;
          GameState.bloomAlpha = 1.0;
          SoundEngine.playBassDrop();
          SoundEngine.triggerShake('extreme', 'rgba(251, 191, 36, 0.48)');
          launchShuttle(inc.targetX, inc.targetY, tx, ty, { trajType: 'smash', speed: 0.074, trailColor: '#f43f5e' });
          spawnParticles(inc.targetX, inc.targetY, '#fbbf24', 36);
          spawnFloatingText(inc.targetX, inc.targetY - 0.06, `⚡PERFECT ${assaultName}! 敌破绽+${doublePostureDmg}`, '#fde047');
          showCanvasBanner(`${assaultName} · 飞跃重扣!`, `敌方破绽暴涨 +${doublePostureDmg}！`, '#f43f5e');
          if (!checkAiPostureBreak()) {
            scheduleAction(480, () => { triggerAiIncomingShot(); }, 'triggerAiNext');
          }
        },
        'playerSwing'
      );
    }

    // Expedition 33 High-Pressure QTE & Featherblade 3-Tier Deflect (完美弹反 / Good 格挡 / Miss 破防)
    function handleDefenseInput(defOption) {
      if (GameState.paused || GameState.swingLock || GameState.phase !== 'ai_incoming' || !GameState.incomingShot) return;
      // 若点击底部快捷接球按钮，自动联动触发第一阶段最佳步伐切入第二阶段感官慢动作球路选择！
      if (GameState.recommendedDirs && GameState.recommendedDirs.length > 0) {
        handleSensoryFootworkSelect(GameState.recommendedDirs[0]);
        return;
      }
      const inc = GameState.incomingShot;

      // 【防无脑连点机制】：如果玩家处于乱按挥空冷却硬直中，拒绝输入！
      if (GameState.defCooldownTimer > 0) {
        SoundEngine.playHit('miss');
        spawnFloatingText(
          GameState.playerVisual.x,
          GameState.playerVisual.y - 0.06,
          `🚫 连点挥空硬直中 (${(GameState.defCooldownTimer / 1000).toFixed(2)}s)!`,
          '#f43f5e'
        );
        return;
      }

      // 【维度二·任务1：击球点高度限制 (Z轴修复) + 乱按防连点惩罚】
      if (!inc.bypassZGate && GameState.shuttle.inFlight && GameState.shuttle.z >= 0.30) {
        SoundEngine.playHit('miss');
        GameState.defCooldownTimer = 420; // 惩罚锁定防守键 0.42 秒，防止玩家无脑狂点刷时机！
        GameState.pStamina = Math.max(5, GameState.pStamina - 6);
        addPlayerPosture(10);
        GameState.playerVisual.swingType = 'drive';
        GameState.playerVisual.swingAnim = 0.75;
        const zVal = GameState.shuttle.z.toFixed(2);
        spawnFloatingText(
          GameState.playerVisual.x,
          GameState.playerVisual.y - 0.06,
          `🚫 过早挥拍扑空! (Z=${zVal} · 硬直0.4s · 破绽+10)`,
          '#f43f5e'
        );
        showCanvasBanner('🚫 过早连点挥空惩罚 (硬直 0.42s)!', `球还在高空 (Z=${zVal})，盲目连点导致挥空硬直且破绽+10！请看准缩圈重合瞬间按一次！`, '#f43f5e');
        syncDefenseReachButtons();
        updateAllUI();
        return;
      }

      const now = performance.now();
      GameState.playerLastActionTime = now;

      // 若玩家处于 0.2s 挥空后摇或 0.4s 重杀深蹲后摇中，防守受阻
      if (GameState.playerRecoveryTimer > 0 && GameState.recoveryType === 'early_whiff') {
        SoundEngine.playHit('miss');
        spawnFloatingText(GameState.playerVisual.x, GameState.playerVisual.y - 0.05, '⚠️ 抢跑后摇硬直中(0.2s)!', '#4ade80');
        return;
      }

      // 【正反手方向限制：右侧球需 vx > 0 正手接，左侧球需 vx < 0 反手接】
      const ballDeltaX = inc.targetX - GameState.playerVisual.x;
      const isRightSide = Math.abs(ballDeltaX) < 0.025 ? (inc.targetX >= 0.5) : (ballDeltaX >= 0);
      const requiredHand = isRightSide ? 'forehand' : 'backhand';

      let liveVx = GameState.joyVx;
      if (GameState.keysDown['KeyA'] || GameState.keysDown['ArrowLeft']) liveVx = -1;
      if (GameState.keysDown['KeyD'] || GameState.keysDown['ArrowRight']) liveVx = 1;
      // Allow recent directional stick hold within 420ms so touch players tapping the right-side button right after moving aren't unfairly penalized, while wrong direction or no movement is punished
      if (liveVx === 0 && (now - GameState.lastActiveJoyTime) <= 420) {
        liveVx = GameState.lastActiveJoyVx;
      }

      const dirMatched = isRightSide ? (liveVx > 0) : (liveVx < 0);
      const dirWrong = isRightSide ? (liveVx < 0) : (liveVx > 0);
      const inReach = isPlayerInLandingCircle();

      GameState.pHand = requiredHand;
      const isBackhandReceive = (requiredHand === 'backhand');
      // 反手接球：判定窗口缩小 20%
      const backhandWindowScale = isBackhandReceive ? 0.80 : 1.0;

      // 【帧数博弈 (Frame Data)：signedMs < 0 为早按 Early，signedMs > 0 为晚按 Late】
      const signedMs = now - inc.overlapTime;
      const absMs = Math.abs(signedMs);
      const hero = getCurrentHero();
      const senseBonus = 1 + (GameState.attrs.sense - 40) * 0.005;
      const athenaBonus = (hasBoon('athena') || hasBoon('ironwall')) ? 1.30 : 1.0;
      const diffScale = GameState.difficulty === 'novice' ? 1.35 : (GameState.difficulty === 'hardcore' ? 1.0 : 1.15);
      const slowScale = GameState.slowMoActive ? 1.5 : 1.0;
      const totalWinMod = diffScale * slowScale * hero.windowBonus * senseBonus * athenaBonus * backhandWindowScale * (1 + GameState.permBonus.windowPct);

      // 1. 完美帧 (Perfect Window): ±100ms
      const perfectBound = 100 * totalWinMod;
      // 2. 抢跑帧 (Early Window: -250ms ~ -100ms) & 3. 迟缓帧 (Late Window: +100ms ~ +250ms)
      const outerBound = 250 * totalWinMod;

      let frameGrade = 'Miss';
      if (GameState.tutorialStep === 3) {
        frameGrade = 'Perfect';
        GameState.tutorialStep = 4;
      } else if (dirWrong || (!dirMatched && GameState.difficulty !== 'novice') || !inReach) {
        frameGrade = 'Miss';
      } else if (absMs <= perfectBound) {
        frameGrade = 'Perfect';
      } else if (signedMs >= -outerBound && signedMs < -perfectBound) {
        frameGrade = 'Early';
      } else if (signedMs > perfectBound && signedMs <= outerBound) {
        frameGrade = 'Late';
      } else {
        frameGrade = 'Miss';
      }

      // 4. 彻底 Miss（超出 ±250ms 范围、未进圈或正反手方向按错/未按摇杆）
      if (frameGrade === 'Miss') {
        GameState.perfectParryStreak = 0;
        addPlayerPosture(38);
        SoundEngine.playHit('miss');
        SoundEngine.triggerShake('finisher_break', 'rgba(244, 63, 94, 0.52)');
        GameState.playerVisual.poseType = 'deep_lunge';
        GameState.playerVisual.swingAnim = 1.0;
        GameState.pCog = Math.max(15, GameState.pCog - 28);
        spawnParticles(inc.targetX, inc.targetY, '#f43f5e', 26);

        const missReason = dirWrong
          ? `正反手方向按反(需${isRightSide ? '👉右推正手' : '👈左推反手'})`
          : (!dirMatched && GameState.difficulty !== 'novice' ? `未推摇杆方向(需${isRightSide ? '👉右推正手' : '👈左推反手'})` : (!inReach ? '未跑进落点判定圈' : `时机偏差过大(${Math.round(signedMs)}ms)`));

        if (GameState.playerPosture >= 100) {
          GameState.playerStunTimer = 2000;
          spawnFloatingText(GameState.playerVisual.x, GameState.playerVisual.y - 0.06, '💔 【重心崩溃】! (硬直2秒)', '#f43f5e');
          showCanvasBanner('💔 我方破绽满100【重心崩溃】!', `${missReason}导致自身破绽满溢，丢掉1分！`, '#f43f5e');
        } else {
          spawnFloatingText(GameState.playerVisual.x, GameState.playerVisual.y - 0.06, `💔 MISS 挥空! (${missReason}) 破绽+38`, '#f43f5e');
          showCanvasBanner('💔 【Miss 挥空破防】接球失败!', `${missReason} · 自身破绽飙升 +38 并直接丢分！`, '#f43f5e');
        }
        updateAllUI();
        scorePoint('ai', `Miss挥空(${missReason})`);
        return;
      }

      const stamCost = hasBoon('hermes') ? defOption.cost * 0.5 : defOption.cost;
      GameState.pStamina = Math.max(5, GameState.pStamina - stamCost);
      GameState.slowMoActive = false;

      startEaseOutMove(GameState.playerVisual, inc.targetX, defOption.nextY, 0.28);

      const adr = getAdrenalineInfo(GameState.combo);
      const returnTraj = defOption.key === '挑球' ? 'high' : (defOption.key === '挡网' ? 'drop' : 'flat');
      const handTag = isBackhandReceive ? '🤚反手接球' : '🖐️正手接球';

      if (frameGrade === 'Perfect') {
        // 1. 完美帧（±100ms）：触发【完美弹反】，免疫伤害，敌方破绽+25（叠加加成），开启 0.3s 时空凝滞 (Time Scale = 0.2)！
        const parryBacklash = Math.round(25 * (isBackhandReceive ? 1.25 : 1.0) * (1 + GameState.permBonus.postureDmgPct) * (1 + 0.25 * (adr.mult - 1)));
        addAiPosture(parryBacklash);
        GameState.playerPosture = Math.max(0, GameState.playerPosture - 16);
        syncPostureAlias();

        if (isBackhandReceive) {
          GameState.aiStamina = Math.max(5, GameState.aiStamina - 14);
        }

        GameState.matchStats.perfectParryCount++;
        GameState.pCog = Math.min(100, GameState.pCog + 18);
        GameState.combo += 2;
        GameState.maxCombo = Math.max(GameState.maxCombo, GameState.combo);
        GameState.pFocus = Math.min(100, GameState.pFocus + 14);
        GameState.counterWindowActive = true;
        GameState.xp += 24;

        // 完美弹反的时空凝滞：Time Scale = 0.2 持续 0.3 秒 (300ms)
        GameState.timeScale = 0.2;
        GameState.timeScaleTimer = 300;
        GameState.hitStop = 80;
        GameState.camZoom = 1.35;
        GameState.camFocus = { x: inc.targetX, y: inc.targetY };
        GameState.camZoomOutElapsedMs = 0;
        GameState.camState.zoom = 1.35;
        GameState.camState.focusX = inc.targetX;
        GameState.camState.focusY = inc.targetY;
        GameState.bloomAlpha = 1.0;
        triggerGoldFlashOnDefenseBtns();
        spawnImpactRing(inc.targetX, inc.targetY, 'perfect');

        GameState.perfectParryStreak++;
        if (hasBoon('zeus') && GameState.perfectParryStreak >= 3) {
          GameState.zeusCharged = true;
          GameState.perfectParryStreak = 0;
          spawnFloatingText(inc.targetX, inc.targetY - 0.11, '⚡【雷霆突击】已就绪! 下次杀球必破重心!', '#fde047');
        }

        spawnFloatingText(inc.targetX, inc.targetY - 0.05, `⚔️ PERFECT ${handTag}! 敌破绽+${parryBacklash}`, '#fde047');
        showCanvasBanner(`⚔️ 【${handTag} · 完美弹反】时空凝滞 0.3s!`, `误差 ${Math.round(absMs)}ms (≤100ms) · 免疫伤害 · 敌方破绽 +${parryBacklash}!`, '#fbbf24');
      } else if (frameGrade === 'Early') {
        // 2. 抢跑帧（Early Window: -250ms 到 -100ms）：过早挥拍动作变形，自身破绽+10，陷入 0.2s 挥空后摇，弹出绿色 "EARLY 抢跑"
        GameState.perfectParryStreak = 0;
        addPlayerPosture(10);
        addAiPosture(6);
        GameState.playerRecoveryTimer = 200; // 0.2秒挥空后摇
        GameState.recoveryType = 'early_whiff';
        GameState.forceNextAiSoft = false;
        spawnFloatingText(GameState.playerVisual.x, GameState.playerVisual.y - 0.07, `🟢 EARLY 抢跑! (${Math.round(signedMs)}ms · 破绽+10 · 后摇0.2s)`, '#4ade80');
        showCanvasBanner('🟢 【EARLY 抢跑帧】过早挥拍动作变形!', `早按 ${Math.abs(Math.round(signedMs))}ms · 回球质量差 · 自身破绽+10 且陷入 0.2s 挥空后摇！`, '#4ade80');
      } else if (frameGrade === 'Late') {
        // 3. 迟缓帧（Late Window: +100ms 到 +250ms）：勉强救球，重心丢失(pCog骤降20)，下一拍移动速度减半，弹出红色 "LATE 迟缓"
        GameState.perfectParryStreak = 0;
        addPlayerPosture(8);
        addAiPosture(8);
        GameState.pCog = Math.max(15, GameState.pCog - 20);
        GameState.lateSlowTimer = 1800; // 下一拍移动速度减半
        spawnFloatingText(GameState.playerVisual.x, GameState.playerVisual.y - 0.07, `🔴 LATE 迟缓! (+${Math.round(signedMs)}ms · 重心-20 · 移速减半)`, '#f87171');
        showCanvasBanner('🔴 【LATE 迟缓帧】勉强救球重心丢失!', `晚按 +${Math.round(signedMs)}ms · 重心骤降 20 · 下一拍移动速度减半！`, '#f87171');
      }

      // Transition to Counter-Attack Phase
      GameState.phase = 'player_offense';
      GameState.incomingShot = null;
      updatePlayerGridFromCoords();
      if (getAiOpenCourtInfo()) {
        GameState.matchStats.openCourtOpportunities++;
      }
      updateAllUI();
      renderActionDeck();

      performSwingThenLaunch(
        GameState.playerVisual,
        defOption.key === '挡网' ? 'deep_lunge' : (defOption.key === '挑球' ? 'lift_sit' : 'clear_retreat'),
        defOption.key === '挡网' ? 'net' : (defOption.key === '挑球' ? 'lift' : 'drive'),
        false,
        () => {
          if (frameGrade === 'Perfect') {
            if (isBackhandReceive) SoundEngine.playBackhandParry();
            else SoundEngine.playHit('parry');
            SoundEngine.triggerShake('perfect_parry', 'rgba(255, 255, 255, 0.65)');
            spawnParticles(inc.targetX, inc.targetY, '#fbbf24', 36);
          } else {
            SoundEngine.playHit('normal');
            SoundEngine.triggerShake('normal_hit', null);
            spawnImpactRing(inc.targetX, inc.targetY, 'normal');
            spawnParticles(inc.targetX, inc.targetY, frameGrade === 'Early' ? '#4ade80' : '#f87171', 14);
          }
          launchShuttle(GameState.playerVisual.x, GameState.playerVisual.y, 0.5, returnTraj === 'drop' ? 0.35 : 0.20, {
            trajType: returnTraj
          });
          checkAiPostureBreak();
        },
        'playerSwing'
      );
    }

    // ==================== 11. COUNTER-ATTACK & OFFENSE EXECUTION (FEATHERBLADE POSTURE + BOONS) ====================
    function executePlayerOffenseShot(shot, holdChargePct = 0, swipeDeltaY = 0) {
      if (GameState.paused || GameState.swingLock || GameState.phase !== 'player_offense') return;

      const actualCost = hasBoon('hermes') ? shot.cost * 0.5 : shot.cost;
      if (GameState.pStamina < actualCost && shot.cost >= 3) {
        SoundEngine.playHit('miss');
        spawnFloatingText(GameState.playerVisual.x, GameState.playerVisual.y - 0.06, `⚡体力不足 (${Math.round(GameState.pStamina)}/${actualCost})! 请打过渡/挑球或稳心回体`, '#f43f5e');
        showCanvasBanner('⚡ 体力透支，无法强行重杀!', '请使用低耗体【高远球/挑球/正反手过渡】调整呼吸！', '#f43f5e');
        return;
      }

      // 立即切换至 'shuttle_to_ai' 状态，结束第二段感官慢动作，恢复正常时间流速，并结算重心符号 (+ / - / 0)！
      GameState.phase = 'shuttle_to_ai';
      GameState.timeScale = 1.0;
      GameState.timeScaleTimer = 0;
      const cogInfo = getShotCogInfo(shot.name);
      applyCogSymbolTransition(cogInfo.sym, shot.name);
      syncCenterFootworkCompass();
      renderActionDeck();

      const st = getCurrentStage();
      const hero = getCurrentHero();
      const adr = getAdrenalineInfo(GameState.combo);
      GameState.playerLastActionTime = performance.now();

      const stamRatio = GameState.pStamina / GameState.pStaminaMax;
      const stamQualityMult = stamRatio < 0.20 ? 0.72 : (stamRatio < 0.40 ? 0.86 : 1.0);
      GameState.pStamina = Math.max(0, GameState.pStamina - actualCost);
      GameState.rallyCount++;

      if (GameState.lastPlayerShot === shot.name) {
        GameState.sameShotStreak++;
      } else {
        GameState.sameShotStreak = 1;
      }
      GameState.lastPlayerShot = shot.name;
      GameState.lastPlayerTraj = shot.trajType;

      // 【维度三·任务3：假动作机制 (假杀真吊)】
      // 在按下杀球/高远球瞬间反向拨动摇杆(向后拉 joyVy > 0.35 或 S/Down键)，动作看似起跳重杀，实际打出网前急坠小球骗AI僵直！
      const isPullingBack = GameState.joyVy > 0.35 || GameState.keysDown['KeyS'] || GameState.keysDown['ArrowDown'];
      const isFeintShot = (shot.trajType === 'smash' || shot.trajType === 'high') && (isPullingBack || swipeDeltaY > 55);

      let nextPose = 'ready';
      const isJumpSmash = (shot.trajType === 'smash' && shot.pos.includes('back')) || isFeintShot;

      // 【维度一·任务2：挥拍后摇硬直 (Recovery 动作帧博弈)】
      if (shot.trajType === 'smash' && !isFeintShot) {
        nextPose = 'jump_smash';
        spawnPlayerSmashAfterimages();
        startEaseOutMove(GameState.playerVisual, 0.50, 0.81, 0.38);
        GameState.pCog = Math.max(22, GameState.pCog - 8);
        // 1. 当玩家打出【重杀】并落地后，陷入 0.4 秒 (400ms) 的“深蹲后摇”状态（此时无法移动）
        GameState.playerRecoveryTimer = 400;
        GameState.recoveryType = 'smash_crouch';
      } else if (isFeintShot) {
        nextPose = 'jump_smash';
        spawnPlayerSmashAfterimages();
        startEaseOutMove(GameState.playerVisual, 0.50, 0.76, 0.32);
        GameState.playerRecoveryTimer = 180;
        GameState.recoveryType = 'feint';
      } else if (shot.trajType === 'high') {
        nextPose = 'clear_retreat';
        startEaseOutMove(GameState.playerVisual, 0.50, 0.88, 0.36);
        GameState.pCog = Math.min(100, GameState.pCog + 15);
        GameState.playerRecoveryTimer = 140;
        GameState.recoveryType = 'clear';
      } else if (shot.trajType === 'drop') {
        nextPose = 'deep_lunge';
        // 2. 当玩家打出【滑板】或【劈吊】时，身体向前冲产生 0.2 秒 (200ms) 的“向前惯性”，无法立刻后退
        const isSliceForward = (shot.name === '滑板' || shot.name === '劈吊');
        const forwardInertiaY = isSliceForward ? Math.max(0.56, GameState.playerVisual.y - 0.10) : ((shot.name === '搓球' || shot.name === '放网') ? 0.58 : 0.62);
        startEaseOutMove(GameState.playerVisual, GameState.playerVisual.x, forwardInertiaY, 0.30);
        GameState.playerVisual.vy = -0.75;
        GameState.pCog = Math.max(25, GameState.pCog - 4);
        GameState.playerRecoveryTimer = 200;
        GameState.forwardInertiaTimer = isSliceForward ? 200 : 120;
        GameState.recoveryType = isSliceForward ? 'slice_inertia' : 'net_inertia';
      } else {
        // 平抽挡：动作极小，0秒无后摇
        nextPose = 'deep_lunge';
        startEaseOutMove(GameState.playerVisual, 0.50, 0.74, 0.26);
        GameState.playerRecoveryTimer = 0;
        GameState.recoveryType = 'flat_zero';
      }

      // Tutorial Step 4 Forced 【重心崩溃】 -> Finisher Demo
      if (GameState.tutorialStep === 4) {
        GameState.tutorialStep = 0;
        GameState.tutorialActive = false;
        performSwingThenLaunch(GameState.playerVisual, 'jump_smash', 'smash', true, () => {
          SoundEngine.playHit('break');
          SoundEngine.triggerShake('extreme', 'rgba(245, 158, 11, 0.45)');
          launchShuttle(GameState.playerVisual.x, GameState.playerVisual.y, 0.28, 0.16, { trajType: 'smash', speed: 0.070 });
          spawnParticles(0.28, 0.16, '#fbbf24', 32);
          addAiPosture(100);
          checkAiPostureBreak();
        }, 'playerSwing');
        return;
      }

      // Self-Rescue Transition Shot (回复35重心 并降低自身20破绽)
      if (shot.isTransition) {
        GameState.pHand = shot.setHand;
        GameState.pCog = Math.min(100, GameState.pCog + 35);
        GameState.playerPosture = Math.max(0, GameState.playerPosture - 20);
        syncPostureAlias();
        performSwingThenLaunch(GameState.playerVisual, 'ready', 'clear', false, () => {
          SoundEngine.playHit('normal');
          addAiPosture(10);
          spawnFloatingText(GameState.playerVisual.x, GameState.playerVisual.y - 0.05, `${shot.name} · 重心+35 自身破绽-20!`, '#4ade80');
          launchShuttle(GameState.playerVisual.x, GameState.playerVisual.y, 0.5, 0.24, { trajType: 'flat' });
          updateAllUI();
        }, 'playerSwing');
        scheduleAction(480, () => {
          if (!checkAiPostureBreak()) triggerAiIncomingShot();
        }, 'triggerAiNext');
        return;
      }

      // Branching Tactical Combo Tree Evaluation
      GameState.recentShots.push(shot.name);
      if (GameState.recentShots.length > 3) GameState.recentShots.shift();

      let tacticalComboMult = 1.0;
      let tacticalComboTitle = '';
      if (GameState.recentShots.length === 3) {
        const [s1, s2, s3] = GameState.recentShots;
        if (s1 === s2 && s2 === s3) {
          GameState.combo = 0;
          tacticalComboMult = 0.75;
          GameState.tacticalComboText = `⚠️ 连续3拍【${s3}】被 AI 读心识破！连击中断`;
        } else if ((s1 === '高远球' || s1 === '平高球') && (s2 === '吊球' || s2 === '劈吊') && (s3 === '重杀' || s3 === '点杀' || s3 === '劈杀')) {
          tacticalComboMult = hero.id === 'suyu' ? 2.25 : 2.0;
          tacticalComboTitle = '🔥【拉吊突击】三拍绝杀! 破绽伤害×2.0!';
          GameState.tacticalComboText = '🔥 达成【拉吊突击】：高远→吊球→杀球 (破绽伤害×2.0)!';
        } else if (s1 === '放网' && (s2 === '搓球' || s2 === '勾对角') && (s3 === '扑球' || s3 === '推球' || s3 === '平抽')) {
          tacticalComboMult = hero.id === 'bailu' ? 2.25 : 2.0;
          tacticalComboTitle = '🌀【网前绞肉机】三拍绝杀! 破绽伤害×2.0!';
          GameState.tacticalComboText = '🌀 达成【网前绞肉机】：放网→搓勾→扑推 (破绽伤害×2.0)!';
        } else if ((s1 === '高远球' || s1 === '平高球' || s1 === '挑球') && (s2 === '放网' || s2 === '搓球' || s2 === '吊球') && (s3 === '扑球' || s3 === '推球' || s3 === '平抽')) {
          tacticalComboMult = 1.75;
          tacticalComboTitle = '⚡【攻防转换】分支连击! 破绽伤害×1.75!';
          GameState.tacticalComboText = `⚡ 达成【攻防转换】：${s1}→${s2}→${s3} (破绽×1.75)!`;
        } else if ((s1 === '放网' || s1 === '吊球') && (s2 === '挑球' || s2 === '高远球') && (s3 === '重杀' || s3 === '点杀' || s3 === '劈杀')) {
          tacticalComboMult = 1.80;
          tacticalComboTitle = '🗡️【前后拉扯突击】分支连击! 破绽伤害×1.8!';
          GameState.tacticalComboText = `🗡️ 达成【前后拉扯】：${s1}→${s2}→${s3} (破绽×1.8)!`;
        } else if (new Set(GameState.recentShots).size === 3) {
          tacticalComboMult = 1.35;
          tacticalComboTitle = '⚡【立体调动】三拍连贯 (+35%破绽伤害)!';
          GameState.tacticalComboText = `⚡ 立体调动：${s1} → ${s2} → ${s3}`;
        }
      } else {
        GameState.tacticalComboText = `🔗 球路链：${GameState.recentShots.join(' → ')}`;
      }

      // Swipe Arc Micro-Control
      let arcLabel = '';
      let swipeMult = 1.0;
      let speedMod = 1.0;

      if (swipeDeltaY < -40) {
        arcLabel = '↗️拉高深弧';
        swipeMult = 1.15;
        if (swipeDeltaY < -95 && Math.random() < (stamRatio < 0.3 ? 0.25 : 0.16)) {
          performSwingThenLaunch(GameState.playerVisual, nextPose, 'clear', false, () => {
            SoundEngine.playHit('miss');
            launchShuttle(GameState.playerVisual.x, GameState.playerVisual.y, 0.5, 0.02, { trajType: 'high' });
            showCanvasBanner('❌ 上滑过猛 · 底线出界 OUT!', '弧线拉得过高飞出底线', '#f43f5e');
            scorePoint('ai', '上滑过猛底线出界');
          }, 'playerSwing');
          return;
        }
      } else if (swipeDeltaY > 40) {
        arcLabel = '↘️压平急坠';
        speedMod = 1.22;
        swipeMult = 1.18;
        if (swipeDeltaY > 95 && Math.random() < (stamRatio < 0.3 ? 0.25 : 0.16)) {
          performSwingThenLaunch(GameState.playerVisual, nextPose, 'smash', isJumpSmash, () => {
            SoundEngine.playHit('miss');
            launchShuttle(GameState.playerVisual.x, GameState.playerVisual.y, 0.5, 0.50, { trajType: 'smash' });
            showCanvasBanner('❌ 下滑过猛 · 挂网失分 NET!', '弧线压得过平挂网', '#f43f5e');
            scorePoint('ai', '下滑过猛下网');
          }, 'playerSwing');
          return;
        }
      }

      let tx = GameState.aiVisual.x < 0.5 ? 0.74 : 0.26;
      if (shot.diagonal) {
        const aimRight = GameState.playerVisual.x < 0.5;
        const controlSafety = Math.max(0, (GameState.attrs.control - 40) * 0.0015);
        const cogJitter = GameState.pCog < 45 ? 0.06 : 0.022;
        const randomSpread = (Math.random() - 0.32) * (0.09 + cogJitter - controlSafety);
        tx = aimRight ? (0.91 + randomSpread) : (0.09 - randomSpread);
      }

      let ty = shot.trajType === 'drop' ? 0.36 : (shot.trajType === 'high' ? 0.14 : 0.22);
      if (swipeDeltaY < -40) ty = Math.max(0.12, ty - 0.05);
      if (swipeDeltaY > 40) ty = Math.min(0.38, ty + 0.05);

      if (tx > 0.96 || tx < 0.04) {
        performSwingThenLaunch(GameState.playerVisual, nextPose, shot.trajType === 'smash' ? 'smash' : 'lunge', isJumpSmash, () => {
          SoundEngine.playHit('miss');
          SoundEngine.triggerShake('heavy', 'rgba(244, 63, 94, 0.32)');
          launchShuttle(GameState.playerVisual.x, GameState.playerVisual.y, tx, ty, { trajType: shot.trajType, speed: shot.speed });
          spawnFloatingText(Math.max(0.05, Math.min(0.95, tx)), ty, `❌ 边线出界 OUT! (x=${tx.toFixed(2)})`, '#f43f5e');
          showCanvasBanner(`❌ 【${shot.name}】单打边线出界 OUT!`, `落点 x=${tx.toFixed(2)} 超出边线 (提升🎯控球属性可稳定压线)`, '#f43f5e');
          scorePoint('ai', `${shot.name}边线出界`);
        }, 'playerSwing');
        return;
      }

      const sx = GameState.playerVisual.x;
      const sy = GameState.playerVisual.y;

      if (isFeintShot) {
        ty = 0.37; // 假杀真吊落向网前
      }

      // 【维度二·任务2：侧旋与切削轨迹（S/C 型香蕉球）】
      // 打出【滑板】或【劈吊】，或击球时摇杆强烈左右拨动，赋予羽毛球强烈侧旋
      let spinType = null;
      let spinDir = 0;
      if (shot.name === '滑板' || shot.name === '劈吊' || Math.abs(GameState.joyVx) >= 0.45) {
        spinType = (shot.name === '滑板' || Math.abs(GameState.joyVx) > 0.75) ? 'S' : 'C';
        spinDir = GameState.joyVx !== 0 ? Math.sign(GameState.joyVx) : (tx > 0.5 ? 1 : -1);
        // 落点因侧旋横向偏移
        tx = Math.max(0.10, Math.min(0.90, tx + spinDir * 0.08));
      }

      // 【策略任务一 ~ 任务三：抓空当判定、球路克制矩阵、重复落点钉死 vs AI 读心抓推】
      const openCourtInfo = getAiOpenCourtInfo();
      const hitOpenCourt = openCourtInfo && (openCourtInfo.shots.includes(shot.name) || (isFeintShot && openCourtInfo.type === 'front'));
      let strategyBonusMult = 1.0;
      const strategyTags = [];

      const shotDirCode = tx < 0.42 ? 'L' : (tx > 0.58 ? 'R' : 'M');
      GameState.recentPlayerDirs.push(shotDirCode);
      if (GameState.recentPlayerDirs.length > 3) GameState.recentPlayerDirs.shift();

      if (hitOpenCourt) {
        GameState.matchStats.openCourtHits++;
        const hunterMult = hasBoon('hunter') ? (1.50 * countBoon('hunter')) : 1.25;
        strategyBonusMult *= hunterMult;
        strategyTags.push(hasBoon('hunter') ? '🎯压迫猎手·抓空当+50%' : '🎯抓空当+25%');
      }

      // 1. 压反手战术：AI 在反手侧(左侧 x < 0.46)接球，玩家打【平高球】或【推球】
      if (GameState.aiVisual.x < 0.46 && (shot.name === '平高球' || shot.name === '推球')) {
        strategyBonusMult *= 1.35;
        GameState.forceNextAiSoft = true;
        strategyTags.push('🗡️压反手克制(AI回浅高球)');
      }

      // 2. 前后拉扯战术：上一拍高远/挑球，这一拍放网/吊球（或反之），AI 跨场狂奔体力消耗翻倍且回球不到位
      const prevShot = GameState.recentShots.length >= 2 ? GameState.recentShots[GameState.recentShots.length - 2] : '';
      const isFrontBackWhip =
        ((prevShot === '高远球' || prevShot === '挑球') && (shot.trajType === 'drop' || isFeintShot)) ||
        ((prevShot === '放网' || prevShot === '搓球' || prevShot === '吊球') && shot.trajType === 'high');
      if (isFrontBackWhip) {
        GameState.aiStamina = Math.max(5, GameState.aiStamina - 14);
        GameState.forceNextAiSoft = true;
        strategyBonusMult *= 1.30;
        strategyTags.push('🏃前后拉扯(AI体力双倍流失)');
      }

      // 3. 重复落点战术 vs AI 读心抓推反击
      const currentSpotZone = `${tx < 0.5 ? 'L' : 'R'}_${ty > 0.30 ? 'F' : (ty < 0.20 ? 'B' : 'M')}`;
      GameState.recentTargetZones.push(currentSpotZone);
      if (GameState.recentTargetZones.length > 3) GameState.recentTargetZones.shift();
      const recZ = GameState.recentTargetZones;
      const twoSameSpot = recZ.length >= 2 && recZ[recZ.length - 1] === recZ[recZ.length - 2];
      const threeSameSpot = recZ.length === 3 && recZ[0] === recZ[1] && recZ[1] === recZ[2];

      let aiInterceptTriggered = false;
      if (GameState.aiAnticipatedZone) {
        if (currentSpotZone === GameState.aiAnticipatedZone && !isFeintShot && !spinType) {
          // 连续第3次打向AI预判方向 -> AI 发动【抓推拦截】直接起跳扑杀！
          aiInterceptTriggered = true;
        } else {
          // 玩家阅读了AI提前站位并果断变线（或用假动作/旋转球）-> AI 扑空失衡！
          GameState.aiStunTimer = 850;
          GameState.aiStaggerTimer = 1000;
          strategyBonusMult *= 1.65;
          strategyTags.push('⚡反抓AI预判扑空!');
        }
        GameState.aiAnticipatedZone = null;
      } else if (twoSameSpot && !threeSameSpot) {
        // 连续两次打同一落点：AI 被“钉死”在原地硬直 0.5 秒！同时 AI 开始预判下一拍该落点
        GameState.aiStunTimer = 500;
        strategyBonusMult *= 1.30;
        strategyTags.push('📌重复落点钉死(AI硬直0.5s)');
        GameState.aiAnticipatedZone = currentSpotZone;
      }

      // 4. 假杀真吊 或 【网前魔术师】30%概率欺骗 AI 提前起跳扑空
      const magicianProc = hasBoon('magician') && (shot.name === '放网' || shot.name === '搓球' || shot.name === '滑板') && Math.random() < 0.30;
      if (isFeintShot || magicianProc) {
        GameState.aiStunTimer = 800;
        GameState.aiStaggerTimer = 950;
        strategyBonusMult *= 1.45;
        strategyTags.push(isFeintShot ? '🎭假杀真吊(骗AI僵直0.8s)' : '🎩网前魔术师(AI扑空失衡)');
      }

      startEaseOutMove(GameState.aiVisual, tx, ty, (GameState.aiStunTimer > 0) ? 0.62 : 0.34);
      GameState.aiPos = ty > 0.30 ? 'front' : (ty < 0.20 ? 'back' : 'mid');

      // Check Zeus Lightning Charged Smash (Ignores defense & immunity!)
      const isZeusThunderSmash = GameState.zeusCharged && shot.trajType === 'smash';
      if (isZeusThunderSmash) {
        GameState.zeusCharged = false;
        GameState.counterWindowActive = false;
        performSwingThenLaunch(GameState.playerVisual, 'jump_smash', 'smash', true, () => {
          GameState.bassDropTimer = 600;
          triggerZeusLightning(tx, ty);
          SoundEngine.playBassDrop();
          SoundEngine.triggerShake('extreme', 'rgba(253, 224, 71, 0.72)');
          launchShuttle(sx, sy, tx, ty, { trajType: 'smash', speed: 0.082, trailColor: '#fde047' });
          spawnParticles(tx, ty, '#fde047', 42);
          spawnFloatingText(tx, ty - 0.06, '⚡【雷霆突击】雷霆破防! 无视防守!', '#fde047');
          showCanvasBanner('⚡【雷霆突击】雷霆一击 · 无视防守直接崩溃!', '连续3次完美弹反引动天雷，敌方破绽瞬间满溢进入【制胜扣杀】！', '#fde047');
          addAiPosture(100);
          updateAllUI();
          checkAiPostureBreak();
        }, 'playerSwing');
        return;
      }

      const activeImm = st.immunity === '动态轮换' ? GameState.aiDynamicImmunity : st.immunity;
      const isImmune = (activeImm === shot.name);

      const isPerfectOffense = GameState.counterWindowActive || tacticalComboMult >= 1.75 || Math.abs(swipeDeltaY) >= 35 || holdChargePct >= 0.25 || GameState.pCog >= 72;
      const offenseJudgeMult = isPerfectOffense ? 1.18 : 1.0;
      const offenseJudgeTag = isPerfectOffense ? 'PERFECT!' : 'GOOD!';

      const powerAttrMult = 1 + (GameState.attrs.power - 45) * 0.006;
      const chargeMult = 1 + holdChargePct * 0.35;
      const counterMult = GameState.counterWindowActive ? 1.30 : 1.0;
      const aresMult = (shot.trajType === 'smash' && hasBoon('ares')) ? Math.pow(2.0, countBoon('ares')) : 1.0;
      GameState.counterWindowActive = false;

      const postureDmg = Math.round(shot.postureDmg * powerAttrMult * chargeMult * swipeMult * offenseJudgeMult * tacticalComboMult * counterMult * aresMult * strategyBonusMult * (1 + GameState.permBonus.postureDmgPct) * (1 + 0.3 * (adr.mult - 1)));

      const detailedSwingType = shot.name === '挑球'
        ? 'lift'
        : ((shot.name === '搓球' || shot.name === '放网' || shot.name === '勾对角')
            ? 'net'
            : (shot.trajType === 'drop' ? 'drop' : (shot.trajType === 'smash' ? 'smash' : (shot.trajType === 'high' ? 'clear' : 'drive'))));
      performSwingThenLaunch(
        GameState.playerVisual,
        nextPose,
        detailedSwingType,
        isJumpSmash,
        () => {
          const isBassDropCombo = tacticalComboMult >= 1.75 || (shot.trajType === 'smash' && hasBoon('ares'));
          if (isBassDropCombo) {
            GameState.bassDropTimer = 520;
            SoundEngine.playBassDrop();
          }
          const ironwallSpeedMult = hasBoon('ironwall') ? 1.20 : 1.0;
          launchShuttle(sx, sy, tx, ty, {
            trajType: isFeintShot ? 'drop' : shot.trajType,
            speed: shot.speed * speedMod * ironwallSpeedMult * (1 + holdChargePct * 0.18),
            gravity: shot.gravity,
            drag: shot.drag,
            spinType,
            spinDir,
            trailColor: spinType ? '#38bdf8' : (shot.trajType === 'smash' ? '#f43f5e' : (isBassDropCombo ? '#fbbf24' : undefined))
          });
          spawnImpactRing(sx, sy, isPerfectOffense ? 'perfect' : 'normal');
          if (isPerfectOffense) GameState.hitStop = 80;

          if (isImmune) {
            SoundEngine.playHit('miss');
            addAiPosture(2);
            spawnFloatingText(tx, ty, `🛡️ Boss免疫【${shot.name}】! 破绽+2`, '#fb7185');
            updateAllUI();
            return;
          }

          addAiPosture(postureDmg);

          // Dionysus Poison Boon: Net/Drop shots inflict 3s of automatic posture surge (+9/sec)
          if (hasBoon('dionysus') && (shot.trajType === 'drop' || shot.pos.includes('front'))) {
            GameState.aiPoisonTimer = 3000;
            spawnFloatingText(tx, ty - 0.09, '🍷【网前绞肉机】3秒持续涨破绽!', '#c084fc');
          }

          GameState.combo += 1;
          GameState.maxCombo = Math.max(GameState.maxCombo, GameState.combo);
          GameState.xp += 12;

          SoundEngine.playHit(tacticalComboMult >= 1.75 || isPerfectOffense ? 'parry' : (shot.trajType === 'smash' ? 'smash' : 'normal'));
          SoundEngine.triggerShake(shot.trajType === 'smash' ? 'heavy_smash' : (shot.trajType === 'drop' ? 'light_tap' : 'normal_hit'), null);
          spawnParticles(tx, ty, shot.trajType === 'smash' ? '#f43f5e' : '#fbbf24', tacticalComboMult >= 1.75 ? 36 : 22);
          spawnFloatingText(tx, ty - 0.04, `${offenseJudgeTag} ${shot.name}${arcLabel} · 敌破绽+${postureDmg}`, isPerfectOffense ? '#fde047' : '#38bdf8');

          if (tacticalComboTitle) {
            // 【策略任务四：战术流派动态反馈】拉吊突击等组合达成时，破绽条金色残影显示“战术压制！”，AI 陷入 1 秒踉跄动作
            GameState.tacticalSuppressTimer = 1200;
            GameState.aiStaggerTimer = 1000;
            showCanvasBanner(`⚡ 战术压制！${tacticalComboTitle}`, `AI 陷入 1.0 秒踉跄失衡 · 造成 +${postureDmg} 点破绽压迫！`, '#fbbf24');
          } else if (strategyTags.length > 0) {
            showCanvasBanner(strategyTags.join(' · '), `${spinType ? `🌀${spinType}型侧旋弧线 · ` : ''}造成 +${postureDmg} 点破绽伤害！`, '#fde047');
          }
          if (aiInterceptTriggered) {
            showCanvasBanner('⚠️ 连续3拍同落点被 AI 预判【抓推拦截】!', 'AI 提前移动到位直接起跳扑杀反击！', '#f43f5e');
          }

          updateAllUI();
          checkAiPostureBreak();
        },
        'playerSwing'
      );

      scheduleAction(540, () => {
        if ((GameState.phase === 'shuttle_to_ai' || GameState.phase === 'player_offense') && !checkAiPostureBreak()) {
          triggerAiIncomingShot();
          if (GameState.aiAnticipatedZone) {
            const antX = GameState.aiAnticipatedZone.startsWith('L') ? 0.24 : 0.76;
            startEaseOutMove(GameState.aiVisual, antX, GameState.aiVisual.y, 0.25);
          }
        }
      }, 'triggerAiNext');
    }

    // Featherblade 【重心崩溃】 Check (aiPosture >= 100 -> 2s Staggered Stun + Finisher Ready!)
    function checkAiPostureBreak() {
      if (GameState.aiPosture < 100) return false;
      clearActionTimers('triggerAiNext');

      if (GameState.aiReviveAvailable) {
        GameState.aiReviveAvailable = false;
        GameState.aiPosture = 45;
        syncPostureAlias();
        SoundEngine.playHit('break');
        SoundEngine.triggerShake('extreme', 'rgba(244, 63, 94, 0.45)');
        showCanvasBanner('🥚 最终Boss【蛋壳狂怒逆转】!', '破绽回落至 45 进入狂暴二阶段！', '#f43f5e');
        updateAllUI();
        scheduleAction(600, () => { triggerAiIncomingShot(); }, 'triggerAiNext');
        return true;
      }

      GameState.phase = 'break_finisher';
      GameState.aiStunTimer = 2000; // 2 seconds staggered stun
      GameState.finisherAvailable = true;
      GameState.bloomAlpha = 0.85;
      SoundEngine.playBassDrop();
      SoundEngine.triggerShake('extreme', 'rgba(244, 63, 94, 0.55)');
      spawnParticles(GameState.aiVisual.x, GameState.aiVisual.y, '#f43f5e', 38);
      showCanvasBanner('🩸 【重心崩溃】 【重心崩溃】 (硬直 2.0s)!', '直接点击屏幕任意位置或下方制胜扣杀按钮，发动血腥暴力扣杀【制胜扣杀】直接得 1 分！', '#f43f5e');
      updateAllUI();
      renderActionDeck();
      return true;
    }

    // Featherblade Finisher Execution (Click Screen or Finisher Button -> Violent Crimson/Gold Smash & +1 Point)
    function executeBreakFinisher(finisher = { name: '🩸 制胜扣杀·赛场血断杀' }) {
      if (GameState.paused || GameState.swingLock || GameState.phase !== 'break_finisher') return;
      GameState.finisherAvailable = false;
      GameState.combo += 2;
      GameState.maxCombo = Math.max(GameState.maxCombo, GameState.combo);
      GameState.pFocus = Math.min(100, GameState.pFocus + 18);
      GameState.xp += 35;

      const tx = GameState.aiVisual.x;
      const ty = GameState.aiVisual.y;

      performSwingThenLaunch(GameState.playerVisual, 'jump_smash', 'smash', true, () => {
        GameState.bassDropTimer = 650;
        GameState.bloomAlpha = 1.0;
        SoundEngine.playBassDrop();
        SoundEngine.triggerShake('finisher_break', 'rgba(220, 38, 38, 0.72)');
        launchShuttle(GameState.playerVisual.x, GameState.playerVisual.y, tx, ty, {
          trajType: 'smash',
          speed: 0.088,
          trailColor: '#dc2626'
        });
        spawnFeatherShatter(tx, ty);
        spawnParticles(tx, ty, '#dc2626', 36);
        spawnFloatingText(tx, ty - 0.08, `🩸 制胜扣杀 FINISHER! +1分`, '#ef4444');
        showCanvasBanner(`🩸 【制胜扣杀】${finisher.name}!`, '血色雷霆轰穿对手防线 · 直接斩获 1 分！', '#f43f5e');
        scorePoint('player', `制胜扣杀【${finisher.name}】得分`);
      }, 'playerSwing');
    }

    function scorePoint(winner, reasonText) {
      SoundEngine.playRefereeWhistle();
      clearActionTimers();
      GameState.timeScale = 1.0;
      GameState.timeScaleTimer = 0;
      GameState.swingLock = false;
      GameState.phase = 'serve';
      GameState.incomingShot = null;
      GameState.shuttle.inFlight = false;
      GameState.shuttle.ghosts = [];
      GameState.counterWindowActive = false;
      GameState.recentShots = [];
      GameState.sameShotStreak = 0;
      GameState.tacticalComboText = '';
      GameState.combo = 0;
      GameState.aiStunTimer = 0;
      GameState.playerStunTimer = 0;
      GameState.aiPoisonTimer = 0;
      GameState.finisherAvailable = false;

      const now = performance.now();
      GameState.pStamina = GameState.pStaminaMax;
      GameState.aiStamina = GameState.aiStaminaMax;
      GameState.playerPosture = 0;
      GameState.aiPosture = 0;
      GameState.playerLastActionTime = now;
      GameState.aiLastActionTime = now;
      syncPostureAlias();

      GameState.pCog = 85;
      GameState.cogSymbol = '0';
      GameState.cogHistory = ['0'];
      GameState.cogImbalanced = false;
      GameState.lastRacketActionText = '准备架拍';
      GameState.selectedFootworkDir = 'down';
      GameState.sensoryLockUntilMs = 0;
      startEaseOutMove(GameState.playerVisual, 0.5, 0.85, 0.30);

      if (winner === 'player') {
        GameState.playerScore++;
        GameState.servingSide = 'player';
        GameState.xp += 30;
      } else {
        GameState.aiScore++;
        GameState.servingSide = 'ai';
        GameState.xp += 8;
      }

      saveGameData();
      updateAllUI();
      renderActionDeck();

      if (GameState.playerScore >= GameState.targetScore) {
        openMatchEndModal(true);
        return;
      }
      if (GameState.aiScore >= GameState.targetScore) {
        openMatchEndModal(false);
        return;
      }

      // 【维度四：战术流派赋形】每得 3 分弹出“战术复盘”派系构筑三选一（永久生效）
      if (winner === 'player' && GameState.playerScore > 0 && (GameState.playerScore % 3 === 0 || GameState.playerScore === 2) && GameState.lastBoonPointTrigger !== GameState.playerScore) {
        GameState.lastBoonPointTrigger = GameState.playerScore;
        openFeatherbladeBoonModal(`📋 战术复盘 · 派系构筑 (比分 ${GameState.playerScore}:${GameState.aiScore})`, '请从以下三项【战术抉择】派系徽章中选择一项永久融入你的球风：');
      }
    }

    // ==================== 12. FEATHERBLADE BOON MODAL & GAME MODALS ====================
    function getThreeRandomBoons() {
      // Prioritize the 3 core Faction Badges (压迫猎手, 铜墙铁壁, 网前魔术师) when player hasn't picked one yet
      const coreFactions = TACTICAL_CARDS.slice(0, 3);
      if (GameState.boons.length === 0) {
        return coreFactions;
      }
      const pool = [...TACTICAL_CARDS];
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      return pool.slice(0, 3);
    }

    function openFeatherbladeBoonModal(titleText = '🏛️ 战术流派卡牌 · 三选一', subText = '请选择一张战术流派天赋卡加入你的 Build（实时生效）：', onAfterPick = null) {
      GameState.paused = true;
      const modal = document.getElementById('modalOverlay');
      document.getElementById('overlayIcon').textContent = '🏛️';
      document.getElementById('overlayTitle').textContent = titleText;
      document.getElementById('overlayDesc').textContent = subText;

      const choicesBox = document.getElementById('overlayChoices');
      choicesBox.innerHTML = '';

      const threeBoons = getThreeRandomBoons();
      threeBoons.forEach(boon => {
        const ownedCount = countBoon(boon.id);
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'w-full p-3 rounded-xl hades-panel hover:brightness-125 text-left transition flex flex-col gap-1';
        btn.style.borderColor = boon.color;
        btn.innerHTML = `
          <div class="flex items-center justify-between">
            <span class="font-black text-sm text-amber-200">${boon.icon} ${boon.name}</span>
            <span class="text-[10px] px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-400/40 font-black">${boon.god}${ownedCount > 0 ? ' · 已拥有×' + ownedCount : ''}</span>
          </div>
          <div class="text-xs text-slate-200">${boon.desc}</div>
        `;
        btn.addEventListener('click', () => {
          GameState.boons.push(boon.id);
          SoundEngine.playHit('parry');
          saveGameData();
          updateAllUI();
          renderActionDeck();
          if (onAfterPick) {
            onAfterPick(boon);
          } else {
            modal.classList.add('hidden');
