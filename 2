<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>羽刃 (Feather Blade) - 横屏极简 3D 羽毛球</title>
  <style>
    :root {
      --bg-dark: #070b14;
      --accent-cyan: #00f0ff;
      --accent-gold: #ffb800;
      --accent-crimson: #ff2a5f;
      --text-light: #f1f5f9;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      background-color: var(--bg-dark);
      font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      touch-action: none;
    }

    #game-container {
      position: relative;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle at 50% 35%, #132238 0%, #070b14 80%);
    }

    canvas#gameCanvas {
      display: block;
      width: 100%;
      height: 100%;
      cursor: pointer;
    }

    /* 竖屏遮罩提示（强制横屏逻辑） */
    #orientation-overlay {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: rgba(7, 11, 20, 0.96);
      backdrop-filter: blur(12px);
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--text-light);
      text-align: center;
      padding: 24px;
    }

    #orientation-overlay.active {
      display: flex;
    }

    .phone-icon {
      width: 68px;
      height: 112px;
      border: 3px solid var(--accent-cyan);
      border-radius: 14px;
      position: relative;
      margin-bottom: 24px;
      box-shadow: 0 0 24px rgba(0, 240, 255, 0.35);
      animation: rotatePhone 2.2s ease-in-out infinite;
    }

    .phone-icon::after {
      content: "";
      position: absolute;
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: 22px;
      height: 4px;
      border-radius: 2px;
      background: var(--accent-cyan);
    }

    @keyframes rotatePhone {
      0%, 15% { transform: rotate(0deg); }
      55%, 85% { transform: rotate(-90deg); }
      100% { transform: rotate(0deg); }
    }

    .overlay-title {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 2px;
      margin-bottom: 10px;
      color: #ffffff;
    }

    .overlay-sub {
      font-size: 14px;
      color: #94a3b8;
      max-width: 280px;
      line-height: 1.6;
      margin-bottom: 22px;
    }

    .bypass-btn {
      padding: 10px 20px;
      border-radius: 999px;
      border: 1px solid rgba(0, 240, 255, 0.45);
      background: rgba(0, 240, 255, 0.12);
      color: var(--accent-cyan);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 1px;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .bypass-btn:hover {
      background: rgba(0, 240, 255, 0.25);
      transform: translateY(-1px);
    }
  </style>
</head>
<body>
  <div id="game-container">
    <canvas id="gameCanvas"></canvas>
  </div>

  <!-- 竖屏提示遮罩 -->
  <div id="orientation-overlay" role="dialog" aria-modal="true" aria-label="横屏提示">
    <div class="phone-icon"></div>
    <div class="overlay-title">请横置手机</div>
    <p class="overlay-sub">《羽刃》采用横屏 15° 俯视 3D 视效与战术操控设计，横置设备可获得最佳击球视野。</p>
    <button id="dismiss-orientation-btn" class="bypass-btn" type="button">在当前窗口强制继续</button>
  </div>

  <script>
    /**
     * ============================================================================
     * 《羽刃》(FEATHER BLADE) - 四大 Agent 完整合体终极版
     * ============================================================================
     * - Agent 1 (Architect & Integrator): 全局状态 GameState、横屏自适应、pointerdown 路由、主循环
     * - Agent 2 (Visual & Physics): 15° 俯视横向球场 projectCourt(nx,ny,z)、真实网格球网(x=0.5)、
     *   虚线预测弧线+落点圆圈、紫→蓝→青→绿→黄→红→白长渐隐流光拖尾、杀球美漫速度线与“💥!!!”涂鸦、火柴人骨骼+❗
     * - Agent 3 (Interaction & QTE): 步伐点选后 Ease-out 自动跑位、区域球路面板(1居中/2并排/3-4田字格)、
     *   快慢刀接杀 QTE (随机速度 0.015~0.035 + 上/中/下方向与绿区双重判定)、A+B+C 失误率系统
     * - Agent 4 (System & Level Design): 渐进式无感教学 TUTORIAL_LEVELS (绝不渲染未解锁灰色按钮)、
     *   赢下指定拍数(3-6拍)自动过关点亮新招式、AI 教学喂球与老手模式 30% 杀球触发接杀 QTE
     * ============================================================================
     */

    // ============================================================================
    // [MODULE 0] Web Audio 合成音效引擎
    // ============================================================================
    const AudioEngine = {
      ctx: null,
      muted: false,
      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      },
      playHit(type = 'normal') {
        if (this.muted || !this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        if (type === 'smash') {
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(360, now);
          osc.frequency.exponentialRampToValueAtTime(42, now + 0.22);
          gain.gain.setValueAtTime(0.42, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + 0.23);
        } else {
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(240, now);
          osc.frequency.exponentialRampToValueAtTime(65, now + 0.13);
          gain.gain.setValueAtTime(0.26, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.13);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + 0.14);
        }
      },
      playStep() {
        if (this.muted || !this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(150, now);
        osc.frequency.exponentialRampToValueAtTime(290, now + 0.08);
        gain.gain.setValueAtTime(0.14, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.09);
      },
      playAlert() {
        if (this.muted || !this.ctx) return;
        const now = this.ctx.currentTime;
        [587.33, 880].forEach((freq, i) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'square';
          osc.frequency.setValueAtTime(freq, now + i * 0.07);
          gain.gain.setValueAtTime(0.16, now + i * 0.07);
          gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.07 + 0.09);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now + i * 0.07);
          osc.stop(now + i * 0.07 + 0.1);
        });
      },
      playLevelUp() {
        if (this.muted || !this.ctx) return;
        const now = this.ctx.currentTime;
        [440, 554.37, 659.25, 880].forEach((freq, idx) => {
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + idx * 0.08);
          gain.gain.setValueAtTime(0.2, now + idx * 0.08);
          gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.22);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now + idx * 0.08);
          osc.stop(now + idx * 0.08 + 0.23);
        });
      },
      playClick() {
        if (this.muted || !this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(540, now);
        gain.gain.setValueAtTime(0.12, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.045);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.05);
      }
    };

    // ============================================================================
    // [AGENT 4 + AGENT 1] 全局常量、步伐与球路配置、TUTORIAL_LEVELS 与 GameState
    // ============================================================================
    const LOGICAL_W = 1280;
    const LOGICAL_H = 720;

    /**
     * 球场归一化 3D 坐标约定 (横向展开球场):
     * nx: 0.0 (左端玩家底线) -> 0.5 (球网) -> 1.0 (右端 AI 底线)
     * ny: 0.0 (远端上边线/小透视) -> 0.5 (中线) -> 1.0 (近端下边线/大透视)
     * z : 0.0 (地面) -> 0.155 (球网高度) -> 0.55 (高远球最高点)
     */
    const STEP_DIRS = {
      '↓': { id: '↓', label: '↓ 后退底线', nx: 0.12, ny: 0.50, region: 'back',   desc: '后场正中' },
      '↑': { id: '↑', label: '↑ 上网前场', nx: 0.39, ny: 0.50, region: 'front',  desc: '网前正中' },
      '↙': { id: '↙', label: '↙ 左后底角', nx: 0.13, ny: 0.82, region: 'corner', desc: '后场边角' },
      '↘': { id: '↘', label: '↘ 右前网角', nx: 0.39, ny: 0.82, region: 'corner', desc: '前场边角' },
      '←': { id: '←', label: '← 中场远侧', nx: 0.25, ny: 0.20, region: 'mid',    desc: '中场左翼' },
      '→': { id: '→', label: '→ 中场近侧', nx: 0.25, ny: 0.80, region: 'mid',    desc: '中场右翼' }
    };

    const SHOT_TYPES = {
      '高远球': { id: '高远球', duration: 1.38, peakZ: 0.50, targetNX: 0.88, color: '#38bdf8', tag: '慢速深压后场' },
      '放网':   { id: '放网',   duration: 0.88, peakZ: 0.20, targetNX: 0.61, color: '#10b981', tag: '贴网轻放前场' },
      '吊球':   { id: '吊球',   duration: 0.98, peakZ: 0.27, targetNX: 0.64, color: '#a855f7', tag: '斜线轻吊网角' },
      '平抽':   { id: '平抽',   duration: 0.66, peakZ: 0.18, targetNX: 0.76, color: '#f59e0b', tag: '高速平压中场' },
      '推球':   { id: '推球',   duration: 0.74, peakZ: 0.22, targetNX: 0.84, color: '#00f0ff', tag: '快速推压底角' },
      '重杀':   { id: '重杀',   duration: 0.46, peakZ: 0.28, targetNX: 0.72, color: '#ff2a5f', tag: '雷霆极速扣杀', isSmash: true }
    };

    // Agent 4: 渐进式教学关卡配置数组 TUTORIAL_LEVELS
    const TUTORIAL_LEVELS = [
      {
        level: 1,
        title: '第 1 关 · 初识高远',
        subtitle: '仅解锁【↓】与【高远球】，AI 只打后场',
        dirs: ['↓'],
        shots: ['高远球'],
        targetRallies: 3, // 赢下或完成 3 拍即过关
        aiPattern: 'back_only',
        aiDirs: ['↓']
      },
      {
        level: 2,
        title: '第 2 关 · 前后调动',
        subtitle: '新解锁【↑】与【放网】，AI 前后交替喂球',
        dirs: ['↓', '↑'],
        shots: ['高远球', '放网'],
        targetRallies: 4,
        aiPattern: 'front_back_alt',
        aiDirs: ['↓', '↑']
      },
      {
        level: 3,
        title: '第 3 关 · 四方掠影',
        subtitle: '新解锁【↙ / ↘】与【吊球】，AI 打四方球',
        dirs: ['↓', '↑', '↙', '↘'],
        shots: ['高远球', '放网', '吊球'],
        targetRallies: 4,
        aiPattern: 'four_corners',
        aiDirs: ['↓', '↑', '↙', '↘']
      },
      {
        level: 4,
        title: '第 4 关 · 中场平抽',
        subtitle: '新解锁【← / →】与【平抽 / 推球】，AI 主攻中场',
        dirs: ['↓', '↑', '↙', '↘', '←', '→'],
        shots: ['高远球', '放网', '吊球', '平抽', '推球'],
        targetRallies: 5,
        aiPattern: 'mid_focus',
        aiDirs: ['←', '→', '↙', '↘']
      },
      {
        level: 5,
        title: '第 5 关 · 羽刃完全体',
        subtitle: '新解锁【重杀】与快慢刀接杀 QTE，十成战力对决',
        dirs: ['↓', '↑', '↙', '↘', '←', '→'],
        shots: ['高远球', '放网', '吊球', '平抽', '推球', '重杀'],
        targetRallies: 6,
        aiPattern: 'full_combat',
        aiDirs: ['↓', '↑', '↙', '↘', '←', '→']
      }
    ];

    // Agent 1: 全局 GameState
    const GameState = {
      // 核心阶段: 'menu' | 'serve' | 'step' | 'shot' | 'flying' | 'defend' | 'end'
      phase: 'menu',
      mode: 'tutorial', // 'tutorial' (新手教学) | 'veteran' (老手直接开打)
      level: 1,

      // 当前解锁的步伐与球路（未解锁的绝不渲染）
      dirs: ['↓'],
      shots: ['高远球'],

      // 比分与教学拍数进度
      score: {
        player: 0,
        ai: 0,
        winTarget: 5
      },
      rallyCount: 0,      // 当前关卡已成功对拉/赢下的拍数
      targetRallies: 3,   // 当前教学关过关所需拍数
      aiAltIndex: 0,      // AI 前后交替计数器

      // 玩家状态 (含 Ease-out 跑位与体力/重心状态)
      player: {
        nx: 0.24,
        ny: 0.50,
        startNX: 0.24,
        startNY: 0.50,
        targetNX: 0.24,
        targetNY: 0.50,
        moveProgress: 1.0,
        moveDuration: 0.36,
        stamina: 100,       // 体力 (影响失误率 B)
        balanceError: 0.0,  // 重心/跑位偏差 (影响失误率 B)
        selectedDir: '↓',
        swingAnim: 0,
        alertExclamation: false // 接杀时头顶显示红叹号 ❗
      },

      // AI 状态
      ai: {
        nx: 0.76,
        ny: 0.50,
        targetNX: 0.76,
        targetNY: 0.50,
        swingAnim: 0,
        name: '机关陪练·壹'
      },

      // 羽毛球 3D 物理与彩色流光轨迹
      shuttle: {
        nx: 0.28,
        ny: 0.50,
        z: 0.12,
        startNX: 0.28,
        startNY: 0.50,
        startZ: 0.12,
        targetNX: 0.85,
        targetNY: 0.50,
        targetDir: '↓',
        peakZ: 0.45,
        flightElapsed: 0,
        flightDuration: 1.2,
        owner: 'player',   // 'player' | 'ai'
        shotType: '高远球',
        isSmash: false,
        trail: [],         // [{ nx, ny, z, age, maxAge }]
        smashGraffiti: []  // 杀球美漫速度线与 "💥!!!" 飘字
      },

      // Agent 3: 快慢刀接杀 QTE 状态
      qte: {
        active: false,
        progress: 0.1,      // 光标位置 0.0 ~ 1.0
        dir: 1,             // 1 向右, -1 向左
        speed: 0.022,       // 每次来回随机 0.015 ~ 0.035
        greenMin: 0.36,     // 中间绿色完美区起点
        greenMax: 0.64,     // 中间绿色完美区终点
        requiredTrack: '中', // '上' | '中' | '下' (对应来球路线)
        timeLeft: 2.3,
        maxTime: 2.3
      },

      // Agent 3: 正常击球时机与 A+B+C 失误率监控
      shotWindow: {
        timer: 0,
        optimalTime: 0.42, // 跑位完成后最佳击球节拍点
        lastMissBreakdown: 'A(基础3.5%) + B(状态0.0%) + C(偏差0.0%) = 3.5%',
        lastJudgeResult: '' // 'Perfect' | '正常' | 'Miss'
      },

      // 飘字提示与过关横幅
      banner: {
        text: '',
        subText: '',
        color: '#00f0ff',
        timer: 0
      },
      statusText: '准备发球',

      // 视口信息
      viewport: {
        width: 1280,
        height: 720,
        scale: 1,
        offsetX: 0,
        offsetY: 0,
        isPortrait: false,
        bypassPortraitLock: false
      }
    };

    // ============================================================================
    // [AGENT 2] 视觉与物理渲染工程师模块 (Visual & Physics Renderer)
    // ============================================================================
    const VisualRenderer = {
      /**
       * 1. 3D 坐标系透视函数 projectCourt(nx, ny, z)
       * 模拟 15° 俯视，球场横向展开：
       * - nx (0~1): 球场长度 (左0.0 -> 球网0.5 -> 右1.0)
       * - ny (0~1): 球场宽度 (远端0.0 -> 近端1.0)，产生近大远小透视缩放
       * - z (>=0) : 垂直高度 (0为地面)
       */
      projectCourt(nx, ny, z = 0, W = LOGICAL_W, H = LOGICAL_H) {
        // 15° 俯视近大远小深度系数 (ny=0 远端 0.74, ny=1 近端 1.08)
        const perspectiveScale = 0.74 + ny * 0.34;

        // 地面 Y 坐标随 ny 非线性展开，营造真实 15 度俯视纵深感
        const topMargin = H * 0.36;
        const courtScreenHeight = H * 0.41;
        const depthCurve = Math.pow(ny, 1.12);
        const groundY = topMargin + depthCurve * courtScreenHeight;

        // X 坐标：横向展开，随近大远小透视向外张开成等腰梯形
        // 稍微偏移相机中心至 nx=0.47，让 x=0.5 处的球网呈现出立体侧面网格感
        const camCenterNX = 0.47;
        const baseCourtW = W * 0.74;
        const sx = W * 0.5 + (nx - camCenterNX) * baseCourtW * perspectiveScale;

        // Z 轴高度向上抬升，且受近大远小缩放影响
        const heightFactor = H * 0.54 * perspectiveScale;
        const sy = groundY - z * heightFactor;

        return {
          x: sx,
          y: sy,
          groundY,
          scale: perspectiveScale
        };
      },

      /**
       * 主渲染入口，接收 (ctx, W, H, GameState)
       */
      render(ctx, W, H, state) {
        // 1. 绘制暗黑极简竞技场背景
        const bgGrad = ctx.createLinearGradient(0, 0, 0, H);
        bgGrad.addColorStop(0, '#050912');
        bgGrad.addColorStop(0.45, '#0d1b2e');
        bgGrad.addColorStop(1, '#060c17');
        ctx.fillStyle = bgGrad;
        ctx.fillRect(0, 0, W, H);

        // 聚光灯氛围
        const spot = ctx.createRadialGradient(W * 0.5, H * 0.45, 30, W * 0.5, H * 0.5, W * 0.55);
        spot.addColorStop(0, 'rgba(0, 240, 255, 0.12)');
        spot.addColorStop(1, 'rgba(0, 240, 255, 0)');
        ctx.fillStyle = spot;
        ctx.fillRect(0, 0, W, H);

        // 2. 绘制 15° 俯视横向 3D 球场
        this.drawCourt(ctx, W, H, state);

        // 3. 绘制虚线预测弧线与地面落点圆圈
        if (state.phase === 'flying' || state.phase === 'step' || state.phase === 'shot' || state.phase === 'defend') {
          this.drawPredictionAndLanding(ctx, W, H, state);
        }

        // 4. 按远近顺序绘制人物与真实立体球网
        // 先画左半场玩家、右半场 AI，并在 x=0.5 绘制高存在感真实网格球网
        this.drawStickman(ctx, W, H, state.player.nx, state.player.ny, '#00f0ff', state.player.swingAnim, true, state.player.alertExclamation);
        this.drawStickman(ctx, W, H, state.ai.nx, state.ai.ny, '#ff2a5f', state.ai.swingAnim, false, false);

        // 5. 绘制 x=0.5 处的真实网格立体球网
        this.drawRealisticNet(ctx, W, H);

        // 6. 绘制羽毛球、七彩流光长拖尾、以及杀球震惊涂鸦特效
        if (state.phase !== 'menu' && state.phase !== 'end') {
          this.drawShuttleAndTrail(ctx, W, H, state);
        }
      },

      drawLine3D(ctx, W, H, nx1, ny1, z1, nx2, ny2, z2, color, lineWidth = 2) {
        const p1 = this.projectCourt(nx1, ny1, z1, W, H);
        const p2 = this.projectCourt(nx2, ny2, z2, W, H);
        ctx.beginPath();
        ctx.moveTo(p1.x, p1.y);
        ctx.lineTo(p2.x, p2.y);
        ctx.strokeStyle = color;
        ctx.lineWidth = lineWidth;
        ctx.stroke();
      },

      drawCourt(ctx, W, H, state) {
        const cTL = this.projectCourt(0, 0, 0, W, H);
        const cTR = this.projectCourt(1, 0, 0, W, H);
        const cBR = this.projectCourt(1, 1, 0, W, H);
        const cBL = this.projectCourt(0, 1, 0, W, H);

        // 球场塑胶地垫填充
        ctx.beginPath();
        ctx.moveTo(cTL.x, cTL.y);
        ctx.lineTo(cTR.x, cTR.y);
        ctx.lineTo(cBR.x, cBR.y);
        ctx.lineTo(cBL.x, cBL.y);
        ctx.closePath();
        const floorGrad = ctx.createLinearGradient(0, cTL.y, 0, cBL.y);
        floorGrad.addColorStop(0, '#0e2942');
        floorGrad.addColorStop(0.5, '#113858');
        floorGrad.addColorStop(1, '#0b2239');
        ctx.fillStyle = floorGrad;
        ctx.fill();

        // 球场标准线绘制
        const mainLine = 'rgba(241, 245, 249, 0.82)';
        const subLine = 'rgba(148, 163, 184, 0.48)';

        // 外边界
        this.drawLine3D(ctx, W, H, 0, 0, 0, 1, 0, 0, mainLine, 2.2);
        this.drawLine3D(ctx, W, H, 0, 1, 0, 1, 1, 0, mainLine, 3.0);
        this.drawLine3D(ctx, W, H, 0, 0, 0, 0, 1, 0, mainLine, 2.6);
        this.drawLine3D(ctx, W, H, 1, 0, 0, 1, 1, 0, mainLine, 2.6);

        // 单打边线 (ny = 0.08, 0.92) & 双打后发球线 (nx = 0.06, 0.94)
        this.drawLine3D(ctx, W, H, 0, 0.08, 0, 1, 0.08, 0, subLine, 1.4);
        this.drawLine3D(ctx, W, H, 0, 0.92, 0, 1, 0.92, 0, subLine, 1.6);
        this.drawLine3D(ctx, W, H, 0.06, 0, 0, 0.06, 1, 0, subLine, 1.4);
        this.drawLine3D(ctx, W, H, 0.94, 0, 0, 0.94, 1, 0, subLine, 1.4);

        // 前发球线 (nx = 0.35 与 nx = 0.65)
        this.drawLine3D(ctx, W, H, 0.35, 0, 0, 0.35, 1, 0, mainLine, 1.8);
        this.drawLine3D(ctx, W, H, 0.65, 0, 0, 0.65, 1, 0, mainLine, 1.8);

        // 中线 (ny = 0.5, 从底线到前发球线)
        this.drawLine3D(ctx, W, H, 0, 0.5, 0, 0.35, 0.5, 0, mainLine, 1.8);
        this.drawLine3D(ctx, W, H, 0.65, 0.5, 0, 1, 0.5, 0, mainLine, 1.8);

        // 在玩家半场轻轻标出已解锁的步伐点位地标
        for (const dirKey of state.dirs) {
          const d = STEP_DIRS[dirKey];
          if (!d) continue;
          const pt = this.projectCourt(d.nx, d.ny, 0, W, H);
          ctx.save();
          ctx.translate(pt.x, pt.y);
          ctx.scale(1, 0.42);
          ctx.beginPath();
          ctx.arc(0, 0, 18 * pt.scale, 0, Math.PI * 2);
          ctx.strokeStyle = state.player.selectedDir === dirKey ? '#00f0ff' : 'rgba(0, 240, 255, 0.28)';
          ctx.lineWidth = 2;
          ctx.stroke();
          ctx.restore();
        }
      },

      /**
       * 2. 真实球网：在 x=0.5 处绘制球网，带有真实竖向/横向网格与垂直高度
       */
      drawRealisticNet(ctx, W, H) {
        const netX = 0.5;
        const netBottomZ = 0.02;
        const netTopZ = 0.165;

        // 球网地面投影阴影线
        this.drawLine3D(ctx, W, H, netX, 0, 0, netX, 1, 0, 'rgba(0, 0, 0, 0.55)', 5);

        // 远端与近端球柱 (z: 0 -> netTopZ)
        const postFarB = this.projectCourt(netX, -0.02, 0, W, H);
        const postFarT = this.projectCourt(netX, -0.02, netTopZ, W, H);
        const postNearB = this.projectCourt(netX, 1.02, 0, W, H);
        const postNearT = this.projectCourt(netX, 1.02, netTopZ, W, H);

        // 球网主体半透明深色衬底
        const nFarB = this.projectCourt(netX, 0, netBottomZ, W, H);
        const nFarT = this.projectCourt(netX, 0, netTopZ, W, H);
        const nNearB = this.projectCourt(netX, 1, netBottomZ, W, H);
        const nNearT = this.projectCourt(netX, 1, netTopZ, W, H);

        ctx.beginPath();
        ctx.moveTo(nFarT.x, nFarT.y);
        ctx.lineTo(nNearT.x, nNearT.y);
        ctx.lineTo(nNearB.x, nNearB.y);
        ctx.lineTo(nFarB.x, nFarB.y);
        ctx.closePath();
        ctx.fillStyle = 'rgba(0, 240, 255, 0.12)';
        ctx.fill();

        // 横向网格线 (6 条水平网绳)
        const hRows = 6;
        for (let r = 0; r <= hRows; r++) {
          const z = netBottomZ + (netTopZ - netBottomZ) * (r / hRows);
          this.drawLine3D(ctx, W, H, netX, 0, z, netX, 1, z, 'rgba(203, 213, 225, 0.48)', 1);
        }

        // 竖向网格线 (28 条垂直网绳，从 ny=0 到 ny=1)
        const vCols = 28;
        for (let c = 0; c <= vCols; c++) {
          const ny = c / vCols;
          this.drawLine3D(ctx, W, H, netX, ny, netBottomZ, netX, ny, netTopZ, 'rgba(203, 213, 225, 0.42)', 1);
        }

        // 球网顶部醒目白色封边网带 (Top White Tape)
        this.drawLine3D(ctx, W, H, netX, -0.02, netTopZ, netX, 1.02, netTopZ, '#ffffff', 4.2);

        // 远近两侧金属球柱
        ctx.beginPath();
        ctx.moveTo(postFarB.x, postFarB.y);
        ctx.lineTo(postFarT.x, postFarT.y);
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = 4;
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(postNearB.x, postNearB.y);
        ctx.lineTo(postNearT.x, postNearT.y);
        ctx.strokeStyle = '#00f0ff';
        ctx.lineWidth = 5.5;
        ctx.stroke();
      },

      /**
       * 3A. 虚线预测弧线和落点小圆圈
       */
      drawPredictionAndLanding(ctx, W, H, state) {
        const s = state.shuttle;
        const steps = 22;

        // 虚线预测弧线
        ctx.save();
        ctx.beginPath();
        ctx.setLineDash([6, 6]);
        for (let i = 0; i <= steps; i++) {
          const t = i / steps;
          const pos = PhysicsEngine.evalTrajectoryAt(s, t);
          const p = this.projectCourt(pos.nx, pos.ny, pos.z, W, H);
          if (i === 0) ctx.moveTo(p.x, p.y);
          else ctx.lineTo(p.x, p.y);
        }
        ctx.strokeStyle = s.isSmash ? 'rgba(255, 42, 95, 0.78)' : 'rgba(255, 255, 255, 0.48)';
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.restore();

        // 地面落点小圆圈 (双层呼吸光圈)
        const land = this.projectCourt(s.targetNX, s.targetNY, 0, W, H);
        const pulse = 0.82 + 0.22 * Math.sin(performance.now() * 0.012);
        const radius = 22 * land.scale * pulse;

        ctx.save();
        ctx.translate(land.x, land.y);
        ctx.scale(1, 0.45);
        ctx.beginPath();
        ctx.arc(0, 0, radius, 0, Math.PI * 2);
        ctx.strokeStyle = s.isSmash ? '#ff2a5f' : (s.owner === 'ai' ? '#ffb800' : '#00f0ff');
        ctx.lineWidth = 3;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(0, 0, 6 * land.scale, 0, Math.PI * 2);
        ctx.fillStyle = s.isSmash ? '#ff2a5f' : '#ffb800';
        ctx.fill();
        ctx.restore();
      },

      /**
       * 3B. 七彩流光拖尾 (紫→蓝→青→绿→黄→红→白 渐变色，长渐隐) & 杀球美漫速度线与 "💥!!!" 涂鸦
       */
      getRainbowTrailColor(ratio) {
        // ratio: 0.0 (最老尾端: 紫) -> 1.0 (最新球头: 白)
        // 严格按照：紫 → 蓝 → 青 → 绿 → 黄 → 红 → 白 平滑插值
        const stops = [
          { t: 0.00, r: 168, g:  85, b: 247 }, // 紫 (#a855f7)
          { t: 0.17, r:  59, g: 130, b: 246 }, // 蓝 (#3b82f6)
          { t: 0.34, r:   0, g: 240, b: 255 }, // 青 (#00f0ff)
          { t: 0.50, r:  34, g: 197, b:  94 }, // 绿 (#22c55e)
          { t: 0.67, r: 253, g: 224, b:  71 }, // 黄 (#fde047)
          { t: 0.84, r: 255, g:  42, b:  95 }, // 红 (#ff2a5f)
          { t: 1.00, r: 255, g: 255, b: 255 }  // 白 (#ffffff)
        ];
        const clamped = Math.max(0, Math.min(1, ratio));
        for (let i = 0; i < stops.length - 1; i++) {
          const s0 = stops[i];
          const s1 = stops[i + 1];
          if (clamped >= s0.t && clamped <= s1.t) {
            const localT = (clamped - s0.t) / (s1.t - s0.t);
            const r = Math.round(s0.r + (s1.r - s0.r) * localT);
            const g = Math.round(s0.g + (s1.g - s0.g) * localT);
            const b = Math.round(s0.b + (s1.b - s0.b) * localT);
            return `rgb(${r}, ${g}, ${b})`;
          }
        }
        return 'rgb(255, 255, 255)';
      },

      drawShuttleAndTrail(ctx, W, H, state) {
        const s = state.shuttle;

        // 1. 地面羽毛球阴影
        const shadow = this.projectCourt(s.nx, s.ny, 0, W, H);
        ctx.save();
        ctx.translate(shadow.x, shadow.y);
        ctx.scale(1, 0.42);
        ctx.beginPath();
        ctx.arc(0, 0, 7 * shadow.scale, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(0, 0, 0, 0.52)';
        ctx.fill();
        ctx.restore();

        // 2. 绘制七彩流光长渐隐拖尾 (紫→蓝→青→绿→黄→红→白)
        if (s.trail.length > 1) {
          ctx.save();
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          for (let i = 1; i < s.trail.length; i++) {
            const pt0 = s.trail[i - 1];
            const pt1 = s.trail[i];
            const p0 = this.projectCourt(pt0.nx, pt0.ny, pt0.z, W, H);
            const p1 = this.projectCourt(pt1.nx, pt1.ny, pt1.z, W, H);

            // freshness: 0 (最旧末端: 紫) -> 1 (最新球头: 白)
            const freshness = Math.max(0, 1 - pt1.age / pt1.maxAge);
            const color = this.getRainbowTrailColor(freshness);

            ctx.beginPath();
            ctx.moveTo(p0.x, p0.y);
            ctx.lineTo(p1.x, p1.y);
            ctx.strokeStyle = color;
            ctx.globalAlpha = Math.pow(freshness, 0.85) * 0.92;
            ctx.lineWidth = Math.max(1.5, freshness * 9.5 * p1.scale);
            ctx.stroke();
          }
          ctx.restore();
        }

        // 3. 杀球震惊特效：美漫风格红色速度线 & “💥!!!”涂鸦飘字
        for (const fx of s.smashGraffiti) {
          const p = this.projectCourt(fx.nx, fx.ny, fx.z, W, H);
          const alpha = Math.max(0, fx.life / fx.maxLife);
          ctx.save();
          ctx.globalAlpha = alpha;

          // 美漫红色放射/疾驰速度线
          for (const line of fx.lines) {
            ctx.beginPath();
            ctx.moveTo(p.x + line.x1, p.y + line.y1);
            ctx.lineTo(p.x + line.x2, p.y + line.y2);
            ctx.strokeStyle = line.bright ? '#ff2a5f' : '#ff6b81';
            ctx.lineWidth = line.w;
            ctx.stroke();
          }

          // 醒目的美漫涂鸦飘字 “💥!!!”
          ctx.translate(p.x + fx.offsetX, p.y + fx.offsetY - (1 - alpha) * 28);
          ctx.rotate(fx.angle);
          ctx.font = 'italic 900 32px "Inter", sans-serif';
          ctx.textAlign = 'center';
          ctx.lineWidth = 5;
          ctx.strokeStyle = '#000000';
          ctx.strokeText('💥!!!', 0, 0);
          ctx.fillStyle = '#ff2a5f';
          ctx.fillText('💥!!!', 0, 0);
          ctx.restore();
        }

        // 4. 羽毛球本体
        const cur = this.projectCourt(s.nx, s.ny, s.z, W, H);
        ctx.save();
        ctx.beginPath();
        ctx.arc(cur.x, cur.y, Math.max(5, 7.5 * cur.scale), 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.shadowColor = s.isSmash ? '#ff2a5f' : '#00f0ff';
        ctx.shadowBlur = s.isSmash ? 18 : 10;
        ctx.fill();
        ctx.restore();
      },

      /**
       * 4. 人物骨骼：简单的火柴人，支持接杀时头顶出现红色感叹号 ❗
       */
      drawStickman(ctx, W, H, nx, ny, color, swingAnim, isPlayer, showAlertExclamation) {
        const foot = this.projectCourt(nx, ny, 0, W, H);
        const head = this.projectCourt(nx, ny, 0.145, W, H);
        const sc = foot.scale;

        const hipX = foot.x;
        const hipY = foot.y - 22 * sc;
        const shoulderX = head.x;
        const shoulderY = head.y + 13 * sc;

        // 脚下光圈
        ctx.save();
        ctx.translate(foot.x, foot.y);
        ctx.scale(1, 0.42);
        ctx.beginPath();
        ctx.arc(0, 0, 19 * sc, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(0, 0, 0, 0.42)';
        ctx.fill();
        ctx.strokeStyle = color;
        ctx.lineWidth = 2;
        ctx.stroke();
        ctx.restore();

        ctx.save();
        ctx.strokeStyle = color;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.lineWidth = Math.max(2.5, 4 * sc);

        // 双腿骨骼 (跑位动态迈步)
        const stride = Math.sin(performance.now() * 0.018) * 6 * sc;
        ctx.beginPath();
        ctx.moveTo(hipX, hipY);
        ctx.lineTo(foot.x - 9 * sc + stride * 0.4, foot.y);
        ctx.moveTo(hipX, hipY);
        ctx.lineTo(foot.x + 9 * sc - stride * 0.4, foot.y);
        ctx.stroke();

        // 躯干骨骼
        ctx.beginPath();
        ctx.moveTo(hipX, hipY);
        ctx.lineTo(shoulderX, shoulderY);
        ctx.stroke();

        // 头部圆环
        ctx.beginPath();
        ctx.arc(head.x, head.y, Math.max(5.5, 8.5 * sc), 0, Math.PI * 2);
        ctx.fillStyle = '#0f172a';
        ctx.fill();
        ctx.stroke();

        // 持拍手臂与球拍挥动
        const dirSign = isPlayer ? 1 : -1;
        const swingAngle = -0.85 + swingAnim * 1.95;
        const handX = shoulderX + dirSign * Math.cos(swingAngle) * 19 * sc;
        const handY = shoulderY + Math.sin(swingAngle) * 19 * sc;

        ctx.beginPath();
        ctx.moveTo(shoulderX, shoulderY);
        ctx.lineTo(handX, handY);
        ctx.stroke();

        // 球拍杆与拍框
        const racketTipX = handX + dirSign * Math.cos(swingAngle - 0.3) * 18 * sc;
        const racketTipY = handY + Math.sin(swingAngle - 0.3) * 18 * sc;
        ctx.beginPath();
        ctx.moveTo(handX, handY);
        ctx.lineTo(racketTipX, racketTipY);
        ctx.strokeStyle = '#f8fafc';
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(racketTipX, racketTipY, Math.max(5, 8 * sc), 0, Math.PI * 2);
        ctx.strokeStyle = swingAnim > 0.1 ? '#ffb800' : color;
        ctx.lineWidth = 2.2;
        ctx.stroke();

        // 接杀时头顶显示醒目红色感叹号 ❗
        if (showAlertExclamation) {
          const bounce = Math.abs(Math.sin(performance.now() * 0.016)) * 8;
          ctx.font = `bold ${Math.round(30 * sc)}px "Inter", sans-serif`;
          ctx.textAlign = 'center';
          ctx.fillStyle = '#ff2a5f';
          ctx.shadowColor = '#ff2a5f';
          ctx.shadowBlur = 12;
          ctx.fillText('❗', head.x, head.y - 18 * sc - bounce);
          ctx.shadowBlur = 0;
        }
        ctx.restore();
      }
    };

    // ============================================================================
    // [MODULE 2B] 物理轨迹与杀球涂鸦生成器 (PhysicsEngine)
    // ============================================================================
    const PhysicsEngine = {
      evalTrajectoryAt(s, t) {
        const clampedT = Math.max(0, Math.min(1, t));
        // 羽毛球初速快、末段空气阻力减速
        const easeXZ = s.isSmash
          ? 1 - Math.pow(1 - clampedT, 1.18)
          : 1 - Math.pow(1 - clampedT, 1.42);
        const nx = s.startNX + (s.targetNX - s.startNX) * easeXZ;
        const ny = s.startNY + (s.targetNY - s.startNY) * easeXZ;

        const endZ = 0.02;
        const linearZ = (1 - clampedT) * s.startZ + clampedT * endZ;
        const arcZ = 4 * clampedT * (1 - clampedT) * Math.max(0, s.peakZ - (s.startZ + endZ) * 0.5);
        const z = Math.max(0, linearZ + arcZ);
        return { nx, ny, z };
      },

      launchShuttle({ fromNX, fromNY, fromZ, toNX, toNY, targetDir, shotName, owner }) {
        const spec = SHOT_TYPES[shotName] || SHOT_TYPES['高远球'];
        const s = GameState.shuttle;
        s.startNX = fromNX;
        s.startNY = fromNY;
        s.startZ = fromZ;
        s.nx = fromNX;
        s.ny = fromNY;
        s.z = fromZ;
        s.targetNX = toNX;
        s.targetNY = toNY;
        s.targetDir = targetDir || '↓';
        s.peakZ = spec.peakZ;
        s.flightDuration = spec.duration;
        s.flightElapsed = 0;
        s.owner = owner;
        s.shotType = shotName;
        s.isSmash = Boolean(spec.isSmash);

        // 若判定为杀球 (smash)，立即在羽毛球 3D 坐标处生成美漫红色速度线和 “💥!!!” 涂鸦飘字
        if (s.isSmash) {
          this.spawnSmashShockEffect(fromNX, fromNY, fromZ);
        }
      },

      spawnSmashShockEffect(nx, ny, z) {
        const lines = [];
        const lineCount = 14;
        for (let i = 0; i < lineCount; i++) {
          const ang = (Math.PI * 2 * i) / lineCount + (Math.random() - 0.5) * 0.25;
          const r1 = 12 + Math.random() * 14;
          const r2 = 42 + Math.random() * 48;
          lines.push({
            x1: Math.cos(ang) * r1,
            y1: Math.sin(ang) * r1,
            x2: Math.cos(ang) * r2,
            y2: Math.sin(ang) * r2,
            w: 2 + Math.random() * 2.5,
            bright: i % 2 === 0
          });
        }
        GameState.shuttle.smashGraffiti.push({
          nx,
          ny,
          z,
          offsetX: (Math.random() - 0.5) * 28,
          offsetY: -18 - Math.random() * 16,
          angle: (Math.random() - 0.5) * 0.35,
          life: 0.78,
          maxLife: 0.78,
          lines
        });
      },

      update(dt) {
        const p = GameState.player;
        const ai = GameState.ai;
        const s = GameState.shuttle;

        // 1. 玩家 Ease-out 自动跑位插值 (Agent 3 核心要求)
        if (p.moveProgress < 1.0) {
          p.moveProgress = Math.min(1.0, p.moveProgress + dt / p.moveDuration);
          const easeOut = 1 - Math.pow(1 - p.moveProgress, 3);
          p.nx = p.startNX + (p.targetNX - p.startNX) * easeOut;
          p.ny = p.startNY + (p.targetNY - p.startNY) * easeOut;
        }
        if (p.swingAnim > 0) p.swingAnim = Math.max(0, p.swingAnim - dt * 3.8);

        // 2. AI 平滑跑位
        ai.nx += (ai.targetNX - ai.nx) * Math.min(1, dt * 6.5);
        ai.ny += (ai.targetNY - ai.ny) * Math.min(1, dt * 6.5);
        if (ai.swingAnim > 0) ai.swingAnim = Math.max(0, ai.swingAnim - dt * 3.8);

        // 3. 更新彩色流光拖尾寿命 (长渐隐 maxAge = 0.85s)
        for (let i = s.trail.length - 1; i >= 0; i--) {
          s.trail[i].age += dt;
          if (s.trail[i].age >= s.trail[i].maxAge) {
            s.trail.splice(i, 1);
          }
        }

        // 4. 更新杀球美漫涂鸦寿命
        for (let i = s.smashGraffiti.length - 1; i >= 0; i--) {
          s.smashGraffiti[i].life -= dt;
          if (s.smashGraffiti[i].life <= 0) {
            s.smashGraffiti.splice(i, 1);
          }
        }

        // 5. 横幅计时器
        if (GameState.banner.timer > 0) {
          GameState.banner.timer = Math.max(0, GameState.banner.timer - dt);
        }

        // 6. 羽毛球在飞行/选步法/选球路/接杀阶段的推进
        if (GameState.phase === 'flying' || GameState.phase === 'step' || GameState.phase === 'shot' || GameState.phase === 'defend') {
          // 在玩家思考步法或球路时适度放缓球速，保证操控爽快感
          const timeScale = (GameState.phase === 'step' || GameState.phase === 'shot')
            ? 0.42
            : (GameState.phase === 'defend' ? 0.35 : 1.0);

          s.flightElapsed += dt * timeScale;
          const t = Math.min(1, s.flightElapsed / s.flightDuration);
          const pos = this.evalTrajectoryAt(s, t);
          s.nx = pos.nx;
          s.ny = pos.ny;
          s.z = pos.z;

          // 采样追加七彩流光点
          s.trail.push({
            nx: s.nx,
            ny: s.ny,
            z: s.z,
            age: 0,
            maxAge: 0.85
          });
          if (s.trail.length > 56) s.trail.shift();

          // 杀球飞行途中偶发追加速度线残影
          if (s.isSmash && Math.random() < dt * 7) {
            this.spawnSmashShockEffect(s.nx, s.ny, s.z);
          }

          // 飞行到达终点触发状态流转
          if (GameState.phase === 'flying' && s.owner === 'player' && t >= 0.94) {
            LevelDesigner.onShuttleReachAI();
          } else if (s.owner === 'ai' && t >= 1.0 && GameState.phase !== 'shot') {
            // 玩家超时未完成救球
            p.alertExclamation = false;
            LevelDesigner.onPointEnded('ai', '羽毛球已落地，接球超时失分！');
          }
        }
      }
    };

    // ============================================================================
    // [AGENT 3] 核心交互与 QTE 工程师模块 (Interaction & QTE)
    // ============================================================================
    const InteractionQTE = {
      /**
       * 根据所选步伐区域过滤并返回当前匹配的已解锁球路 (最多4个，严格对应 1居中 / 2并排 / 3-4田字格)
       */
      getMatchingUnlockedShots(dirId) {
        const dirSpec = STEP_DIRS[dirId] || STEP_DIRS['↓'];
        const unlocked = GameState.shots;

        // 按区域优先级排序匹配的球路，最多取 4 个以构成标准田字格
        const priorityMap = {
          back:   ['高远球', '吊球', '重杀', '推球', '平抽', '放网'],
          front:  ['放网', '推球', '高远球', '平抽', '吊球', '重杀'],
          corner: ['高远球', '吊球', '放网', '推球', '重杀', '平抽'],
          mid:    ['平抽', '推球', '重杀', '高远球', '吊球', '放网']
        };
        const order = priorityMap[dirSpec.region] || priorityMap.back;
        const matched = order.filter(s => unlocked.includes(s));
        return matched.slice(0, 4);
      },

      /**
       * 玩家点选步伐按钮 -> Ease-out 自动跑位 -> 弹出区域匹配球路面板
       */
      selectStepDirection(dirId) {
        const d = STEP_DIRS[dirId];
        if (!d) return;
        AudioEngine.init();
        AudioEngine.playStep();

        const p = GameState.player;
        p.selectedDir = dirId;
        p.startNX = p.nx;
        p.startNY = p.ny;
        p.targetNX = d.nx;
        p.targetNY = d.ny;
        p.moveProgress = 0.0;
        p.moveDuration = 0.32;

        // 计算步伐选择与 AI 来球目标方向的偏差 (用于 A+B+C 失误率中的 B 项)
        const distErr = Math.hypot(d.nx - GameState.shuttle.targetNX, d.ny - GameState.shuttle.targetNY);
        p.balanceError = distErr;
        p.stamina = Math.max(25, p.stamina - 4);

        GameState.shotWindow.timer = 0;
        GameState.phase = 'shot';
        GameState.statusText = `正在跑向【${d.label}】... 请选择回球球路！`;
        UIController.rebuildButtons();
      },

      /**
       * 失误机制 (A+B+C)：
       * 正常击球失误率 = A:基础随机(3-5%) + B:状态差加成(体力/重心) + C:操作偏差加成(按太快/太慢)
       * 返回结果：'Perfect' | '正常' | 'Miss'
       */
      evaluateShotJudge() {
        const p = GameState.player;
        const sw = GameState.shotWindow;

        // A: 基础随机失误率 (3% ~ 5%)
        const baseA = 0.03 + Math.random() * 0.02;

        // B: 状态差加成 (体力损耗 + 步伐选位偏差)
        const fatiguePenalty = Math.max(0, (100 - p.stamina) * 0.0012);
        const positionPenalty = p.balanceError > 0.16 ? Math.min(0.45, p.balanceError * 0.95) : 0;
        const stateB = fatiguePenalty + positionPenalty;

        // C: 操作偏差加成 (跑位尚未到位按太快，或球快落地按太慢)
        const timingDiff = Math.abs(sw.timer - sw.optimalTime);
        const timingC = timingDiff > 0.22 ? Math.min(0.35, (timingDiff - 0.22) * 0.45) : 0;

        const totalMissProb = Math.min(0.85, baseA + stateB + timingC);
        sw.lastMissBreakdown = `失误率 A(${(baseA * 100).toFixed(1)}%) + B(${(stateB * 100).toFixed(1)}%) + C(${(timingC * 100).toFixed(1)}%) = ${(totalMissProb * 100).toFixed(1)}%`;

        // 判定结果：教学模式下只要选对步伐方向即可免受纯随机 A 惩罚，确保无挫败教学体验
        const isCorrectDir = p.selectedDir === GameState.shuttle.targetDir;
        const effectiveMissProb = (GameState.mode === 'tutorial' && isCorrectDir && timingC < 0.15)
          ? 0
          : totalMissProb;

        if (Math.random() < effectiveMissProb) {
          sw.lastJudgeResult = 'Miss';
          return 'Miss';
        }
        if (isCorrectDir && timingDiff <= 0.22) {
          sw.lastJudgeResult = 'Perfect';
          return 'Perfect';
        }
        sw.lastJudgeResult = '正常';
        return '正常';
      },

      /**
       * 玩家点击球路按钮执行击球
       */
      executeShot(shotName) {
        const spec = SHOT_TYPES[shotName];
        if (!spec) return;

        const judge = this.evaluateShotJudge();
        const p = GameState.player;
        p.swingAnim = 1.0;

        if (judge === 'Miss') {
          AudioEngine.playHit('normal');
          LevelDesigner.onPointEnded('ai', `击球失误 (${GameState.shotWindow.lastMissBreakdown})`);
          return;
        }

        AudioEngine.playHit(spec.isSmash ? 'smash' : 'normal');

        // 依据所选球路决定落向 AI 半场的坐标
        const targetNY = p.ny > 0.5 ? 0.22 + Math.random() * 0.25 : 0.55 + Math.random() * 0.25;
        PhysicsEngine.launchShuttle({
          fromNX: p.nx,
          fromNY: p.ny,
          fromZ: spec.isSmash ? 0.28 : 0.15,
          toNX: spec.targetNX,
          toNY: targetNY,
          targetDir: p.selectedDir,
          shotName,
          owner: 'player'
        });

        GameState.banner.text = `${judge === 'Perfect' ? '✨ PERFECT · ' : ''}${shotName}`;
        GameState.banner.subText = GameState.shotWindow.lastMissBreakdown;
        GameState.banner.color = judge === 'Perfect' ? '#00f0ff' : '#ffb800';
        GameState.banner.timer = 0.95;

        GameState.phase = 'flying';
        GameState.statusText = `打出【${shotName}】(${judge})！`;
        UIController.rebuildButtons();
      },

      /**
       * 触发快慢刀接杀 QTE
       */
      triggerDefenseQTE(requiredTrack) {
        AudioEngine.playAlert();
        const q = GameState.qte;
        q.active = true;
        q.progress = 0.08;
        q.dir = 1;
        // 随机初速度 (0.015 ~ 0.035)
        q.speed = 0.015 + Math.random() * 0.020;
        q.greenMin = 0.36;
        q.greenMax = 0.64;
        q.requiredTrack = requiredTrack; // '上' | '中' | '下'
        q.maxTime = 2.4;
        q.timeLeft = q.maxTime;

        GameState.player.alertExclamation = true;
        GameState.phase = 'defend';
        GameState.statusText = `❗ 对手重杀向【${requiredTrack}路】！等光标进入绿区瞬间点击【${requiredTrack}】接杀！`;
        UIController.rebuildButtons();
      },

      /**
       * 快慢刀 QTE 进度条每帧更新 (每次反弹重新随机生成 0.015 - 0.035 的速度)
       */
      updateQTE(dt) {
        if (GameState.phase === 'shot') {
          GameState.shotWindow.timer += dt;
        }
        if (GameState.phase !== 'defend' || !GameState.qte.active) return;

        const q = GameState.qte;
        // 按 60fps 基准归一化推进光标
        q.progress += q.dir * q.speed * (dt * 60);

        if (q.progress >= 1.0) {
          q.progress = 1.0;
          q.dir = -1;
          q.speed = 0.015 + Math.random() * 0.020; // 快慢刀变速！
        } else if (q.progress <= 0.0) {
          q.progress = 0.0;
          q.dir = 1;
          q.speed = 0.015 + Math.random() * 0.020; // 快慢刀变速！
        }

        q.timeLeft -= dt;
        if (q.timeLeft <= 0) {
          q.active = false;
          GameState.player.alertExclamation = false;
          LevelDesigner.onPointEnded('ai', '接杀 QTE 超时未出手，被重杀得分！');
        }
      },

      /**
       * 玩家点击【上 / 中 / 下】按钮进行接杀 QTE 判定
       * 返回 'Perfect' 或 'Miss'
       */
      handleQTEClick(chosenTrack) {
        const q = GameState.qte;
        q.active = false;
        GameState.player.alertExclamation = false;

        const inGreenZone = q.progress >= q.greenMin && q.progress <= q.greenMax;
        const dirMatched = chosenTrack === q.requiredTrack;

        if (inGreenZone && dirMatched) {
          // 完美接杀挑回后场！
          AudioEngine.playHit('normal');
          GameState.player.swingAnim = 1.0;
          GameState.banner.text = '⚡ PERFECT 完美接杀！';
          GameState.banner.subText = `精准预判【${chosenTrack}路】+ 绿区完美时机`;
          GameState.banner.color = '#22c55e';
          GameState.banner.timer = 1.1;

          PhysicsEngine.launchShuttle({
            fromNX: GameState.player.nx,
            fromNY: GameState.player.ny,
            fromZ: 0.14,
            toNX: 0.88,
            toNY: 0.50,
            targetDir: '↓',
            shotName: '高远球',
            owner: 'player'
          });
          GameState.phase = 'flying';
          GameState.statusText = '完美挡网挑高远球！转守为攻！';
          UIController.rebuildButtons();
          return 'Perfect';
        } else {
          // 判定 Miss 丢分
          const reason = !dirMatched
            ? `接杀方向错误（来球为【${q.requiredTrack}】，误按【${chosenTrack}】）`
            : '接杀时机偏离绿色完美区，挡球下网！';
          GameState.banner.text = '💥 QTE MISS!';
          GameState.banner.subText = reason;
          GameState.banner.color = '#ff2a5f';
          GameState.banner.timer = 1.1;
          LevelDesigner.onPointEnded('ai', reason);
          return 'Miss';
        }
      }
    };

    // ============================================================================
    // [AGENT 4] 游戏系统与关卡策划模块 (System & Level Design)
    // ============================================================================
    const LevelDesigner = {
      /**
       * 加载指定模式与关卡，严格同步 GameState.dirs 和 GameState.shots
       */
      loadModeAndLevel(mode, levelNum = 1) {
        GameState.mode = mode;
        const clampedLv = Math.max(1, Math.min(TUTORIAL_LEVELS.length, levelNum));
        GameState.level = clampedLv;
        GameState.rallyCount = 0;
        GameState.aiAltIndex = 0;
        GameState.score.player = 0;
        GameState.score.ai = 0;

        if (mode === 'veteran') {
          // 老手直接开打：解锁全部 6 向步伐与 6 种球路
          GameState.dirs = ['↓', '↑', '↙', '↘', '←', '→'];
          GameState.shots = ['高远球', '放网', '吊球', '平抽', '推球', '重杀'];
          GameState.targetRallies = 5;
          GameState.ai.name = '宗师·羽刃无双';
        } else {
          // 渐进式无感教学：仅解锁当前关卡配置的步伐与球路
          const cfg = TUTORIAL_LEVELS[clampedLv - 1];
          GameState.dirs = [...cfg.dirs];
          GameState.shots = [...cfg.shots];
          GameState.targetRallies = cfg.targetRallies;
          GameState.ai.name = `教学陪练·第${clampedLv}关`;
        }

        this.setupServeRally();
      },

      setupServeRally() {
        const p = GameState.player;
        p.nx = 0.24;
        p.ny = 0.50;
        p.startNX = 0.24;
        p.startNY = 0.50;
        p.targetNX = 0.24;
        p.targetNY = 0.50;
        p.moveProgress = 1.0;
        p.stamina = 100;
        p.balanceError = 0;
        p.alertExclamation = false;

        GameState.ai.nx = 0.76;
        GameState.ai.ny = 0.50;
        GameState.ai.targetNX = 0.76;
        GameState.ai.targetNY = 0.50;

        GameState.shuttle.nx = 0.28;
        GameState.shuttle.ny = 0.50;
        GameState.shuttle.z = 0.14;
        GameState.shuttle.trail = [];
        GameState.shuttle.smashGraffiti = [];

        GameState.phase = 'serve';
        GameState.statusText = GameState.mode === 'tutorial'
          ? `【${TUTORIAL_LEVELS[GameState.level - 1].title}】进度 ${GameState.rallyCount}/${GameState.targetRallies} 拍 — 点击发球`
          : '【老手实战】点击发球开启对决';
        UIController.rebuildButtons();
      },

      handleServe() {
        AudioEngine.init();
        AudioEngine.playHit('normal');
        GameState.player.swingAnim = 1.0;

        PhysicsEngine.launchShuttle({
          fromNX: GameState.player.nx,
          fromNY: GameState.player.ny,
          fromZ: 0.15,
          toNX: 0.82,
          toNY: 0.50,
          targetDir: '↓',
          shotName: '高远球',
          owner: 'player'
        });

        GameState.phase = 'flying';
        GameState.statusText = '发球升空！观察对手回球落点...';
        UIController.rebuildButtons();
      },

      /**
       * 当玩家的球飞抵 AI 半场时：
       * 1. 累计成功拍数 rallyCount，并在教学模式下检查是否达到过关拍数 (3-6拍)
       * 2. 若未过关，执行 AI 喂球逻辑（教学严格按关卡要求回球 / 老手随机搭配 + 30% 概率杀球触发 QTE）
       */
      onShuttleReachAI() {
        const s = GameState.shuttle;

        // 老手模式下若玩家打出完美重杀，有一定概率直接得分
        if (GameState.mode === 'veteran' && s.isSmash && Math.random() < 0.42) {
          this.onPointEnded('player', '雷霆重杀洞穿防线！直接得分！');
          return;
        }

        // 玩家成功完成一拍有效回球
        GameState.rallyCount += 1;

        // 教学模式：检查是否达到本关指定拍数 (3-6拍) 自动过关并加载下一关！
        if (GameState.mode === 'tutorial' && GameState.rallyCount >= GameState.targetRallies) {
          this.advanceTutorialLevel();
          return;
        }

        // AI 挥拍回球
        GameState.ai.swingAnim = 1.0;
        const aiDecision = this.chooseAIShot();

        AudioEngine.playHit(aiDecision.shotName === '重杀' ? 'smash' : 'normal');
        const targetSpec = STEP_DIRS[aiDecision.targetDir] || STEP_DIRS['↓'];

        PhysicsEngine.launchShuttle({
          fromNX: GameState.ai.nx,
          fromNY: GameState.ai.ny,
          fromZ: aiDecision.shotName === '重杀' ? 0.29 : 0.16,
          toNX: targetSpec.nx,
          toNY: targetSpec.ny,
          targetDir: aiDecision.targetDir,
          shotName: aiDecision.shotName,
          owner: 'ai'
        });

        // 如果 AI 打出杀球，立即触发快慢刀接杀 QTE
        if (aiDecision.shotName === '重杀') {
          const tracks = ['上', '中', '下'];
          const track = targetSpec.ny < 0.38 ? '上' : (targetSpec.ny > 0.62 ? '下' : tracks[Math.floor(Math.random() * 3)]);
          InteractionQTE.triggerDefenseQTE(track);
        } else {
          GameState.phase = 'step';
          GameState.statusText = `AI 回球至【${targetSpec.label}】！请点击对应步伐跑位 (${GameState.rallyCount}/${GameState.targetRallies}拍)`;
          UIController.rebuildButtons();
        }
      },

      /**
       * AI 选球行为树：
       * - 教学模式下：严格按照当前关卡要求喂球
       * - 老手模式下：随机搭配，且有 30% 概率触发杀球（触发接杀 QTE）
       */
      chooseAIShot() {
        if (GameState.mode === 'veteran') {
          const allDirs = ['↓', '↑', '↙', '↘', '←', '→'];
          const targetDir = allDirs[Math.floor(Math.random() * allDirs.length)];
          // 老手模式严格 30% 概率触发杀球
          if (Math.random() < 0.30) {
            return { targetDir, shotName: '重杀' };
          }
          const normalShots = ['高远球', '放网', '吊球', '平抽', '推球'];
          const shotName = normalShots[Math.floor(Math.random() * normalShots.length)];
          return { targetDir, shotName };
        }

        // 教学模式：严格按照 TUTORIAL_LEVELS[level - 1] 喂球
        const lv = GameState.level;
        const cfg = TUTORIAL_LEVELS[lv - 1];

        if (lv === 1) {
          // 第1关：AI 只打后场 ↓
          return { targetDir: '↓', shotName: '高远球' };
        } else if (lv === 2) {
          // 第2关：AI 前后交替 (↓ 与 ↑)
          const dir = GameState.aiAltIndex % 2 === 0 ? '↑' : '↓';
          GameState.aiAltIndex += 1;
          return { targetDir: dir, shotName: dir === '↑' ? '放网' : '高远球' };
        } else if (lv === 3) {
          // 第3关：AI 打四方球 (优先喂 ↙ / ↘ 让玩家练习新步伐)
          const order = ['↙', '↘', '↓', '↑'];
          const dir = order[GameState.aiAltIndex % order.length];
          GameState.aiAltIndex += 1;
          return { targetDir: dir, shotName: (dir === '↑' || dir === '↘') ? '吊球' : '高远球' };
        } else if (lv === 4) {
          // 第4关：AI 打中场 (← / →)
          const order = ['←', '→', '←', '→', '↙'];
          const dir = order[GameState.aiAltIndex % order.length];
          GameState.aiAltIndex += 1;
          return { targetDir: dir, shotName: '平抽' };
        } else {
          // 第5关：完全体，AI 交替出杀球让玩家体验快慢刀 QTE 与反击
          GameState.aiAltIndex += 1;
          if (GameState.aiAltIndex % 2 === 1) {
            return { targetDir: '←', shotName: '重杀' };
          }
          const d = cfg.aiDirs[GameState.aiAltIndex % cfg.aiDirs.length];
          return { targetDir: d, shotName: '推球' };
        }
      },

      /**
       * 教学模式赢下指定拍数后：自动弹出“过关”并加载下一关，点亮新按钮
       */
      advanceTutorialLevel() {
        AudioEngine.playLevelUp();
        GameState.score.player += 1;

        if (GameState.level < TUTORIAL_LEVELS.length) {
          const nextLv = GameState.level + 1;
          const nextCfg = TUTORIAL_LEVELS[nextLv - 1];
          GameState.level = nextLv;
          GameState.dirs = [...nextCfg.dirs];
          GameState.shots = [...nextCfg.shots];
          GameState.rallyCount = 0;
          GameState.targetRallies = nextCfg.targetRallies;
          GameState.aiAltIndex = 0;
          GameState.ai.name = `教学陪练·第${nextLv}关`;

          GameState.banner.text = `🎉 过关！进入 ${nextCfg.title}`;
          GameState.banner.subText = nextCfg.subtitle;
          GameState.banner.color = '#22c55e';
          GameState.banner.timer = 2.4;

          this.setupServeRally();
        } else {
          // 5 关全部通关！
          GameState.banner.text = '🏆 恭喜完成全部 5 关羽刃教学！';
          GameState.banner.subText = '全部步伐与球路已融会贯通，可随时体验老手实战模式';
          GameState.banner.color = '#ffb800';
          GameState.banner.timer = 3.0;
          GameState.phase = 'end';
          UIController.rebuildButtons();
        }
      },

      onPointEnded(winner, reason) {
        if (winner === 'player') {
          GameState.score.player += 1;
          AudioEngine.playLevelUp();
        } else {
          GameState.score.ai += 1;
        }

        GameState.statusText = reason;

        if (GameState.mode === 'veteran' && (GameState.score.player >= GameState.score.winTarget || GameState.score.ai >= GameState.score.winTarget)) {
          GameState.phase = 'end';
          UIController.rebuildButtons();
        } else {
          this.setupServeRally();
        }
      },

      update(dt) {
        // AI 自动向玩家回球落点移动
        if (GameState.phase === 'flying' && GameState.shuttle.owner === 'player') {
          GameState.ai.targetNX = GameState.shuttle.targetNX;
          GameState.ai.targetNY = GameState.shuttle.targetNY;
        } else {
          GameState.ai.targetNX = 0.76;
          GameState.ai.targetNY = 0.50;
        }
      }
    };

    // ============================================================================
    // [AGENT 1 + AGENT 3 + AGENT 4] UI 布局与 pointerdown 坐标点击检测控制器
    // ============================================================================
    const UIController = {
      buttons: [],

      /**
       * 重新构建当前阶段可点击按钮：
       * - 严格遵守 Agent 4：未解锁的步伐和球路绝对不画出来（无灰色带锁按钮）
       * - 严格遵守 Agent 3：球路面板 1个绝对居中，2个并排，3-4个田字格排列
       */
      rebuildButtons() {
        this.buttons = [];
        const W = LOGICAL_W;
        const H = LOGICAL_H;

        // 顶部通用按钮：音效开关 & 返回菜单
        this.buttons.push({
          id: 'btn_mute',
          x: W - 142,
          y: 16,
          w: 122,
          h: 36,
          label: AudioEngine.muted ? '🔇 音效: 关' : '🔊 音效: 开',
          theme: 'ghost',
          onClick: () => {
            AudioEngine.init();
            AudioEngine.muted = !AudioEngine.muted;
            AudioEngine.playClick();
            this.rebuildButtons();
          }
        });

        if (GameState.phase !== 'menu') {
          this.buttons.push({
            id: 'btn_back_menu',
            x: W - 276,
            y: 16,
            w: 122,
            h: 36,
            label: '⌂ 返回主菜单',
            theme: 'ghost',
            onClick: () => {
              AudioEngine.playClick();
              GameState.phase = 'menu';
              this.rebuildButtons();
            }
          });
        }

        // 各阶段按钮构建
        if (GameState.phase === 'menu') {
          // 菜单提供【新手教学】和【老手直接开打】
          this.buttons.push({
            id: 'menu_tutorial',
            x: W * 0.5 - 250,
            y: 340,
            w: 230,
            h: 68,
            label: '🌱 新手教学 (渐进式解锁)',
            theme: 'cyan',
            onClick: () => {
              AudioEngine.init();
              AudioEngine.playClick();
              LevelDesigner.loadModeAndLevel('tutorial', 1);
            }
          });

          this.buttons.push({
            id: 'menu_veteran',
            x: W * 0.5 + 20,
            y: 340,
            w: 230,
            h: 68,
            label: '🔥 老手直接开打 (完全体)',
            theme: 'crimson',
            onClick: () => {
              AudioEngine.init();
              AudioEngine.playClick();
              LevelDesigner.loadModeAndLevel('veteran', 5);
            }
          });
        } else if (GameState.phase === 'serve') {
          this.buttons.push({
            id: 'serve_btn',
            x: W * 0.5 - 120,
            y: H - 115,
            w: 240,
            h: 64,
            label: '🏸 点击挥拍发球',
            theme: 'cyan',
            onClick: () => LevelDesigner.handleServe()
          });
        } else if (GameState.phase === 'step') {
          // 仅渲染当前已解锁的 GameState.dirs 步伐按钮（绝不渲染灰色未解锁按钮）
          const unlockedDirs = GameState.dirs;
          const count = unlockedDirs.length;
          const btnW = 148;
          const btnH = 56;
          const gap = 14;
          const totalW = count * btnW + (count - 1) * gap;
          const startX = (W - totalW) * 0.5;

          unlockedDirs.forEach((dirKey, idx) => {
            const d = STEP_DIRS[dirKey];
            if (!d) return;
            const isRecommended = GameState.shuttle.targetDir === dirKey;
            this.buttons.push({
              id: `step_${dirKey}`,
              x: startX + idx * (btnW + gap),
              y: H - 112,
              w: btnW,
              h: btnH,
              label: d.label,
              theme: isRecommended ? 'gold' : 'cyan',
              onClick: () => InteractionQTE.selectStepDirection(dirKey)
            });
          });
        } else if (GameState.phase === 'shot') {
          // Agent 3 布局要求：1个球路绝对居中，2个并排，3-4个田字格排列
          const matchedShots = InteractionQTE.getMatchingUnlockedShots(GameState.player.selectedDir);
          const n = matchedShots.length;
          const panelCenterX = W * 0.5;
          const panelBottomY = H - 105;

          if (n === 1) {
            // 1个球路：绝对居中
            const sName = matchedShots[0];
            this.buttons.push({
              id: `shot_${sName}`,
              x: panelCenterX - 110,
              y: panelBottomY - 30,
              w: 220,
              h: 62,
              label: `🏸 ${sName}`,
              theme: 'cyan',
              onClick: () => InteractionQTE.executeShot(sName)
            });
          } else if (n === 2) {
            // 2个球路：并排排列
            const w = 190, h = 60, gap = 20;
            matchedShots.forEach((sName, i) => {
              this.buttons.push({
                id: `shot_${sName}`,
                x: panelCenterX - w - gap * 0.5 + i * (w + gap),
                y: panelBottomY - 30,
                w,
                h,
                label: `🏸 ${sName}`,
                theme: sName === '重杀' ? 'crimson' : 'cyan',
                onClick: () => InteractionQTE.executeShot(sName)
              });
            });
          } else {
            // 3-4个球路：标准 2x2 田字格排列
            const w = 185, h = 52, gapX = 18, gapY = 12;
            const gridStartX = panelCenterX - w - gapX * 0.5;
            const gridStartY = H - 148;
            matchedShots.forEach((sName, i) => {
              const row = Math.floor(i / 2);
              const col = i % 2;
              // 若共3个且是第3个，放在第二行田字格左格（或居中对齐）
              const bx = gridStartX + col * (w + gapX);
              const by = gridStartY + row * (h + gapY);
              this.buttons.push({
                id: `shot_${sName}`,
                x: bx,
                y: by,
                w,
                h,
                label: `${sName === '重杀' ? '💥' : '🏸'} ${sName}`,
                theme: sName === '重杀' ? 'crimson' : (row === 1 ? 'gold' : 'cyan'),
                onClick: () => InteractionQTE.executeShot(sName)
              });
            });
          }
        } else if (GameState.phase === 'defend') {
          // 快慢刀接杀 QTE：必须点击【上 / 中 / 下】（左/中/右）三个按钮之一
          const tracks = [
            { id: '上', label: '【上 / 左】挡远角' },
            { id: '中', label: '【中】挡追身' },
            { id: '下', label: '【下 / 右】挡近角' }
          ];
          const w = 195, h = 60, gap = 20;
          const startX = W * 0.5 - (w * 3 + gap * 2) * 0.5;
          tracks.forEach((t, idx) => {
            const isTarget = GameState.qte.requiredTrack === t.id;
            this.buttons.push({
              id: `qte_${t.id}`,
              x: startX + idx * (w + gap),
              y: H - 108,
              w,
              h,
              label: t.label,
              theme: isTarget ? 'crimson' : 'cyan',
              onClick: () => InteractionQTE.handleQTEClick(t.id)
            });
          });
        } else if (GameState.phase === 'end') {
          this.buttons.push({
            id: 'end_replay_tutorial',
            x: W * 0.5 - 220,
            y: 430,
            w: 205,
            h: 58,
            label: '↻ 重新开始教学',
            theme: 'cyan',
            onClick: () => {
              AudioEngine.playClick();
              LevelDesigner.loadModeAndLevel('tutorial', 1);
            }
          });
          this.buttons.push({
            id: 'end_go_veteran',
            x: W * 0.5 + 15,
            y: 430,
            w: 205,
            h: 58,
            label: '🔥 进入老手模式',
            theme: 'crimson',
            onClick: () => {
              AudioEngine.playClick();
              LevelDesigner.loadModeAndLevel('veteran', 5);
            }
          });
        }
      },

      handlePointerDown(clientX, clientY, rect) {
        const vp = GameState.viewport;
        if (vp.isPortrait && !vp.bypassPortraitLock) return;

        const lx = (clientX - rect.left - vp.offsetX) / vp.scale;
        const ly = (clientY - rect.top - vp.offsetY) / vp.scale;

        for (let i = this.buttons.length - 1; i >= 0; i--) {
          const b = this.buttons[i];
          if (lx >= b.x && lx <= b.x + b.w && ly >= b.y && ly <= b.y + b.h) {
            b.onClick();
            return true;
          }
        }
        return false;
      },

      render(ctx, W, H, state) {
        // 1. 顶部比分与关卡 HUD
        if (state.phase !== 'menu') {
          this.drawHUD(ctx, W, H, state);
        }

        // 2. 快慢刀接杀 QTE 横条（中间绿色完美区 + 随机变速游标）
        if (state.phase === 'defend' && state.qte.active) {
          this.drawQTEBar(ctx, W, H, state);
        }

        // 3. 菜单或结算界面面板
        if (state.phase === 'menu') {
          this.drawMenuOverlay(ctx, W, H);
        } else if (state.phase === 'end') {
          this.drawEndOverlay(ctx, W, H, state);
        }

        // 4. 过关/评价飘字横幅
        if (state.banner.timer > 0 && state.banner.text) {
          ctx.save();
          ctx.textAlign = 'center';
          ctx.font = 'bold 28px "Inter", sans-serif';
          ctx.fillStyle = state.banner.color;
          ctx.shadowColor = 'rgba(0,0,0,0.9)';
          ctx.shadowBlur = 10;
          ctx.fillText(state.banner.text, W * 0.5, 152);
          if (state.banner.subText) {
            ctx.font = '14px "Inter", sans-serif';
            ctx.fillStyle = '#e2e8f0';
            ctx.fillText(state.banner.subText, W * 0.5, 178);
          }
          ctx.restore();
        }

        // 5. 绘制当前激活按钮
        for (const b of this.buttons) {
          this.drawButton(ctx, b);
        }
      },

      drawHUD(ctx, W, H, state) {
        ctx.fillStyle = 'rgba(7, 11, 20, 0.84)';
        ctx.fillRect(0, 0, W, 68);
        ctx.strokeStyle = 'rgba(0, 240, 255, 0.25)';
        ctx.beginPath();
        ctx.moveTo(0, 68);
        ctx.lineTo(W, 68);
        ctx.stroke();

        ctx.textAlign = 'left';
        ctx.font = 'bold 18px "Inter", sans-serif';
        ctx.fillStyle = '#00f0ff';
        const modeTitle = state.mode === 'tutorial'
          ? TUTORIAL_LEVELS[state.level - 1].title
          : '老手实战模式 · 完全体';
        ctx.fillText(modeTitle, 24, 28);

        ctx.font = '13px "Inter", sans-serif';
        ctx.fillStyle = '#94a3b8';
        ctx.fillText(
          `已点亮步伐: ${state.dirs.join(' ')}   |   已点亮球路: ${state.shots.join(' / ')}   |   体力: ${state.player.stamina}%`,
          24,
          52
        );

        // 中央拍数进度或比分
        ctx.textAlign = 'center';
        ctx.font = 'bold 24px "Inter", sans-serif';
        ctx.fillStyle = '#ffffff';
        if (state.mode === 'tutorial') {
          ctx.fillText(`过关拍数进度:  ${state.rallyCount} / ${state.targetRallies} 拍`, W * 0.5 + 30, 42);
        } else {
          ctx.fillText(`我方  ${state.score.player}  :  ${state.score.ai}  ${state.ai.name}`, W * 0.5 + 30, 42);
        }

        // 状态栏提示
        ctx.fillStyle = 'rgba(15, 23, 42, 0.82)';
        ctx.fillRect(W * 0.5 - 320, 76, 640, 32);
        ctx.strokeStyle = 'rgba(0, 240, 255, 0.35)';
        ctx.strokeRect(W * 0.5 - 320, 76, 640, 32);
        ctx.font = '14px "Inter", sans-serif';
        ctx.fillStyle = '#f1f5f9';
        ctx.fillText(state.statusText, W * 0.5, 97);
      },

      drawQTEBar(ctx, W, H, state) {
        const q = state.qte;
        const barW = 460;
        const barH = 26;
        const bx = (W - barW) * 0.5;
        const by = H - 162;

        // 背景槽
        ctx.fillStyle = 'rgba(15, 23, 42, 0.95)';
        ctx.fillRect(bx, by, barW, barH);
        ctx.strokeStyle = '#ff2a5f';
        ctx.lineWidth = 2;
        ctx.strokeRect(bx, by, barW, barH);

        // 中间绿色完美区
        const gx = bx + barW * q.greenMin;
        const gw = barW * (q.greenMax - q.greenMin);
        ctx.fillStyle = 'rgba(34, 197, 94, 0.78)';
        ctx.fillRect(gx, by + 2, gw, barH - 4);

        // 快慢刀移动光标
        const cx = bx + barW * q.progress;
        ctx.fillStyle = '#ffffff';
        ctx.shadowColor = '#ffb800';
        ctx.shadowBlur = 10;
        ctx.fillRect(cx - 4, by - 6, 8, barH + 12);
        ctx.shadowBlur = 0;

        ctx.textAlign = 'center';
        ctx.font = 'bold 15px "Inter", sans-serif';
        ctx.fillStyle = '#ffb800';
        ctx.fillText(
          `⚡ 快慢刀接杀 QTE (当前刀速 ${(q.speed * 1000).toFixed(1)}) — 光标在【绿色完美区】内点击【${q.requiredTrack}】！`,
          W * 0.5,
          by - 12
        );
      },

      drawMenuOverlay(ctx, W, H) {
        ctx.fillStyle = 'rgba(7, 11, 20, 0.86)';
        ctx.fillRect(W * 0.5 - 370, 120, 740, 360);
        ctx.strokeStyle = 'rgba(0, 240, 255, 0.5)';
        ctx.lineWidth = 2;
        ctx.strokeRect(W * 0.5 - 370, 120, 740, 360);

        ctx.textAlign = 'center';
        ctx.fillStyle = '#00f0ff';
        ctx.font = 'bold 52px "Inter", sans-serif';
        ctx.fillText('羽 刃  FEATHER BLADE', W * 0.5, 205);

        ctx.fillStyle = '#e2e8f0';
        ctx.font = '18px "Inter", sans-serif';
        ctx.fillText('15° 俯视伪 3D 羽毛球 · 渐进式无感教学 & 快慢刀接杀 QTE', W * 0.5, 252);

        ctx.fillStyle = '#94a3b8';
        ctx.font = '14px "Inter", sans-serif';
        ctx.fillText('选择【新手教学】从单步高远球逐关点亮全套武艺，或选择【老手直接开打】体验全招式对抗', W * 0.5, 292);
      },

      drawEndOverlay(ctx, W, H, state) {
        ctx.fillStyle = 'rgba(7, 11, 20, 0.9)';
        ctx.fillRect(W * 0.5 - 320, 170, 640, 350);
        ctx.strokeStyle = '#00f0ff';
        ctx.lineWidth = 2.5;
        ctx.strokeRect(W * 0.5 - 320, 170, 640, 350);

        ctx.textAlign = 'center';
        ctx.fillStyle = '#00f0ff';
        ctx.font = 'bold 38px "Inter", sans-serif';
        const title = state.mode === 'tutorial'
          ? '🏆 教学五关圆满通关！'
          : (state.score.player > state.score.ai ? '🏆 实战获胜！' : '⚔️ 实战惜败');
        ctx.fillText(title, W * 0.5, 255);

        ctx.fillStyle = '#f8fafc';
        ctx.font = '20px "Inter", sans-serif';
        ctx.fillText(
          state.mode === 'tutorial'
            ? '你已掌握全部 6 向步伐、6 大球路与快慢刀接杀 QTE！'
            : `最终比分  ${state.score.player} : ${state.score.ai}`,
          W * 0.5,
          320
        );
      },

      drawButton(ctx, b) {
        ctx.save();
        let bg = 'rgba(0, 240, 255, 0.2)';
        let border = '#00f0ff';
        let textCol = '#ffffff';

        if (b.theme === 'gold') {
          bg = 'rgba(255, 184, 0, 0.26)';
          border = '#ffb800';
          textCol = '#fef08a';
        } else if (b.theme === 'crimson') {
          bg = 'rgba(255, 42, 95, 0.34)';
          border = '#ff2a5f';
          textCol = '#ffffff';
        } else if (b.theme === 'ghost') {
          bg = 'rgba(15, 23, 42, 0.7)';
          border = 'rgba(148, 163, 184, 0.45)';
          textCol = '#cbd5e1';
        }

        const r = 10;
        ctx.beginPath();
        ctx.moveTo(b.x + r, b.y);
        ctx.lineTo(b.x + b.w - r, b.y);
        ctx.quadraticCurveTo(b.x + b.w, b.y, b.x + b.w, b.y + r);
        ctx.lineTo(b.x + b.w, b.y + b.h - r);
        ctx.quadraticCurveTo(b.x + b.w, b.y + b.h, b.x + b.w - r, b.y + b.h);
        ctx.lineTo(b.x + r, b.y + b.h);
        ctx.quadraticCurveTo(b.x, b.y + b.h, b.x, b.y + b.h - r);
        ctx.lineTo(b.x, b.y + r);
        ctx.quadraticCurveTo(b.x, b.y, b.x + r, b.y);
        ctx.closePath();

        ctx.fillStyle = bg;
        ctx.fill();
        ctx.strokeStyle = border;
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.fillStyle = textCol;
        ctx.font = 'bold 15px "Inter", sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(b.label, b.x + b.w * 0.5, b.y + b.h * 0.5);
        ctx.restore();
      }
    };

    // ============================================================================
    // [AGENT 1] 主程序视口管理、横屏遮罩控制与 requestAnimationFrame 主循环
    // ============================================================================
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const orientationOverlay = document.getElementById('orientation-overlay');
    const dismissOrientationBtn = document.getElementById('dismiss-orientation-btn');

    function handleResize() {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = vw * dpr;
      canvas.height = vh * dpr;

      const isPortrait = vh > vw;
      GameState.viewport.isPortrait = isPortrait;
      if (isPortrait && !GameState.viewport.bypassPortraitLock) {
        orientationOverlay.classList.add('active');
      } else {
        orientationOverlay.classList.remove('active');
      }

      const scale = Math.min(vw / LOGICAL_W, vh / LOGICAL_H);
      GameState.viewport.width = vw;
      GameState.viewport.height = vh;
      GameState.viewport.scale = scale;
      GameState.viewport.offsetX = (vw - LOGICAL_W * scale) * 0.5;
      GameState.viewport.offsetY = (vh - LOGICAL_H * scale) * 0.5;
    }

    dismissOrientationBtn.addEventListener('click', () => {
      AudioEngine.init();
      AudioEngine.playClick();
      GameState.viewport.bypassPortraitLock = true;
      orientationOverlay.classList.remove('active');
    });

    canvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      const rect = canvas.getBoundingClientRect();
      UIController.handlePointerDown(e.clientX, e.clientY, rect);
    });

    window.addEventListener('resize', handleResize);

    let lastTimestamp = 0;
    let rafId = null;

    function mainLoop(timestamp) {
      if (!lastTimestamp) lastTimestamp = timestamp;
      const dt = Math.min(0.05, (timestamp - lastTimestamp) / 1000);
      lastTimestamp = timestamp;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const vp = GameState.viewport;

      // 1. 逻辑与物理更新
      if (!vp.isPortrait || vp.bypassPortraitLock) {
        PhysicsEngine.update(dt);
        InteractionQTE.updateQTE(dt);
        LevelDesigner.update(dt);
      }

      // 2. 画面渲染
      ctx.save();
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.fillStyle = '#050811';
      ctx.fillRect(0, 0, vp.width, vp.height);

      ctx.translate(vp.offsetX, vp.offsetY);
      ctx.scale(vp.scale, vp.scale);

      ctx.beginPath();
      ctx.rect(0, 0, LOGICAL_W, LOGICAL_H);
      ctx.clip();

      VisualRenderer.render(ctx, LOGICAL_W, LOGICAL_H, GameState);
      UIController.render(ctx, LOGICAL_W, LOGICAL_H, GameState);

      ctx.restore();

      rafId = window.requestAnimationFrame(mainLoop);
    }

    // 导出全局调试与扩展命名空间
    window.FeatherBlade = {
      GameState,
      TUTORIAL_LEVELS,
      projectCourt: VisualRenderer.projectCourt.bind(VisualRenderer),
      VisualRenderer,
      PhysicsEngine,
      InteractionQTE,
      LevelDesigner,
      UIController
    };

    window.onload = () => {
      UIController.rebuildButtons();
      handleResize();
      if (rafId) window.cancelAnimationFrame(rafId);
      rafId = window.requestAnimationFrame(mainLoop);
    };
  </script>
</body>
