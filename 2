    // ==================== 重心正负零 (+ / - / 0) 状态转换与失衡判定引擎 ====================
    function applyCogSymbolTransition(newSym, shotName) {
      const prevSym = GameState.cogSymbol || '0';
      const cogInfo = getShotCogInfo(shotName);
      GameState.lastRacketActionText = cogInfo.racketAct;

      // 核心规则：如果 '+' 和 '-' 之间没有经过 '0'（即 '+' -> '-' 或 '-' -> '+'），立即判定【重心失衡】！
      if ((prevSym === '+' && newSym === '-') || (prevSym === '-' && newSym === '+')) {
        GameState.cogImbalanced = true;
        GameState.pCog = 25;
        addPlayerPosture(15);
        spawnFloatingText(
          GameState.playerVisual.x,
          GameState.playerVisual.y - 0.09,
          `⚠️ 重心失衡 [${prevSym}]→[${newSym}] 未经[0]! 下拍反应慢0.5秒!`,
          '#f43f5e'
        );
        showCanvasBanner(
          `⚠️ 重心失衡 ([${prevSym}] → [${newSym}] 未经过 [0])!`,
          `高重心[+]与低重心[-]直接切换导致失衡！接下一拍球时反应将比平时慢 0.5 秒！打[0]标准重心球路可恢复！`,
          '#f43f5e'
        );
      } else if (newSym === '0') {
        // 经过 '0' 标准重心，解除重心失衡！
        const wasImbalanced = GameState.cogImbalanced;
        GameState.cogImbalanced = false;
        GameState.pCog = 88;
        if (wasImbalanced) {
          spawnFloatingText(
            GameState.playerVisual.x,
            GameState.playerVisual.y - 0.08,
            `✅ 回归 [0] 标准重心 · 失衡已解除!`,
            '#34d399'
          );
        }
      } else {
        GameState.pCog = newSym === '+' ? 75 : 55;
      }

      GameState.cogSymbol = newSym;
      GameState.cogHistory.push(newSym);
      if (GameState.cogHistory.length > 8) GameState.cogHistory.shift();
    }

    // 根据 AI 来球落点 (targetX, targetY) 计算推荐的八向步伐方向
    function computeRecommendedFootworkDirs(tx, ty) {
      const col = tx < 0.38 ? 'left' : (tx > 0.62 ? 'right' : 'mid');
      const row = ty < 0.67 ? 'front' : (ty > 0.79 ? 'back' : 'mid');
      if (row === 'front') {
        if (col === 'left') return ['ul', 'up'];
        if (col === 'right') return ['ur', 'up'];
        return ['up', 'ul', 'ur'];
      }
      if (row === 'back') {
        if (col === 'left') return ['dl', 'down'];
        if (col === 'right') return ['dr', 'down'];
        return ['down', 'dl', 'dr'];
      }
      // mid court
      if (col === 'left') return ['left', 'ul', 'dl'];
      if (col === 'right') return ['right', 'ur', 'dr'];
      return ['left', 'right', 'up', 'down'];
    }

    // 同步球场中央半透明虚化八向步伐罗盘状态
    function syncCenterFootworkCompass() {
      const dpad = document.getElementById('dPad');
      const header = document.getElementById('sensoryStepHeader');
      if (!dpad) return;
      const btns = dpad.querySelectorAll('.dpad-btn');
      const now = performance.now();
      const isStepPhase = (GameState.phase === 'ai_incoming');
      const isDelayedLocked = isStepPhase && (now < GameState.sensoryLockUntilMs);

      if (isStepPhase) {
        dpad.classList.remove('dpad-ghost-idle');
        dpad.classList.add('dpad-sensory-active');
        if (header) {
          header.classList.remove('hidden');
          if (isDelayedLocked) {
            const remainSec = ((GameState.sensoryLockUntilMs - now) / 1000).toFixed(2);
            header.textContent = `⚠️ 重心失衡硬直中！反应延迟剩余 ${remainSec}s (比平时慢 0.5 秒)...`;
            header.className = 'mb-2 px-3.5 py-1 rounded-full bg-rose-950/95 border border-rose-400 text-xs font-black text-rose-200 shadow-lg animate-pulse';
          } else {
            const inc = GameState.incomingShot;
            header.textContent = `👁️ 感官慢动作镜头 I · 对手打出【${inc ? inc.name : '来球'}】！请点击高亮方向执行步伐：`;
            header.className = 'mb-2 px-3.5 py-1 rounded-full bg-slate-950/90 border border-amber-400/90 text-xs font-black text-amber-200 shadow-lg';
          }
        }
      } else {
        // 非步伐选择阶段：在球场中央保持低透明度虚化状态，不遮挡视野
        dpad.classList.remove('dpad-sensory-active');
        dpad.classList.add('dpad-ghost-idle');
        if (header) header.classList.add('hidden');
      }

      btns.forEach(btn => {
        const dir = btn.dataset.dir;
        const isRec = isStepPhase && (GameState.recommendedDirs || []).includes(dir);
        btn.classList.toggle('recommended-step', isRec);
        btn.classList.toggle('delayed-locked', isDelayedLocked);
      });
    }

    // 玩家在【第一段感官慢动作镜头】中点击八向步伐罗盘某方向后触发：
    // 1. 角色立刻执行该方向的真实骨骼步伐（弓箭步/垫步/滑步/马来步/交叉步）跑向该区域
    // 2. 立即进入【第二段感官慢动作镜头 (phase = 'player_offense')】，仅弹出该步伐强关联的专属球路！
    function handleSensoryFootworkSelect(dirKey) {
      if (GameState.paused || GameState.swingLock || GameState.phase !== 'ai_incoming' || !GameState.incomingShot) return;
      const now = performance.now();

      // 检查是否因上一拍 + 与 - 未经过 0 触发了 0.5 秒重心失衡反应延迟！
      if (now < GameState.sensoryLockUntilMs) {
        const waitSec = ((GameState.sensoryLockUntilMs - now) / 1000).toFixed(2);
        SoundEngine.playHit('miss');
        spawnFloatingText(
          GameState.playerVisual.x,
          GameState.playerVisual.y - 0.06,
          `⏳ 重心失衡反应慢 0.5s! 需再等 ${waitSec}s`,
          '#f43f5e'
        );
        return;
      }

      const fw = FOOTWORK_DIRS[dirKey] || FOOTWORK_DIRS.down;
      const inc = GameState.incomingShot;
      GameState.selectedFootworkDir = dirKey;
      GameState.pHand = fw.hand;
      GameState.pPos = fw.zone;

      // 判断玩家选择的步伐区域是否与 AI 来球落点匹配
      const isRecommended = (GameState.recommendedDirs || []).includes(dirKey);
      const distToBall = Math.hypot(fw.destX - inc.targetX, fw.destY - inc.targetY);

      if (!isRecommended && distToBall > 0.34) {
        // 步伐方向完全选反（例如对手打后场高球却选了网前弓箭步）-> 步伐失位漏球丢分！
        addPlayerPosture(32);
        SoundEngine.playHit('miss');
        SoundEngine.triggerShake('heavy_smash', 'rgba(244, 63, 94, 0.45)');
        startEaseOutMove(GameState.playerVisual, fw.destX, fw.destY, 0.24);
        GameState.playerVisual.vx = fw.vx;
        GameState.playerVisual.vy = fw.vy;
        spawnFloatingText(inc.targetX, inc.targetY - 0.05, `💔 步伐选错方向 (${fw.name}) · 漏球失分!`, '#f43f5e');
        showCanvasBanner(`💔 步伐方向判断失误！`, `对手来球落向${inc.zone === 'front' ? '前场' : (inc.zone === 'back' ? '后场' : '中场')}，你却迈出了【${fw.name}】导致漏球！`, '#f43f5e');
        scorePoint('ai', `步伐判断失误(${fw.name})`);
        return;
      }

      // 步伐正确！角色立即执行对应方向的真实羽毛球骨骼步伐移动到击球点
      const targetX = isRecommended ? inc.targetX : fw.destX;
      const targetY = isRecommended ? inc.targetY : fw.destY;
      GameState.playerVisual.vx = fw.vx;
      GameState.playerVisual.vy = fw.vy;
      startEaseOutMove(GameState.playerVisual, targetX, targetY, 0.22);
      SoundEngine.playShoeSqueak();
      SoundEngine.playJoyFlick();

      const stamCost = hasBoon('hermes') ? 1.5 : 3;
      GameState.pStamina = Math.max(5, GameState.pStamina - stamCost);

      if (isRecommended) {
        GameState.matchStats.perfectParryCount++;
        addAiPosture(12);
        GameState.playerPosture = Math.max(0, GameState.playerPosture - 10);
        syncPostureAlias();
        GameState.counterWindowActive = true;
        spawnImpactRing(targetX, targetY, 'perfect');
        spawnFloatingText(targetX, targetY - 0.05, `👟 完美步伐【${fw.name}】! 进入第二慢动作选球路`, '#fde047');
      } else {
        addPlayerPosture(6);
        spawnFloatingText(targetX, targetY - 0.05, `👟 救球步伐【${fw.name}】! 请选择对应球路`, '#38bdf8');
      }

      // 无缝切入【第二段感官慢动作镜头 · 专属球路抉择 (phase = 'player_offense')】！
      GameState.timeScale = 0.16;
      GameState.timeScaleTimer = 2600; // 给玩家充足的感官慢动作时间选择该步伐对应的球路
      GameState.camZoom = 1.25;
      GameState.camFocus = { x: targetX, y: targetY };
      GameState.camZoomOutElapsedMs = 0;

      GameState.phase = 'player_offense';
      GameState.incomingShot = null;
      updatePlayerGridFromCoords();
      GameState.pPos = fw.zone; // 严格锁定为所选步伐对应的场地位置 (front / mid / back)
      if (getAiOpenCourtInfo()) {
        GameState.matchStats.openCourtOpportunities++;
      }
      syncCenterFootworkCompass();
      updateAllUI();
      renderActionDeck();
    }

