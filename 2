<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="mobile-web-app-capable" content="yes" />
  <title>《羽刃》Featherblade v8.0 — 感官慢动作·步伐球路强关联·+-0重心博弈版</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:ital,wght@0,700;0,900;1,700;1,900&family=Noto+Serif+SC:wght@600;700;900&family=Inter:wght@400;600;700;800;900&family=Noto+Sans+SC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-dark: #1a0b2e;
      --emerald-glow: #10b981;
      --gold-glow: #f59e0b;
      --crimson-glow: #f43f5e;
      --cyan-glow: #06b6d4;
    }
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
      -webkit-touch-callout: none;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100vw;
      height: 100vh;
      height: 100dvh;
       position: fixed;
      inset: 0;
      overflow: hidden;
      background: #0d0618;
      font-family: 'Noto Sans SC', 'Inter', system-ui, sans-serif;
      font-weight: 700;
      color: #fef3c7;
      touch-action: none;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    .hades-panel {
      background: linear-gradient(145deg, rgba(16, 9, 28, 0.92), rgba(7, 4, 14, 0.96));
      border: 2.5px solid #f59e0b;
      box-shadow:
        0 10px 28px rgba(0, 0, 0, 0.85),
        inset 0 0 22px rgba(245, 158, 11, 0.16),
        inset 0 1px 0 rgba(254, 243, 199, 0.28);
      background-image:
        radial-gradient(rgba(245, 158, 11, 0.07) 1px, transparent 0),
        radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 0);
      background-size: 16px 16px;
      background-position: 0 0, 8px 8px;
    }
    @keyframes shake-light {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(-4px, 3px); }
      50% { transform: translate(4px, -3px); }
      75% { transform: translate(-3px, -2px); }
    }
    @keyframes shake-heavy {
      0%, 100% { transform: translate(0, 0) scale(1); }
      20% { transform: translate(-10px, 6px) scale(1.012); }
      40% { transform: translate(10px, -7px) scale(0.99); }
      60% { transform: translate(-7px, -5px) scale(1.006); }
      80% { transform: translate(6px, 5px) scale(0.995); }
    }
    @keyframes shake-extreme {
      0%, 100% { transform: translate(0, 0) rotate(0deg) scale(1); }
      15% { transform: translate(-16px, 11px) rotate(-1.4deg) scale(1.022); }
      35% { transform: translate(15px, -11px) rotate(1.4deg) scale(0.985); }
      55% { transform: translate(-11px, -8px) rotate(-0.8deg) scale(1.012); }
      75% { transform: translate(9px, 7px) rotate(0.6deg) scale(0.994); }
    }
    .shake-light { animation: shake-light 0.14s cubic-bezier(.36,.07,.19,.97); }
    .shake-heavy { animation: shake-heavy 0.22s cubic-bezier(.36,.07,.19,.97); }
    .shake-extreme { animation: shake-extreme 0.32s cubic-bezier(.36,.07,.19,.97); }

    @keyframes pulse-gold {
      0%, 100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.75), inset 0 0 12px rgba(245, 158, 11, 0.4); }
      50% { box-shadow: 0 0 22px 5px rgba(245, 158, 11, 0.98), inset 0 0 18px rgba(245, 158, 11, 0.72); }
    }
    .perfect-glow {
      animation: pulse-gold 0.95s infinite;
    }
    @keyframes gold-flash {
      0% {
        border-color: #ffffff !important;
        box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.95), 0 0 16px 4px rgba(251, 191, 36, 0.95), inset 0 0 18px rgba(255, 255, 255, 0.85);
        filter: brightness(1.45);
      }
      50% {
        border-color: #fde047 !important;
        box-shadow: 0 0 0 8px rgba(251, 191, 36, 0.45), 0 0 28px 10px rgba(255, 255, 255, 0.85), inset 0 0 22px rgba(251, 191, 36, 0.75);
        filter: brightness(1.3);
      }
      100% {
        border-color: #f59e0b !important;
        box-shadow: 0 0 0 14px rgba(251, 191, 36, 0), 0 0 0 0 rgba(255, 255, 255, 0);
        filter: brightness(1);
      }
    }
    .gold-flash {
      animation: gold-flash 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
    }
    .joy-knob-snap {
      transition: transform 0.14s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .joy-knob-dragging {
      transition: transform 0.035s linear;
    }
    .btn-ready {
      border-color: #f59e0b !important;
      box-shadow: 0 0 16px rgba(245, 158, 11, 0.65);
    }
    .custom-scroll::-webkit-scrollbar { width: 5px; height: 5px; }
    .custom-scroll::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.5); }
    .custom-scroll::-webkit-scrollbar-thumb { background: rgba(245, 158, 11, 0.55); border-radius: 9999px; }
    .wx-capsule {
      background: rgba(18, 10, 32, 0.88);
      border: 1.5px solid #f59e0b;
      border-radius: 9999px;
    }
    .glass-card {
      background: linear-gradient(145deg, rgba(18, 9, 32, 0.95), rgba(8, 4, 16, 0.98));
      border: 2.5px solid #f59e0b;
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      box-shadow:
        0 16px 40px rgba(0, 0, 0, 0.92),
        inset 0 0 28px rgba(245, 158, 11, 0.22);
      background-image:
        radial-gradient(rgba(245, 158, 11, 0.08) 1px, transparent 0),
        radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 0);
      background-size: 16px 16px;
      background-position: 0 0, 8px 8px;
    }
    .shot-btn {
      transition: transform 0.08s ease, filter 0.1s ease, opacity 0.12s ease;
      touch-action: none;
      border-width: 2px;
      box-shadow: inset 0 0 14px rgba(245, 158, 11, 0.14), 0 4px 12px rgba(0, 0, 0, 0.65);
    }
    .shot-btn:active:not(:disabled) {
      transform: scale(0.95);
    }
    /* 球场中央虚化八向步伐罗盘 (Center Translucent 8-Way Footwork Compass) */
    .dpad-container {
      width: min(310px, 78vw);
      height: min(230px, 56vh);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(3, 1fr);
      gap: 8px;
      position: relative;
      z-index: 35;
      touch-action: none;
      transition: opacity 0.18s ease, transform 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .dpad-ghost-idle {
      opacity: 0.14;
      transform: scale(0.92);
      pointer-events: none;
    }
    .dpad-sensory-active {
      opacity: 0.96;
      transform: scale(1);
      pointer-events: auto;
    }
    .dpad-btn.recommended-step {
      border-color: #fde047 !important;
      background: linear-gradient(145deg, rgba(245, 158, 11, 0.38), rgba(16, 185, 129, 0.28)) !important;
      box-shadow: 0 0 18px rgba(251, 191, 36, 0.85), inset 0 0 10px rgba(254, 240, 138, 0.45) !important;
    }
    .dpad-btn.delayed-locked {
      opacity: 0.42 !important;
      filter: grayscale(0.8);
      cursor: not-allowed !important;
    }
    .dpad-btn {
      background: linear-gradient(145deg, rgba(24, 12, 42, 0.92), rgba(10, 5, 20, 0.96));
      border: 1.5px solid rgba(245, 158, 11, 0.52);
      border-radius: 7px;
      color: #fbbf24;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      font-size: 13px;
      line-height: 1;
      cursor: pointer;
      transition: all 0.08s ease;
      box-shadow: inset 0 0 8px rgba(245, 158, 11, 0.15), 0 2px 6px rgba(0, 0, 0, 0.65);
    }
    .dpad-btn span.step-tag {
      font-size: 7px;
      color: #fde68a;
      opacity: 0.85;
      margin-top: 1px;
      font-style: normal;
      font-weight: 800;
    }
    .dpad-btn:active, .dpad-btn.active {
      background: rgba(245, 158, 11, 0.36);
      border-color: #fde047;
      color: #ffffff;
      transform: scale(0.91);
      box-shadow: 0 0 14px rgba(245, 158, 11, 0.8), inset 0 0 10px rgba(254, 240, 138, 0.45);
    }
    .dpad-center {
      background: radial-gradient(circle, rgba(245, 158, 11, 0.18) 0%, rgba(15, 23, 42, 0.85) 100%);
      border: 1px dashed rgba(245, 158, 11, 0.45);
      border-radius: 7px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-size: 8px;
      color: #fef08a;
      text-align: center;
      line-height: 1.05;
      pointer-events: none;
    }
  </style>
</head>
<body class="select-none">
  <div id="gameRoot" class="w-full h-full flex flex-col justify-between overflow-hidden relative">

    <!-- Subtle Screen Flash Overlay (Pointer-events-none) -->
    <div id="screenFlash" class="pointer-events-none fixed inset-0 z-40 opacity-0 transition-opacity duration-150"></div>

    <!-- H5 Mobile Portrait Orientation Lock Overlay -->
    <div id="portraitOverlay" class="fixed inset-0 z-[60] bg-slate-950/95 backdrop-blur-lg hidden flex-col items-center justify-center p-6 text-center">
      <div class="text-5xl mb-3 animate-bounce">🔄</div>
      <div class="text-lg sm:text-xl font-black text-amber-300 tracking-wider">🔄 请将手机横屏以获得最佳体验</div>
      <p class="text-xs text-slate-300 mt-2 max-w-xs">《羽刃》采用宽屏 2.5D 赛场透视与双手电竞操控，横屏握持视野更开阔、微操更精准。</p>
      <button id="btnDismissPortrait" type="button" class="mt-4 px-4 py-1.5 rounded-xl bg-slate-800/90 hover:bg-slate-700 text-amber-200 border border-amber-500/40 text-xs font-bold">
        ▶️ 继续当前窗口体验
      </button>
    </div>

    <!-- ================= MODULE 1: INTEGRATED TOP HUD (v6.0 + v5.5 FUSION) ================= -->
    <header class="w-full hades-panel border-b-2 border-amber-500 z-30 shrink-0 flex flex-col">
      <!-- Top Row: Stage Info, 4D Attributes & Tactical Controls -->
      <div class="w-full h-9 px-2.5 flex items-center justify-between border-b border-slate-900">
        <div class="flex items-center gap-1.5 min-w-0">
          <div class="flex items-center gap-1 bg-emerald-500/15 border border-emerald-400/40 rounded-md px-2 py-0.5">
            <span class="text-sm leading-none">🏸</span>
            <span class="font-black tracking-tight text-xs bg-gradient-to-r from-emerald-300 via-cyan-200 to-amber-200 bg-clip-text text-transparent">羽刃 v7.0·骨骼IK</span>
          </div>
          <span id="headerChapterBadge" class="px-2 py-0.5 rounded text-[11px] font-bold bg-amber-500/20 text-amber-300 border border-amber-400/30 truncate">
            第1章 1-1 · 校队新人·小林
          </span>
          <!-- 4D Attributes Pill (Power, Control, Sense) -->
          <div id="headerAttrsPill" class="hidden sm:flex items-center gap-1.5 px-2 py-0.5 rounded bg-slate-900 border border-slate-700 text-[10px] font-bold">
            <span class="text-rose-300" id="attrPowerText">💪力量:45</span>
            <span class="text-cyan-300" id="attrControlText">🎯控球:40</span>
            <span class="text-purple-300" id="attrSenseText">🪶球感:40</span>
          </div>
          <button id="btnSkipTutorial" type="button" class="px-2 py-0.5 rounded bg-emerald-900/70 hover:bg-emerald-800 text-[10px] font-bold text-emerald-200 border border-emerald-400/40 transition">
            跳过引导
          </button>
        </div>

        <div class="flex items-center gap-1">
          <button id="btnOpenMap" type="button" class="px-2 py-0.5 rounded text-[11px] font-bold bg-slate-800 hover:bg-slate-700 text-sky-300 border border-sky-500/30 flex items-center gap-1">
            <span>🗺️</span><span class="hidden sm:inline">闯关地图</span>
          </button>
          <button id="btnOpenIntel" type="button" class="px-2 py-0.5 rounded text-[11px] font-bold bg-slate-800 hover:bg-slate-700 text-purple-300 border border-purple-500/30 flex items-center gap-1">
            <span>📋</span><span class="hidden sm:inline">Boss情报</span>
          </button>
          <button id="btnCycleVenue" type="button" class="px-2 py-0.5 rounded text-[11px] font-bold bg-slate-800 hover:bg-slate-700 text-emerald-300 border border-emerald-500/30 hidden md:flex items-center gap-1">
            <span>🏟️</span><span id="venueNameLabel">大师赛馆</span>
          </button>
          <button id="btnCycleDiff" type="button" class="px-2 py-0.5 rounded text-[11px] font-bold bg-emerald-950 hover:bg-emerald-900 text-emerald-300 border border-emerald-500/40 flex items-center gap-1">
            <span>🛡️</span><span id="diffLabel">新手保护</span>
          </button>
        </div>

        <div class="flex items-center gap-1">
          <button id="btnToggleBgm" type="button" class="px-2 py-0.5 rounded text-[11px] font-bold bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-slate-700">
            🎵 音乐:开
          </button>
          <button id="btnFullscreen" type="button" class="px-2 py-0.5 rounded text-[11px] font-bold bg-amber-500/25 hover:bg-amber-500/40 text-amber-200 border border-amber-400/60" title="进入或退出全屏模式">
            ⛶ 全屏
          </button>
          <button id="btnToggleQuality" type="button" class="px-2 py-0.5 rounded text-[11px] font-bold bg-slate-800 hover:bg-slate-700 text-emerald-300 border border-emerald-500/40" title="切换高画质与流畅模式">
            ✨ 画质:高
          </button>
          <button id="btnToggleVib" type="button" class="px-2 py-0.5 rounded text-[11px] font-bold bg-slate-800 hover:bg-slate-700 text-rose-300 border border-slate-700 hidden sm:inline-flex">
            📳 震感:强烈
          </button>
          <button id="btnPause" type="button" class="px-2 py-0.5 rounded text-[11px] font-bold bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40">
            ⏸ 暂停
          </button>
          <div class="wx-capsule h-6 px-2 flex items-center gap-1.5 text-xs text-slate-200">
            <button id="btnWxMore" type="button" class="hover:text-white font-bold leading-none" title="战术说明">•••</button>
            <span class="w-px h-3 bg-slate-600"></span>
            <button id="btnWxRestartQuick" type="button" class="hover:text-rose-400 leading-none" title="重开本局">◎</button>
          </div>
        </div>
      </div>

      <!-- Second Row: Integrated Live Combat HUD Strip (Player vs Tactical Combo Chain & Score vs Boss) -->
      <div class="w-full px-2.5 py-1 grid grid-cols-12 items-center gap-2 bg-slate-900/90">
        <!-- Player Integrated Status (4 cols) -->
        <div class="col-span-4 flex flex-col gap-0.5">
          <div class="flex items-center justify-between text-[11px]">
            <div class="flex items-center gap-1 min-w-0">
              <span class="font-black text-emerald-300 truncate" id="scorePlayerTag">我方·苏羽</span>
              <button id="btnSwitchHero" type="button" class="text-[9px] px-1 rounded bg-slate-800 text-cyan-300 border border-cyan-500/30">换角</button>
              <span id="playerPosBadge" class="text-[10px] font-extrabold text-cyan-300">📍后中(7)</span>
            </div>
            <div class="flex items-center gap-1 text-[10px] shrink-0">
              <span id="hudCogLive" class="px-1 rounded bg-emerald-500/20 text-emerald-300 font-bold">⚖️重心85</span>
              <span id="hudFocusMini" class="text-purple-300 font-bold hidden sm:inline">👁️90</span>
              <span id="hudComboMini" class="px-1 rounded bg-amber-500/20 text-amber-300 font-black">×1.0</span>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-1.5">
            <div class="flex items-center gap-1">
              <span class="text-[9px] text-emerald-300 font-bold shrink-0">⚡体</span>
              <div class="flex-1 h-2 bg-slate-800 rounded-full overflow-hidden border border-slate-700">
                <div id="hudPStamBar" class="h-full bg-gradient-to-r from-emerald-500 to-teal-300 transition-all duration-100" style="width:100%"></div>
              </div>
              <span id="hudPStamText" class="text-[9px] font-mono text-emerald-300 w-6 text-right">100</span>
            </div>
            <div class="flex items-center gap-1">
              <span class="text-[9px] text-cyan-300 font-bold shrink-0">🛡️破绽</span>
              <div class="flex-1 h-2 bg-slate-800 rounded-full overflow-hidden border border-slate-700">
                <div id="hudPPosBar" class="h-full bg-gradient-to-r from-amber-500 via-orange-500 to-rose-600 transition-all duration-100" style="width:0%"></div>
              </div>
              <span id="hudPPosText" class="text-[9px] font-mono text-amber-300 w-8 text-right">0%</span>
            </div>
          </div>
        </div>

        <!-- Center Score & 3-Shot Tactical Chain (4 cols) -->
        <div class="col-span-4 flex flex-col items-center justify-center">
          <div class="flex items-center gap-2.5">
            <span id="serveIconPlayer" class="text-xs" title="我方发球权">🏸</span>
            <span id="scorePlayerNum" class="text-xl sm:text-2xl font-black text-white font-mono leading-none">0</span>
            <div class="flex flex-col items-center">
              <span id="matchRuleBadge" class="px-1.5 py-0.2 rounded-full text-[9px] font-extrabold bg-slate-800 text-amber-300 border border-amber-400/30">
                7分制
              </span>
              <span id="rallyCountText" class="text-[9px] text-slate-400">第 0 拍</span>
            </div>
            <span id="scoreAiNum" class="text-xl sm:text-2xl font-black text-rose-400 font-mono leading-none">0</span>
            <span id="serveIconAi" class="text-xs hidden" title="对手发球权">🏸</span>
          </div>
          <!-- Live 3-Shot Tactical Combo Chain Strip & Featherblade Boons Build -->
          <div id="tacticalChainStrip" class="text-[10px] font-extrabold text-amber-300 truncate max-w-full mt-0.5">
            🔗 战术树：高远→吊球→杀球 / 高远→放网→扑推
          </div>
          <div id="activeBoonsBar" class="flex items-center justify-center gap-1 flex-wrap max-w-full mt-0.5 text-[9px] text-amber-200">
            <span class="px-1.5 py-0.2 rounded bg-amber-950/80 border border-amber-500/50 text-amber-300">🃏 战术流派: 暂无 (每得2分或胜场三选一)</span>
          </div>
        </div>

        <!-- Opponent Integrated Status (4 cols) -->
        <div class="col-span-4 flex flex-col gap-0.5">
          <div class="flex items-center justify-between text-[11px]">
            <div class="flex items-center gap-1 text-[10px]">
              <span id="hudAiImmMini" class="text-amber-300 font-bold truncate">🚫免疫:无</span>
              <button id="btnHawkEye" type="button" class="px-1 rounded bg-sky-500/20 text-sky-300 border border-sky-400/30 font-bold text-[9px]">
                🦅 鹰眼 ×<span id="hawkEyeCount">2</span>
              </button>
            </div>
            <span class="font-black text-rose-300 truncate" id="scoreAiTag">小林</span>
          </div>
          <div class="grid grid-cols-2 gap-1.5">
            <div class="flex items-center gap-1">
              <span class="text-[9px] text-rose-300 font-bold shrink-0">💥破绽</span>
              <div class="flex-1 h-2 bg-slate-800 rounded-full overflow-hidden border border-rose-500/30">
                <div id="hudAiPosBar" class="h-full bg-gradient-to-r from-amber-400 via-orange-500 to-red-600 transition-all duration-100" style="width:0%"></div>
              </div>
              <span id="hudAiPosText" class="text-[9px] font-mono text-rose-300 w-8 text-right">0%</span>
            </div>
            <div class="flex items-center gap-1">
              <span class="text-[9px] text-emerald-300 font-bold shrink-0">⚡体</span>
              <div class="flex-1 h-2 bg-slate-800 rounded-full overflow-hidden border border-slate-700">
                <div id="hudAiStamBar" class="h-full bg-gradient-to-r from-emerald-500 to-lime-400 transition-all duration-100" style="width:100%"></div>
              </div>
              <span id="hudAiStamText" class="text-[9px] font-mono text-emerald-300 w-6 text-right">100</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- ================= CENTER 2.5D COURT CANVAS + TRANSLUCENT 8-WAY FOOTWORK COMPASS ================= -->
    <main class="flex-1 min-h-0 w-full relative bg-transparent overflow-hidden flex items-center justify-center">
      <div id="canvasContainer" class="w-full h-full relative flex items-center justify-center overflow-hidden">
        <canvas id="courtCanvas" class="w-full h-full block"></canvas>

        <!-- 【核心创新】：球场中央虚化八点步伐罗盘（在感官慢动作镜头 I 瞬间浮现供玩家点击选择步伐） -->
        <div id="centerFootworkOverlay" class="pointer-events-none absolute inset-0 z-30 flex flex-col items-center justify-center p-2">
          <div id="sensoryStepHeader" class="hidden mb-2 px-3.5 py-1 rounded-full bg-slate-950/90 border border-amber-400/80 text-xs font-black text-amber-200 shadow-lg">
            👁️ 感官慢动作 I · 请点击对应方位执行【接球步伐】
