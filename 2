      playMetalPing(mode = 'normal') {
        this.init();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;

        if (mode === 'parry') {
          const bufLen = Math.floor(this.ctx.sampleRate * 0.03);
          const buf = this.ctx.createBuffer(1, bufLen, this.ctx.sampleRate);
          const data = buf.getChannelData(0);
          for (let i = 0; i < bufLen; i++) {
            data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufLen * 0.3));
          }
          const noise = this.ctx.createBufferSource();
          noise.buffer = buf;
          const bp = this.ctx.createBiquadFilter();
          bp.type = 'bandpass';
          bp.frequency.setValueAtTime(3900, now);
          const nGain = this.ctx.createGain();
          nGain.gain.setValueAtTime(0.35, now);
          nGain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);
          noise.connect(bp);
          bp.connect(nGain);
          nGain.connect(this.ctx.destination);
          noise.onended = () => { try { noise.disconnect(); } catch (e) {} };
          noise.start(now);

          [1760, 2637, 3951].forEach((freq, idx) => {
            const osc = this.ctx.createOscillator();
            const g = this.ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, now);
            osc.frequency.exponentialRampToValueAtTime(freq * 1.04, now + 0.24);
            g.gain.setValueAtTime(0.24 / (idx + 1), now);
            g.gain.exponentialRampToValueAtTime(0.0008, now + 0.24);
            osc.connect(g);
            g.connect(this.ctx.destination);
            osc.onended = () => { try { osc.disconnect(); g.disconnect(); } catch (e) {} };
            osc.start(now);
            osc.stop(now + 0.25);
          });
        } else if (mode === 'smash') {
          const osc = this.ctx.createOscillator();
          const g = this.ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(360, now);
          osc.frequency.exponentialRampToValueAtTime(62, now + 0.18);
          g.gain.setValueAtTime(0.28, now);
          g.gain.exponentialRampToValueAtTime(0.001, now + 0.19);
          osc.connect(g);
          g.connect(this.ctx.destination);
          osc.onended = () => { try { osc.disconnect(); g.disconnect(); } catch (e) {} };
          osc.start(now);
          osc.stop(now + 0.2);
        } else {
          const osc = this.ctx.createOscillator();
          const g = this.ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(1180, now);
          osc.frequency.exponentialRampToValueAtTime(420, now + 0.08);
          g.gain.setValueAtTime(0.20, now);
          g.gain.exponentialRampToValueAtTime(0.001, now + 0.085);
          osc.connect(g);
          g.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + 0.09);
        }
