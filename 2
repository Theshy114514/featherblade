      // Hidden compatibility handlers
      document.getElementById('btnOpenEquip').addEventListener('click', openIntelModal);
      document.getElementById('btnCloseEquip').addEventListener('click', () => { document.getElementById('modalEquip').classList.add('hidden'); });
      document.getElementById('btnToggleLeftDrawer').addEventListener('click', openIntelModal);
      document.getElementById('btnToggleRightDrawer').addEventListener('click', openIntelModal);
      document.getElementById('btnSkillSeeThrough').addEventListener('click', () => { GameState.pFocus = Math.max(0, GameState.pFocus - 30); });
      document.getElementById('btnSkillBreathe').addEventListener('click', () => { GameState.pStamina = GameState.pStaminaMax; });
      document.getElementById('btnToggleCharge').addEventListener('click', () => { SoundEngine.playHit('normal'); });
      document.querySelectorAll('.aim-cell-btn').forEach(btn => {
        btn.addEventListener('click', () => { SoundEngine.playHit('normal'); });
      });
      document.querySelectorAll('.bet-btn').forEach(btn => {
        btn.addEventListener('click', () => { SoundEngine.playHit('normal'); });
      });

      document.getElementById('btnHawkEye').addEventListener('click', () => {
        if (GameState.hawkEyeLeft <= 0) return;
        const success = Math.random() < 0.65;
        SoundEngine.playHit('perfect');
        if (success) {
          addAiPosture(22);
          showCanvasBanner('🦅 鹰眼挑战成功 IN!', '敌方破绽 +22 · 次数返还', '#38bdf8');
          checkAiPostureBreak();
        } else {
          GameState.hawkEyeLeft--;
          showCanvasBanner('🦅 鹰眼挑战失败 OUT', '球体微弱出界 · 次数 -1', '#94a3b8');
        }
        updateAllUI();
      });

      document.getElementById('btnOpenMap').addEventListener('click', openMapModal);
      document.getElementById('btnCloseMap').addEventListener('click', () => {
        document.getElementById('modalMap').classList.add('hidden');
        document.getElementById('modalMap').classList.remove('flex');
        GameState.paused = false;
      });

      document.getElementById('btnOpenIntel').addEventListener('click', openIntelModal);
      document.getElementById('btnCloseIntel').addEventListener('click', () => {
        document.getElementById('modalIntel').classList.add('hidden');
        document.getElementById('modalIntel').classList.remove('flex');
        GameState.paused = false;
      });

      document.getElementById('btnCycleVenue').addEventListener('click', () => {
        GameState.venueIdx = (GameState.venueIdx + 1) % VENUES.length;
        document.getElementById('venueNameLabel').textContent = VENUES[GameState.venueIdx].name;
      });

      document.getElementById('btnCycleDiff').addEventListener('click', () => {
        const order = ['novice', 'standard', 'hardcore'];
        const names = { novice: '新手保护', standard: '标准竞技', hardcore: '硬核全QTE' };
        const next = order[(order.indexOf(GameState.difficulty) + 1) % order.length];
        GameState.difficulty = next;
        document.getElementById('diffLabel').textContent = names[next];
      });

      document.getElementById('btnSwitchHero').addEventListener('click', () => {
        GameState.heroIdx = (GameState.heroIdx + 1) % HEROES.length;
        updateAllUI();
      });

      document.getElementById('btnToggleBgm').addEventListener('click', (e) => {
        SoundEngine.bgmEnabled = !SoundEngine.bgmEnabled;
        e.currentTarget.textContent = SoundEngine.bgmEnabled ? '🎵 音乐:开' : '🔇 音乐:关';
        if (SoundEngine.bgmEnabled) SoundEngine.startBgm();
      });

      document.getElementById('btnToggleVib').addEventListener('click', (e) => {
        SoundEngine.vibMode = (SoundEngine.vibMode + 1) % 3;
        const labels = ['📴 震感:关', '📳 震感:标准', '📳 震感:强烈'];
        e.currentTarget.textContent = labels[SoundEngine.vibMode];
      });

      document.getElementById('btnPause').addEventListener('click', openPauseModal);
      document.getElementById('btnWxMore').addEventListener('click', openIntelModal);
      document.getElementById('btnWxRestartQuick').addEventListener('click', () => initStage(GameState.stageIdx));
      document.getElementById('btnQuickRestartNode').addEventListener('click', () => initStage(GameState.stageIdx));

      window.addEventListener('keydown', (e) => {
        GameState.keysDown[e.code] = true;
        if (GameState.paused) return;
        const deckBtns = document.getElementById('actionDeckContainer').querySelectorAll('button');
        if (e.key === '1' || e.key.toLowerCase() === 'j') { if (deckBtns[0]) deckBtns[0].click(); }
        else if (e.key === '2' || e.key.toLowerCase() === 'k') { if (deckBtns[1]) deckBtns[1].click(); }
        else if (e.key === '3' || e.key.toLowerCase() === 'l') { if (deckBtns[2]) deckBtns[2].click(); }
        else if (e.key === '4' || e.key.toLowerCase() === 'u') { if (deckBtns[3]) deckBtns[3].click(); }
        else if (e.code === 'Space') {
          e.preventDefault();
          if (GameState.phase === 'break_finisher') {
            executeBreakFinisher({ name: '🩸 制胜扣杀·赛场断头扣杀' });
          } else if (deckBtns[0]) {
            deckBtns[0].click();
          }
        }
      });
      window.addEventListener('keyup', (e) => {
        GameState.keysDown[e.code] = false;
      });

      // 手动画质切换按钮（高画质 / 流畅模式）
      const btnQuality = document.getElementById('btnToggleQuality');
      if (btnQuality) {
        btnQuality.textContent = GameState.qualityMode === 'high' ? '✨ 画质:高' : '⚡ 画质:流畅';
        btnQuality.addEventListener('click', () => {
          const nextMode = GameState.qualityMode === 'high' ? 'smooth' : 'high';
          setQualityMode(nextMode, false);
        });
      }

      // 全屏切换引擎：支持顶部【⛶ 全屏】按钮随时切换 + 兼容浏览器拦截时的沉浸式全窗口回退
      const btnFullscreen = document.getElementById('btnFullscreen');
      function updateFullscreenBtnUI() {
        const isFs = !!(document.fullscreenElement || document.webkitFullscreenElement || document.body.classList.contains('pseudo-fullscreen'));
        if (btnFullscreen) {
          btnFullscreen.textContent = isFs ? '🗗 退出全屏' : '⛶ 全屏';
        }
        setTimeout(resizeCanvas, 60);
      }

      function toggleGameFullscreen() {
        const docEl = document.documentElement;
        const isNativeFs = !!(document.fullscreenElement || document.webkitFullscreenElement);
        if (isNativeFs) {
          if (document.exitFullscreen) document.exitFullscreen().catch(() => {});
          else if (document.webkitExitFullscreen) { try { document.webkitExitFullscreen(); } catch (e) {} }
          document.body.classList.remove('pseudo-fullscreen');
          updateFullscreenBtnUI();
          return;
        }
        if (document.body.classList.contains('pseudo-fullscreen')) {
          document.body.classList.remove('pseudo-fullscreen');
          updateFullscreenBtnUI();
          return;
        }
        if (docEl.requestFullscreen) {
          docEl.requestFullscreen().then(() => {
            updateFullscreenBtnUI();
          }).catch(() => {
            // 若处于 iframe 或浏览器限制原生全屏，启用 100dvh 沉浸式全屏铺满并提示
            document.body.classList.add('pseudo-fullscreen');
            window.scrollTo(0, 1);
            resizeCanvas();
            updateFullscreenBtnUI();
            showCanvasBanner('⛶ 已开启沉浸式铺满模式', '当前窗口已 100% 铺满可视区域', '#fbbf24');
          });
        } else if (docEl.webkitRequestFullscreen) {
          try {
            docEl.webkitRequestFullscreen();
            updateFullscreenBtnUI();
          } catch (e) {
            document.body.classList.add('pseudo-fullscreen');
            resizeCanvas();
            updateFullscreenBtnUI();
          }
        } else {
          document.body.classList.add('pseudo-fullscreen');
          resizeCanvas();
          updateFullscreenBtnUI();
        }
      }

      if (btnFullscreen) {
        btnFullscreen.addEventListener('click', toggleGameFullscreen);
      }
      document.addEventListener('fullscreenchange', updateFullscreenBtnUI);
      document.addEventListener('webkitfullscreenchange', updateFullscreenBtnUI);

      // 阻止移动端双击放大
      let lastTouchEnd = 0;
      document.addEventListener('touchend', (e) => {
        const nowT = Date.now();
        if (nowT - lastTouchEnd <= 300) {
          e.preventDefault();
        }
        lastTouchEnd = nowT;
      }, { passive: false });

      // 横竖屏检测：当 window.innerHeight > window.innerWidth 时显示横屏提示遮罩并暂停游戏
      const btnDismissPortrait = document.getElementById('btnDismissPortrait');
      if (btnDismissPortrait) {
        btnDismissPortrait.addEventListener('click', () => {
          GameState.portraitDismissed = true;
          const pOverlay = document.getElementById('portraitOverlay');
          if (pOverlay) {
            pOverlay.classList.add('hidden');
            pOverlay.classList.remove('flex');
          }
          if (GameState.pausedByOrientation) {
            GameState.pausedByOrientation = false;
            GameState.paused = false;
          }
        });
      }

      function checkOrientation() {
        resizeCanvas();
        const pOverlay = document.getElementById('portraitOverlay');
        if (!pOverlay) return;
        const isPortrait = window.innerHeight > window.innerWidth;
        if (isPortrait && !GameState.portraitDismissed) {
          pOverlay.classList.remove('hidden');
          pOverlay.classList.add('flex');
          if (!GameState.paused) {
            GameState.paused = true;
            GameState.pausedByOrientation = true;
          }
        } else {
          pOverlay.classList.add('hidden');
          pOverlay.classList.remove('flex');
          if (GameState.pausedByOrientation) {
            GameState.pausedByOrientation = false;
            const modalMapOpen = !document.getElementById('modalMap').classList.contains('hidden');
            const modalIntelOpen = !document.getElementById('modalIntel').classList.contains('hidden');
            const modalOverlayOpen = !document.getElementById('modalOverlay').classList.contains('hidden');
            if (!modalMapOpen && !modalIntelOpen && !modalOverlayOpen) {
              GameState.paused = false;
            }
          }
        }
      }

      window.addEventListener('resize', checkOrientation);
      window.addEventListener('orientationchange', checkOrientation);
      checkOrientation();
    }

    function setQualityMode(mode, isAuto = false) {
      GameState.qualityMode = mode === 'smooth' ? 'smooth' : 'high';
      GameState.fpsMonitor.lowFpsSec = 0;
      const btnQuality = document.getElementById('btnToggleQuality');
      if (btnQuality) {
        btnQuality.textContent = GameState.qualityMode === 'high' ? '✨ 画质:高' : '⚡ 画质:流畅';
        btnQuality.className = GameState.qualityMode === 'high'
          ? 'px-2 py-0.5 rounded text-[11px] font-bold bg-slate-800 hover:bg-slate-700 text-emerald-300 border border-emerald-500/40'
          : 'px-2 py-0.5 rounded text-[11px] font-bold bg-amber-950/90 hover:bg-amber-900 text-amber-300 border border-amber-500/40';
      }
      if (GameState.qualityMode === 'smooth') {
        while (GameState.trailParticles.length > 20) GameState.trailParticles.shift();
        while (GameState.particles.length > 20) GameState.particles.shift();
      }
      if (isAuto) {
        showCanvasBanner('⚡ 已自动切换至【流畅模式】', '检测到连续3秒帧率低于50FPS，已关闭动态模糊与发光阴影保障丝滑帧率', '#38bdf8');
      } else {
        showCanvasBanner(
          GameState.qualityMode === 'high' ? '✨ 已切换至【高画质模式】' : '⚡ 已切换至【流畅模式】',
          GameState.qualityMode === 'high' ? '已开启杀球压迫动态模糊、轨迹发光阴影与60上限粒子池' : '已关闭动态模糊与轨迹发光阴影，粒子上限降至20',
          '#10b981'
        );
      }
    }

    window.addEventListener('load', () => {
      loadSaveData();
      bindAllControls();
      resizeCanvas();
      initStage(0);
      lastFrameTime = performance.now();
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(renderCourtLoop);
    });
  </script>
</body>
