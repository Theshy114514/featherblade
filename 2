            GameState.paused = false;
            showCanvasBanner(`🏛️ 获得战术流派 ${boon.name}!`, boon.desc, boon.color);
          }
        });
        choicesBox.appendChild(btn);
      });

      document.getElementById('overlayButtons').innerHTML = '';
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    // 生成战报海报并触发下载 / 预览 / 微信或系统分享
    function generateAndShareBattleReport(isWin, st, openRate) {
      const posterCanvas = document.createElement('canvas');
      const pw = 720;
      const ph = 960;
      posterCanvas.width = pw;
      posterCanvas.height = ph;
      const pctx = posterCanvas.getContext('2d');

      // 1. 暗金紫黑渐变底图
      const bg = pctx.createLinearGradient(0, 0, 0, ph);
      bg.addColorStop(0, '#1a0b2e');
      bg.addColorStop(0.55, '#0d0518');
      bg.addColorStop(1, '#05020a');
      pctx.fillStyle = bg;
      pctx.fillRect(0, 0, pw, ph);

      // 赛场聚光灯放射性光芒
      const rad = pctx.createRadialGradient(pw * 0.5, 220, 20, pw * 0.5, 260, 420);
      rad.addColorStop(0, isWin ? 'rgba(245, 158, 11, 0.35)' : 'rgba(244, 63, 94, 0.28)');
      rad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      pctx.fillStyle = rad;
      pctx.fillRect(0, 0, pw, ph);

      // 暗金双层边框
      pctx.strokeStyle = '#f59e0b';
      pctx.lineWidth = 6;
      pctx.strokeRect(24, 24, pw - 48, ph - 48);
      pctx.strokeStyle = 'rgba(254, 243, 199, 0.35)';
      pctx.lineWidth = 2;
      pctx.strokeRect(36, 36, pw - 72, ph - 72);

      // 顶部游戏标题与徽章
      pctx.textAlign = 'center';
      pctx.fillStyle = '#fef08a';
      pctx.font = 'italic 900 28px "Cinzel", "Noto Serif SC", serif';
      pctx.fillText('🏸 《羽刃》FEATHERBLADE v6.0', pw * 0.5, 92);

      pctx.fillStyle = isWin ? '#fbbf24' : '#f43f5e';
      pctx.font = 'italic 900 54px "Cinzel", "Noto Serif SC", serif';
      pctx.fillText(isWin ? 'VICTORY · 战报' : 'MATCH REPORT', pw * 0.5, 165);

      // 对手与章节信息
      pctx.fillStyle = '#ffffff';
      pctx.font = '900 30px "Noto Serif SC", sans-serif';
      const actionVerb = isWin ? '成功击败' : '鏖战惜败';
      pctx.fillText(`第${st.chapter}章 ${st.nodeInChap} · ${actionVerb}【${st.name}】`, pw * 0.5, 230);

      // 巨大比分牌
      pctx.fillStyle = 'rgba(15, 23, 42, 0.85)';
      pctx.strokeStyle = '#f59e0b';
      pctx.lineWidth = 3;
      pctx.beginPath();
      pctx.roundRect(140, 265, pw - 280, 145, 20);
      pctx.fill();
      pctx.stroke();

      const hero = getCurrentHero();
      pctx.fillStyle = '#6ee7b7';
      pctx.font = '800 22px "Noto Sans SC", sans-serif';
      pctx.fillText(`我方 · ${hero.name}`, 235, 312);
      pctx.fillStyle = '#fda4af';
      pctx.fillText(`对手 · ${st.name}`, pw - 235, 312);

      pctx.fillStyle = '#ffffff';
      pctx.font = '900 68px monospace';
      pctx.fillText(`${GameState.playerScore}  :  ${GameState.aiScore}`, pw * 0.5, 382);

      // 核心战术复盘数据四宫格
      const stats = [
        { label: '⚔️ 完美弹反次数', val: `${GameState.matchStats.perfectParryCount} 次`, col: '#fde047' },
        { label: '🔥 最高连击纪录', val: `${GameState.maxCombo} 连击`, col: '#38bdf8' },
        { label: '🎯 空当抓取成功率', val: `${openRate}%`, col: '#34d399' },
        { label: '💪 四维战力评级', val: `力${GameState.attrs.power}/控${GameState.attrs.control}/感${GameState.attrs.sense}`, col: '#f472b6' }
      ];

      stats.forEach((item, idx) => {
        const colIdx = idx % 2;
        const rowIdx = Math.floor(idx / 2);
        const bx = 76 + colIdx * 294;
        const by = 445 + rowIdx * 135;
        pctx.fillStyle = 'rgba(24, 13, 42, 0.92)';
        pctx.strokeStyle = 'rgba(245, 158, 11, 0.55)';
        pctx.lineWidth = 2;
        pctx.beginPath();
        pctx.roundRect(bx, by, 274, 115, 16);
        pctx.fill();
        pctx.stroke();

        pctx.fillStyle = '#cbd5e1';
        pctx.font = '700 20px "Noto Sans SC", sans-serif';
        pctx.fillText(item.label, bx + 137, by + 42);

        pctx.fillStyle = item.col;
        pctx.font = '900 32px "Noto Sans SC", monospace';
        pctx.fillText(item.val, bx + 137, by + 88);
      });

      // 已激活战术流派标签
      const boonNames = GameState.boons.length
        ? [...new Set(GameState.boons)].map(id => (TACTICAL_CARDS.find(b => b.id === id) || {}).name).join(' · ')
        : '基础竞技流派';
      pctx.fillStyle = '#fde68a';
      pctx.font = '700 20px "Noto Serif SC", sans-serif';
      pctx.fillText(`🏛️ 战术流派构筑：${boonNames}`, pw * 0.5, 765);

      // 底部分享宣言小字（严格遵循用户要求格式）
      const shareUrl = (window.location && window.location.href && !window.location.href.startsWith('about:'))
        ? window.location.href.split('?')[0]
        : 'https://featherblade.game';
      const shareText = `我在《羽刃》中击败了${st.name}，快来挑战我！—— ${shareUrl}`;

      pctx.fillStyle = 'rgba(15, 23, 42, 0.9)';
      pctx.fillRect(42, ph - 135, pw - 84, 88);
      pctx.fillStyle = '#fef3c7';
      pctx.font = '700 20px "Noto Sans SC", sans-serif';
      pctx.fillText(`“我在《羽刃》中击败了${st.name}，快来挑战我！”`, pw * 0.5, ph - 96);
      pctx.fillStyle = '#f59e0b';
      pctx.font = '600 16px monospace';
      pctx.fillText(`—— 游戏网址：${shareUrl}`, pw * 0.5, ph - 64);

      const dataUrl = posterCanvas.toDataURL('image/png');

      // 在结算弹窗内展示战报缩略预览图并触发下载
      const choicesBox = document.getElementById('overlayChoices');
      let previewWrap = document.getElementById('battleReportPreviewWrap');
      if (!previewWrap) {
        previewWrap = document.createElement('div');
        previewWrap.id = 'battleReportPreviewWrap';
        previewWrap.className = 'p-2 rounded-xl bg-slate-950/90 border border-amber-400/60 flex flex-col items-center gap-1.5 mt-1';
        choicesBox.prepend(previewWrap);
      }
      previewWrap.innerHTML = `
        <div class="text-[11px] font-black text-emerald-300">✅ 战报已生成（长按图片或点击下方链接即可保存分享）</div>
        <img src="${dataUrl}" alt="羽刃战报海报" class="max-h-44 rounded-lg border border-amber-500/50 shadow-lg object-contain" />
        <div class="text-[10px] text-amber-200 select-all">${shareText}</div>
      `;

      // 触发浏览器图片下载
      try {
        const link = document.createElement('a');
        link.download = `羽刃战报_${st.name}_${GameState.playerScore}-${GameState.aiScore}.png`;
        link.href = dataUrl;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      } catch (e) {}

      // （可选）如果支持微信 WeixinJSBridge 或系统 Web Share API，直接触发分享好友/朋友圈
      if (typeof WeixinJSBridge !== 'undefined') {
        try {
          WeixinJSBridge.invoke('shareTimeline', {
            title: shareText,
            link: shareUrl,
            desc: shareText
          });
          WeixinJSBridge.invoke('sendAppMessage', {
            title: `《羽刃》战报：击败${st.name}`,
            desc: shareText,
            link: shareUrl
          });
        } catch (e) {}
      } else if (navigator.share) {
        posterCanvas.toBlob((blob) => {
          if (!blob) return;
          const file = new File([blob], 'featherblade-report.png', { type: 'image/png' });
          const shareData = (navigator.canShare && navigator.canShare({ files: [file] }))
            ? { title: '《羽刃》战报分享', text: shareText, files: [file] }
            : { title: '《羽刃》战报分享', text: shareText, url: shareUrl };
          navigator.share(shareData).catch(() => {});
        });
      }
    }

