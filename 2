    function triggerZeusLightning(normX, normY) {
      const pts = [];
      let curX = normX;
      for (let s = 0; s <= 6; s++) {
        pts.push({
          nx: curX,
          ny: (s / 6) * normY
        });
        curX += (Math.random() - 0.5) * 0.08;
      }
      pts[pts.length - 1] = { nx: normX, ny: normY };
      GameState.lightningBolt = { x: normX, y: normY, life: 1.0, points: pts };
      GameState.bloomAlpha = 1.0;
    }

