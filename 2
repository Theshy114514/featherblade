      tickBgm(dtMs) {
        if (!this.bgmEnabled || !this.ctx || GameState.paused) return;
        if (this.ctx.state === 'suspended') return;
        this.bgmNoteAccMs += dtMs;
        if (this.bgmNoteAccMs < 220) return;
        this.bgmNoteAccMs %= 220;

        const melody = [
          523.25, 659.25, 783.99, 880.00, 783.99, 659.25, 587.33, 659.25,
          523.25, 659.25, 783.99, 1046.50, 987.77, 783.99, 880.00, 783.99
        ];
        const bass = [
          261.63, 261.63, 329.63, 329.63, 349.23, 349.23, 392.00, 392.00,
          220.00, 220.00, 261.63, 261.63, 293.66, 293.66, 392.00, 392.00
        ];
        const now = this.ctx.currentTime;
        const idx = this.bgmStep % melody.length;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(melody[idx], now);
        gain.gain.setValueAtTime(0.022, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.17);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.onended = () => { try { osc.disconnect(); gain.disconnect(); } catch (e) {} };
        osc.start(now);
        osc.stop(now + 0.18);

        if (this.bgmStep % 2 === 0) {
          const bOsc = this.ctx.createOscillator();
          const bGain = this.ctx.createGain();
          bOsc.type = 'sine';
          bOsc.frequency.setValueAtTime(bass[idx], now);
          bGain.gain.setValueAtTime(0.028, now);
          bGain.gain.exponentialRampToValueAtTime(0.001, now + 0.21);
          bOsc.connect(bGain);
          bGain.connect(this.ctx.destination);
          bOsc.onended = () => { try { bOsc.disconnect(); bGain.disconnect(); } catch (e) {} };
          bOsc.start(now);
          bOsc.stop(now + 0.22);
        }
        this.bgmStep++;
      },

      triggerShake(level = 'normal_hit', flashColor = 'rgba(245, 158, 11, 0.24)') {
        if (this.vibMode === 0) return;
        const root = document.getElementById('gameRoot');
        const flash = document.getElementById('screenFlash');
        if (flash && flashColor) {
          flash.style.background = flashColor;
          flash.style.opacity = this.vibMode === 2 ? '1' : '0.45';
          scheduleAction(120, () => { flash.style.opacity = '0'; }, 'screenFlashFade');
        }
        let cssClass = 'shake-light';
        if (level === 'heavy' || level === 'heavy_smash') {
          cssClass = 'shake-heavy';
        } else if (level === 'extreme' || level === 'perfect_parry' || level === 'finisher_break') {
          cssClass = this.vibMode === 2 ? 'shake-extreme' : 'shake-heavy';
        }
        if (root) {
          root.classList.remove('shake-light', 'shake-heavy', 'shake-extreme');
          void root.offsetWidth;
          root.classList.add(cssClass);
          scheduleAction(350, () => {
            root.classList.remove('shake-light', 'shake-heavy', 'shake-extreme');
          }, 'clearRootShake');
        }
        try {
          if (navigator.vibrate) {
            if (level === 'light_tap' || level === 'light') {
              // 轻击/过渡：微震
              navigator.vibrate(10);
            } else if (level === 'perfect_parry') {
              // 完美弹反：高频双段脉冲，像打铁
              navigator.vibrate([15, 20, 30]);
            } else if (level === 'heavy_smash' || level === 'heavy') {
              // 起跳重杀：沉重下坠感
              navigator.vibrate([30, 15, 60]);
            } else if (level === 'finisher_break' || level === 'extreme') {
              // 制胜扣杀 (Finisher)：毁灭性狂震
              navigator.vibrate([60, 30, 100, 30, 120]);
            } else {
              // 普通击球/过渡默认微震
              navigator.vibrate(10);
            }
          }
        } catch (e) {}
      }
