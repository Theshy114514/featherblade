    // ==================== 13. FEATHERBLADE 2D COMPOSITE RIG, BLOOM, GRAVITY SHARDS & FEATHERBLADE POSTURE RENDERER ====================
    const canvas = document.getElementById('courtCanvas');
    const ctx = canvas.getContext('2d');
    let rafId = null;
    let lastFrameTime = performance.now();

    function resizeCanvas() {
      const container = document.getElementById('canvasContainer');
      if (!container || !canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = container.getBoundingClientRect();
      const targetW = Math.max(320, Math.round(rect.width * dpr));
      const targetH = Math.max(200, Math.round(rect.height * dpr));
      if (canvas.width !== targetW || canvas.height !== targetH) {
        canvas.width = targetW;
        canvas.height = targetH;
      }
      ctx.imageSmoothingEnabled = true;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function projectCourtRaw(nx, ny, w, h) {
      const topY = h * 0.13;
      const botY = h * 0.91;
      const py = topY + ny * (botY - topY);
      const halfWidthTop = w * 0.265;
      const halfWidthBot = w * 0.455;
      const halfW = halfWidthTop + ny * (halfWidthBot - halfWidthTop);
      const px = w * 0.5 + (nx - 0.5) * 2 * halfW;
      return { x: px, y: py, scale: 0.64 + ny * 0.46 };
    }

    // Dynamic Camera Coordinate Projection (World-space projection; camera zoom/focus applied via ctx.setTransform in renderCourtLoop)
    function projectCourt(nx, ny, w, h) {
      return projectCourtRaw(nx, ny, w, h);
    }

    function evaluateShuttle3D(sh, u) {
      const t = Math.max(0, Math.min(1, u));
      let horizFrac = t;
      let z = 0;

      if (sh.trajType === 'high') {
        if (t < 0.70) {
          horizFrac = (t / 0.70) * 0.87;
        } else {
          const tail = (t - 0.70) / 0.30;
          horizFrac = 0.87 + (1 - Math.pow(1 - tail, 2.2)) * 0.13;
        }
        if (t < 0.46) {
          const p = t / 0.46;
          z = sh.startZ + (0.76 - sh.startZ) * (1 - Math.pow(1 - p, 2.0));
        } else {
          const p = (t - 0.46) / 0.54;
          z = 0.76 * Math.pow(1 - p, 1.85);
        }
      } else if (sh.trajType === 'smash') {
        horizFrac = 1 - Math.pow(1 - t, 1.15);
        z = sh.startZ * Math.pow(1 - t, 1.08);
      } else if (sh.trajType === 'drop') {
        if (t < 0.46) {
          const p = t / 0.46;
          horizFrac = p * 0.60;
          z = sh.startZ + 0.22 * Math.sin(p * Math.PI * 0.55);
        } else {
          const p = (t - 0.46) / 0.54;
          horizFrac = 0.60 + (1 - Math.pow(1 - p, 2.4)) * 0.40;
          z = (sh.startZ + 0.18) * (1 - Math.pow(p, 1.55));
        }
      } else {
        horizFrac = t;
        z = sh.startZ * (1 - t * 0.82) + Math.sin(t * Math.PI) * 0.14;
      }

      let cx = sh.startX + ((sh.baseTargetX || sh.targetX) - sh.startX) * horizFrac;
      const cy = sh.startY + (sh.targetY - sh.startY) * horizFrac;
      // 【维度二·任务2：侧旋与切削 S/C 型弧线弯折】
      if (sh.spinType === 'S') {
        cx += sh.spinDir * Math.sin(t * Math.PI * 2) * 0.12;
      } else if (sh.spinType === 'C') {
        cx += sh.spinDir * Math.sin(t * Math.PI) * 0.15;
      }
      cx = Math.max(0.05, Math.min(0.95, cx));
      return { cx, cy, z: Math.max(0, z) };
    }

    function updatePhysicsTick(now, dtMs) {
      if (GameState.paused) return;

      const rawFrameFactor = dtMs / 16.67;
      // 【完美弹反的时空凝滞：Time Scale = 0.2 持续 0.3 秒】
      if (GameState.timeScaleTimer > 0) {
        GameState.timeScaleTimer = Math.max(0, GameState.timeScaleTimer - dtMs);
        if (GameState.timeScaleTimer === 0) {
          GameState.timeScale = 1.0;
        }
      }
      const effDtMs = dtMs * GameState.timeScale;
      const dtSec = effDtMs / 1000;
      const frameFactor = effDtMs / 16.67;

      // 【动态镜头特写（Zoom & Focus）】：击球瞬间 camZoom = 1.35，羽毛球飞出后的 0.5 秒(500ms)内平滑插值回 1.0
      const cam = GameState.camState;
      if (GameState.hitStop > 0) {
        GameState.camZoom = 1.35;
        GameState.camZoomOutElapsedMs = 0;
      } else {
        GameState.camZoomOutElapsedMs = Math.min(500, (GameState.camZoomOutElapsedMs || 0) + dtMs);
        const zoomOutProgress = Math.min(1.0, GameState.camZoomOutElapsedMs / 500);
        const easedOut = 1 - Math.pow(1 - zoomOutProgress, 2.2);
        GameState.camZoom = lerp(1.35, 1.0, easedOut);
        if (GameState.shuttle.inFlight) {
          const trackWeight = (1 - easedOut) * 0.65;
          GameState.camFocus.x = lerp(0.5, GameState.shuttle.x, trackWeight);
          GameState.camFocus.y = lerp(0.5, GameState.shuttle.y, trackWeight);
        } else {
          GameState.camFocus.x = lerp(GameState.camFocus.x, 0.5, 0.14 * rawFrameFactor);
          GameState.camFocus.y = lerp(GameState.camFocus.y, 0.5, 0.14 * rawFrameFactor);
        }
      }
      if (cam.blurTimer > 0) {
        cam.blurTimer = Math.max(0, cam.blurTimer - dtMs);
      }
      cam.zoom = GameState.camZoom;
      cam.focusX = GameState.camFocus.x;
      cam.focusY = GameState.camFocus.y;

      updateActionTimers(dtMs);
      if (GameState.bassDropTimer > 0) {
        GameState.bassDropTimer = Math.max(0, GameState.bassDropTimer - dtMs);
      }
      if (GameState.bloomAlpha > 0) {
        GameState.bloomAlpha = Math.max(0, GameState.bloomAlpha - 0.055 * frameFactor);
      }
      if (GameState.lightningBolt) {
        GameState.lightningBolt.life -= 0.045 * frameFactor;
        if (GameState.lightningBolt.life <= 0) GameState.lightningBolt = null;
      }

      // Staggered Stun Timers (2000ms on 【重心崩溃】)
      if (GameState.aiStunTimer > 0) {
        GameState.aiStunTimer = Math.max(0, GameState.aiStunTimer - dtMs);
      }
      if (GameState.playerStunTimer > 0) {
        GameState.playerStunTimer = Math.max(0, GameState.playerStunTimer - dtMs);
      }

      // Dionysus Poison Boon: 3 seconds automatic AI posture increase (+9/sec)
      let uiNeedsSync = false;
      if (GameState.aiPoisonTimer > 0 && GameState.phase !== 'break_finisher') {
        GameState.aiPoisonTimer = Math.max(0, GameState.aiPoisonTimer - dtMs);
        GameState.aiPosture = Math.min(100, GameState.aiPosture + 9.0 * dtSec);
        syncPostureAlias();
        uiNeedsSync = true;
        if (GameState.aiPosture >= 100) {
          checkAiPostureBreak();
        }
      }

      // Featherblade Posture Auto-Recovery Mechanism: Slowly decay posture when not engaging for > 1.05s
      if (GameState.phase !== 'serve' && GameState.phase !== 'break_finisher') {
        if (now - GameState.playerLastActionTime > 1050 && GameState.playerPosture > 0 && GameState.playerStunTimer <= 0) {
          GameState.playerPosture = Math.max(0, GameState.playerPosture - 6.8 * dtSec);
          syncPostureAlias();
          uiNeedsSync = true;
        }
        if (now - GameState.aiLastActionTime > 1050 && GameState.aiPoisonTimer <= 0 && GameState.aiPosture > 0 && GameState.aiPosture < 100 && GameState.aiStunTimer <= 0) {
          GameState.aiPosture = Math.max(0, GameState.aiPosture - 5.5 * dtSec);
          syncPostureAlias();
          uiNeedsSync = true;
        }
      }
      if (uiNeedsSync && Math.random() < 0.25) {
        updateAllUI();
      }

      SoundEngine.tickBgm(dtMs);

      if (GameState.pressSwipe.active) {
        const heldMs = now - GameState.pressSwipe.startTime;
        GameState.pressSwipe.chargePct = Math.min(1.0, heldMs / 750);
      }

      if (GameState.joyBurstTimer > 0) {
        GameState.joyBurstTimer = Math.max(0, GameState.joyBurstTimer - dtMs);
      }
      if (GameState.dashTimer > 0) {
        GameState.dashTimer = Math.max(0, GameState.dashTimer - dtMs);
      }
      if (GameState.turnaroundTimer > 0) {
        GameState.turnaroundTimer = Math.max(0, GameState.turnaroundTimer - dtMs);
      }
      if (GameState.playerRecoveryTimer > 0) {
        GameState.playerRecoveryTimer = Math.max(0, GameState.playerRecoveryTimer - dtMs);
      }
      if (GameState.defCooldownTimer > 0) {
        GameState.defCooldownTimer = Math.max(0, GameState.defCooldownTimer - dtMs);
        if (GameState.defCooldownTimer === 0 && GameState.phase === 'ai_incoming') {
          syncDefenseReachButtons();
        }
      }
      if (GameState.tacticalSuppressTimer > 0) {
        GameState.tacticalSuppressTimer = Math.max(0, GameState.tacticalSuppressTimer - dtMs);
      }
      if (GameState.aiStaggerTimer > 0) {
        GameState.aiStaggerTimer = Math.max(0, GameState.aiStaggerTimer - dtMs);
      }
      if (GameState.joyFlickAlpha > 0 && !GameState.joyActive) {
        GameState.joyFlickAlpha = Math.max(0, GameState.joyFlickAlpha - 0.06 * frameFactor);
        const streamEl = document.getElementById('joyFlickStream');
        if (streamEl) streamEl.setAttribute('opacity', GameState.joyFlickAlpha.toFixed(2));
      }

      // 8-Way Snap Joystick + 【双击爆发冲刺 Dash (2.0x)】+ 【0.1s 启动帧 / 0.2s 刹车帧】+ 【0.15s 急停转身硬直】+ 【0.5s 重杀收招硬直】
      let vx = GameState.joyVx;
      let vy = GameState.joyVy;
      let kbX = 0, kbY = 0;
      if (GameState.keysDown['KeyA'] || GameState.keysDown['ArrowLeft']) kbX -= 1;
      if (GameState.keysDown['KeyD'] || GameState.keysDown['ArrowRight']) kbX += 1;
      if (GameState.keysDown['KeyW'] || GameState.keysDown['ArrowUp']) kbY -= 1;
      if (GameState.keysDown['KeyS'] || GameState.keysDown['ArrowDown']) kbY += 1;
      if (kbX !== 0 || kbY !== 0) {
        const snapRad = Math.round(Math.atan2(kbY, kbX) / (Math.PI / 4)) * (Math.PI / 4);
        vx = Number(Math.cos(snapRad).toFixed(3));
        vy = Number(Math.sin(snapRad).toFixed(3));
      }

      if (GameState.dashTimer > 0) {
        vx = GameState.dashVx;
        vy = GameState.dashVy;
      }

      const mag = Math.hypot(vx, vy);
      const lowStamSlow = GameState.pStamina < 20 ? 0.65 : 1.0;
      const speedCardMult = hasBoon('hermes') ? (1 + 0.5 * countBoon('hermes')) : 1.0;
      const stamCardMult = hasBoon('hermes') ? 0.5 : 1.0;

      // 0.1s (100ms) 前摇启动帧线性加速
      if (mag > 0.08) {
        GameState.moveStartupMs = Math.min(100, GameState.moveStartupMs + dtMs);
        GameState.moveBrakeMs = 200; // 预备松手后 0.2s 刹车滑行帧
      } else {
        GameState.moveStartupMs = 0;
        GameState.moveBrakeMs = Math.max(0, GameState.moveBrakeMs - dtMs);
      }
      const startupFactor = 0.35 + 0.65 * (GameState.moveStartupMs / 100);
      const dashMult = GameState.dashTimer > 0 ? 2.0 : (GameState.joyBurstTimer > 0 ? 1.28 : 1.0);
      if (GameState.forwardInertiaTimer > 0) {
        GameState.forwardInertiaTimer = Math.max(0, GameState.forwardInertiaTimer - dtMs);
        // 滑板/劈吊 0.2s 向前惯性：身体持续向前微冲，且无法立刻向后退 (vy > 0 被拦截)
        GameState.playerVisual.y = Math.max(0.55, GameState.playerVisual.y - 0.0045 * frameFactor);
        if (vy > 0) vy = 0;
      }
      if (GameState.lateSlowTimer > 0) {
        GameState.lateSlowTimer = Math.max(0, GameState.lateSlowTimer - dtMs);
      }
      const lateSlowMult = GameState.lateSlowTimer > 0 ? 0.50 : 1.0;
      const isSmashLocked = GameState.playerRecoveryTimer > 0 && GameState.recoveryType === 'smash_crouch';

      const moveSpeed = 0.0128 * lowStamSlow * speedCardMult * startupFactor * dashMult * lateSlowMult * frameFactor;

      if (GameState.turnaroundTimer > 0 || isSmashLocked) {
        // 0.15s 急停转身硬直 或 0.4s 重杀落地深蹲后摇（此时无法移动）
        GameState.playerVisual.vx = 0;
        GameState.playerVisual.vy = 0;
      } else if (mag > 0.08 && GameState.playerStunTimer <= 0) {
        // 鞋底摩擦声：按住摇杆跑动时每隔 0.3 秒 (300ms) 播放一次高频摩擦“吱”声
        SoundEngine.squeakAccMs += dtMs;
        if (SoundEngine.squeakAccMs >= 300) {
          SoundEngine.squeakAccMs = 0;
          SoundEngine.playShoeSqueak();
        }
        // 2.5D 透视移动修正：X轴 1.0, Y轴纵深 0.8
        const stepX = vx * moveSpeed * 1.0;
        const stepY = vy * moveSpeed * 0.8;

        const nextX = Math.max(0.08, Math.min(0.92, GameState.playerVisual.x + stepX));
        const nextY = Math.max(0.55, Math.min(0.95, GameState.playerVisual.y + stepY));
        GameState.playerVisual.x = nextX;
        GameState.playerVisual.y = nextY;
        GameState.playerVisual.targetX = nextX;
        GameState.playerVisual.targetY = nextY;
        GameState.playerVisual.moveElapsed = GameState.playerVisual.moveDuration;
        GameState.playerVisual.vx = vx;
        GameState.playerVisual.vy = vy;
        GameState.playerVisual.stridePhase += 0.32 * speedCardMult * dashMult * frameFactor;

        GameState.pStamina = Math.max(0, GameState.pStamina - 0.042 * stamCardMult * frameFactor);

        // Spawn dash afterimage trail while dashing
        if (GameState.dashTimer > 0 && GameState.playerVisual.dashAfterimages.length < 3) {
          GameState.playerVisual.dashAfterimages.push({
            nx: GameState.playerVisual.x - vx * 0.035,
            ny: GameState.playerVisual.y - vy * 0.028,
            alpha: 0.72
          });
        }

        if (GameState.tutorialStep === 1) {
          GameState.tutorialStep = 2;
          renderActionDeck();
        }
      } else if (GameState.moveBrakeMs > 0) {
        // 0.2s (200ms) 刹车滑行帧
        const brakeRatio = GameState.moveBrakeMs / 200;
        const glideX = GameState.playerVisual.vx * 0.0085 * brakeRatio * frameFactor;
        const glideY = GameState.playerVisual.vy * 0.0085 * 0.8 * brakeRatio * frameFactor;
        GameState.playerVisual.x = Math.max(0.08, Math.min(0.92, GameState.playerVisual.x + glideX));
        GameState.playerVisual.y = Math.max(0.55, Math.min(0.95, GameState.playerVisual.y + glideY));
        GameState.playerVisual.targetX = GameState.playerVisual.x;
        GameState.playerVisual.targetY = GameState.playerVisual.y;
      } else {
        GameState.playerVisual.vx = 0;
        GameState.playerVisual.vy = 0;
      }

      // Decay Player Jump-Smash & Dash Afterimages in-place (Zero Memory Leak)
      const afterImgs = GameState.playerVisual.smashAfterimages;
      if (afterImgs && afterImgs.length) {
        for (let i = afterImgs.length - 1; i >= 0; i--) {
          afterImgs[i].alpha -= 0.032 * frameFactor;
          if (afterImgs[i].alpha <= 0) afterImgs.splice(i, 1);
        }
      }
      const dashImgs = GameState.playerVisual.dashAfterimages;
      if (dashImgs && dashImgs.length) {
        for (let i = dashImgs.length - 1; i >= 0; i--) {
          dashImgs[i].alpha -= 0.055 * frameFactor;
          if (dashImgs[i].alpha <= 0) dashImgs.splice(i, 1);
        }
      }

      ['playerVisual', 'aiVisual'].forEach(key => {
        const v = GameState[key];
        if (v.moveElapsed < v.moveDuration) {
          v.moveElapsed = Math.min(v.moveDuration, v.moveElapsed + dtSec);
          const eased = easeOutCubic(v.moveElapsed / v.moveDuration);
          v.x = v.startX + (v.targetX - v.startX) * eased;
          v.y = v.startY + (v.targetY - v.startY) * eased;
          v.stridePhase += 0.25 * frameFactor;
        }
        if (v.swingAnim > 0) v.swingAnim = Math.max(0, v.swingAnim - 0.058 * frameFactor);
        if (v.impactSpark > 0) v.impactSpark = Math.max(0, v.impactSpark - 0.12 * frameFactor);

        if (v.jumpHeight > 0) {
          v.jumpHeight = Math.max(0, v.jumpHeight - 0.052 * frameFactor);
          if (v.jumpHeight === 0) {
            v.landingCrouch = 1.0;
          }
        } else if (v.landingCrouch > 0) {
          v.landingCrouch = Math.max(0, v.landingCrouch - 0.075 * frameFactor);
          if (v.landingCrouch === 0 && v.poseType === 'jump_smash') {
            v.poseType = 'ready';
          }
        }
      });

      const prevPos = GameState.pPos;
      updatePlayerGridFromCoords();

      if (prevPos !== GameState.pPos && GameState.phase === 'player_offense' && !GameState.pressSwipe.active) {
        renderActionDeck();
      }

      if (GameState.phase === 'ai_incoming') {
        const nowReach = isPlayerInLandingCircle();
        if (nowReach !== GameState.lastInReachState) {
          syncDefenseReachButtons();
        }
      }
    }

    // Draw Featherblade-Style Dual Symmetric Posture Bar on Canvas
    function drawFeatherbladePostureBar(ctx, cx, cy, width, height, postureVal, label, isBroken, isPoisoned) {
      ctx.save();
      const halfW = width * 0.5;
      const ratio = Math.max(0, Math.min(1, postureVal / 100));

      // Background diamond-tipped bar with #0f0f0f thick border
      ctx.fillStyle = 'rgba(10, 5, 20, 0.88)';
      ctx.strokeStyle = '#0f0f0f';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(cx - halfW - 8, cy + height * 0.5);
      ctx.lineTo(cx - halfW, cy);
      ctx.lineTo(cx + halfW, cy);
      ctx.lineTo(cx + halfW + 8, cy + height * 0.5);
      ctx.lineTo(cx + halfW, cy + height);
      ctx.lineTo(cx - halfW, cy + height);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      // Gold inner trim
      ctx.strokeStyle = isBroken ? '#ef4444' : (isPoisoned ? '#c084fc' : '#f59e0b');
      ctx.lineWidth = 1.5;
      ctx.strokeRect(cx - halfW, cy, width, height);

      // Center symmetric fill (expands from center outward like Featherblade Posture!)
      if (ratio > 0) {
        const fillHalf = halfW * ratio;
        const grad = ctx.createLinearGradient(cx - fillHalf, cy, cx + fillHalf, cy);
        if (ratio >= 0.85 || isBroken) {
          grad.addColorStop(0, '#dc2626');
          grad.addColorStop(0.5, '#fef08a');
          grad.addColorStop(1, '#dc2626');
        } else if (isPoisoned) {
          grad.addColorStop(0, '#9333ea');
          grad.addColorStop(0.5, '#f0abfc');
          grad.addColorStop(1, '#9333ea');
        } else {
          grad.addColorStop(0, '#d97706');
          grad.addColorStop(0.5, '#fef08a');
          grad.addColorStop(1, '#d97706');
        }
        ctx.fillStyle = grad;
        ctx.fillRect(cx - fillHalf, cy + 1.5, fillHalf * 2, height - 3);
      }

      // Center node notch
      ctx.fillStyle = '#fef3c7';
      ctx.fillRect(cx - 1.5, cy - 2, 3, height + 4);

      ctx.font = 'italic 900 10px "Cinzel", "Noto Serif SC", serif';
      ctx.fillStyle = isBroken ? '#fca5a5' : '#fef3c7';
      ctx.textAlign = 'center';
      ctx.shadowColor = '#000';
      ctx.shadowBlur = 0;
      ctx.fillText(`${label} ${Math.round(postureVal)}/100`, cx, cy - 4);
      ctx.restore();
    }

    function renderCourtLoop(now) {
      const dtMs = Math.min(40, Math.max(4, now - lastFrameTime));
      lastFrameTime = now;
      const frameFactor = dtMs / 16.67;

      const container = document.getElementById('canvasContainer');
      if (!container) return;
      const w = container.clientWidth;
      const h = container.clientHeight;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      // 【性能自适应（Performance Adaptive）FPS 监控】：如果连续 3 秒平均帧率低于 50，自动降低画质
      if (!GameState.paused) {
        const fm = GameState.fpsMonitor;
        fm.frames++;
        fm.accMs += dtMs;
        if (fm.accMs >= 1000) {
          fm.currentFps = (fm.frames * 1000) / fm.accMs;
          if (fm.currentFps < 50) {
            fm.lowFpsSec++;
            if (fm.lowFpsSec >= 3 && GameState.qualityMode === 'high') {
              setQualityMode('smooth', true);
            }
          } else {
            fm.lowFpsSec = 0;
          }
          fm.frames = 0;
          fm.accMs = 0;
        }
      }

      const venue = VENUES[GameState.venueIdx] || VENUES[0];
      const st = getCurrentStage();
      const hero = getCurrentHero();

      // Hit-Stop: 仅暂停物理推进，但正常重绘超清球场，彻底杜绝叠雾发蒙！
      if (GameState.hitStop > 0) {
        GameState.hitStop = Math.max(0, GameState.hitStop - dtMs);
      } else {
        updatePhysicsTick(now, dtMs);
      }

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      // 【动态镜头特写（Zoom & Focus）】：限制最大缩放为 1.15 倍并对偏移取整，确保线条与文字 100% 锐利不发虚
      const rawZoom = GameState.camZoom || 1.0;
      const zoom = 1.0 + (rawZoom - 1.0) * 0.42;
      const focusScreen = projectCourtRaw(GameState.camFocus.x, GameState.camFocus.y, w, h);
      const camTx = Math.round((w * 0.5 - focusScreen.x * zoom) * dpr);
      const camTy = Math.round((h * 0.5 - focusScreen.y * zoom) * dpr);
      ctx.setTransform(dpr * zoom, 0, 0, dpr * zoom, camTx, camTy);

      // 1. 赛场超清深色背景（移除会导致全屏发蒙掉帧的 ctx.filter 模糊）
      ctx.save();
      const bgGrad = ctx.createRadialGradient(w * 0.5, h * 0.42, 20, w * 0.5, h * 0.5, Math.max(w, h) * 0.78);
      bgGrad.addColorStop(0, '#271046');
      bgGrad.addColorStop(0.55, '#1a0b2e');
      bgGrad.addColorStop(1, '#000000');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, w, h);

      // 1.5 Task 4: Floating Underworld Ash & Golden Dust Particles Around Court (Zero Memory Leak)
      ctx.save();
      for (let i = 0; i < GameState.ambientAsh.length; i++) {
        const ash = GameState.ambientAsh[i];
        ash.y += ash.vy * frameFactor;
        ash.x += (ash.vx + Math.sin(now * 0.0015 + ash.phase) * 0.00025) * frameFactor;
        if (ash.y < -0.04) ash.y = 1.04;
        if (ash.x < -0.04) ash.x = 1.04;
        if (ash.x > 1.04) ash.x = -0.04;

        const ax = ash.x * w;
        const ay = ash.y * h;
        ctx.globalAlpha = ash.alpha * (0.65 + 0.35 * Math.sin(now * 0.003 + ash.phase));
        ctx.fillStyle = ash.isGold ? '#f59e0b' : '#6b21a8';
        ctx.beginPath();
        ctx.arc(ax, ay, ash.size, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();

      ctx.restore();

      // 2. 2.5D Court with Dynamic Camera Motion Blur (当球高速飞出瞬间对背景场地施加轻微动态模糊)
      const tl = projectCourt(0, 0, w, h);
      const tr = projectCourt(1, 0, w, h);
      const br = projectCourt(1, 1, w, h);
      const bl = projectCourt(0, 1, w, h);

      ctx.save();
      // 保持球场线条 100% 原生超清锐利，不使用任何会使画面发蒙的 ctx.filter 模糊
      ctx.beginPath();
      ctx.moveTo(tl.x, tl.y); ctx.lineTo(tr.x, tr.y); ctx.lineTo(br.x, br.y); ctx.lineTo(bl.x, bl.y);
      ctx.closePath();
      const courtGrad = ctx.createLinearGradient(0, tl.y, 0, bl.y);
      courtGrad.addColorStop(0, '#160a28');
      courtGrad.addColorStop(0.5, '#1f0e38');
      courtGrad.addColorStop(1, '#120722');
      ctx.fillStyle = courtGrad;
      ctx.fill();

      // Thick black outer outline + gold inner border
      ctx.lineWidth = 6;
      ctx.strokeStyle = '#0f0f0f';
      ctx.stroke();

      // 9-Grid Zone Highlight under Player
      const pCol = GameState.pGridIdx % 3;
      const pRow = Math.floor(GameState.pGridIdx / 3);
      const gx0 = 0.06 + pCol * (0.88 / 3);
      const gx1 = 0.06 + (pCol + 1) * (0.88 / 3);
      const gy0 = 0.5 + pRow * 0.166;
      const gy1 = 0.5 + (pRow + 1) * 0.166;
      const z1 = projectCourt(gx0, gy0, w, h);
      const z2 = projectCourt(gx1, gy0, w, h);
      const z3 = projectCourt(gx1, gy1, w, h);
      const z4 = projectCourt(gx0, gy1, w, h);
      ctx.fillStyle = 'rgba(245, 158, 11, 0.14)';
      ctx.beginPath();
      ctx.moveTo(z1.x, z1.y); ctx.lineTo(z2.x, z2.y); ctx.lineTo(z3.x, z3.y); ctx.lineTo(z4.x, z4.y);
      ctx.closePath();
      ctx.fill();

      // Doubles Sidelines & Baselines in Gold
      ctx.lineWidth = 2.6;
      ctx.strokeStyle = '#f59e0b';
      ctx.beginPath();
      ctx.moveTo(tl.x, tl.y); ctx.lineTo(tr.x, tr.y); ctx.lineTo(br.x, br.y); ctx.lineTo(bl.x, bl.y);
      ctx.closePath();
      ctx.stroke();

      // Singles Sidelines (x = 0.06 and x = 0.94)
      ctx.strokeStyle = 'rgba(251, 191, 36, 0.72)';
      ctx.lineWidth = 2.0;
      [0.06, 0.94].forEach(sx => {
        const pTop = projectCourt(sx, 0, w, h);
        const pBot = projectCourt(sx, 1, w, h);
        ctx.beginPath();
        ctx.moveTo(pTop.x, pTop.y);
        ctx.lineTo(pBot.x, pBot.y);
        ctx.stroke();
      });

      // Doubles Long Service Lines
      ctx.strokeStyle = 'rgba(245, 158, 11, 0.45)';
      ctx.lineWidth = 1.4;
      [0.06, 0.94].forEach(ly => {
        const pL = projectCourt(0, ly, w, h);
        const pR = projectCourt(1, ly, w, h);
        ctx.beginPath();
        ctx.moveTo(pL.x, pL.y);
        ctx.lineTo(pR.x, pR.y);
        ctx.stroke();
      });

      // Center Service Line
      ctx.strokeStyle = 'rgba(245, 158, 11, 0.68)';
      ctx.lineWidth = 1.9;
      const cTop0 = projectCourt(0.5, 0, w, h);
      const cTop1 = projectCourt(0.5, 0.38, w, h);
      ctx.beginPath(); ctx.moveTo(cTop0.x, cTop0.y); ctx.lineTo(cTop1.x, cTop1.y); ctx.stroke();

      const cBot0 = projectCourt(0.5, 0.62, w, h);
      const cBot1 = projectCourt(0.5, 1.0, w, h);
      ctx.beginPath(); ctx.moveTo(cBot0.x, cBot0.y); ctx.lineTo(cBot1.x, cBot1.y); ctx.stroke();

      // Front Service Lines
      const fsAiL = projectCourt(0, 0.38, w, h);
      const fsAiR = projectCourt(1, 0.38, w, h);
      ctx.strokeStyle = 'rgba(244, 63, 94, 0.75)';
      ctx.lineWidth = 2.4;
      ctx.beginPath(); ctx.moveTo(fsAiL.x, fsAiL.y); ctx.lineTo(fsAiR.x, fsAiR.y); ctx.stroke();

      const fsPlL = projectCourt(0, 0.62, w, h);
      const fsPlR = projectCourt(1, 0.62, w, h);
      ctx.strokeStyle = '#f59e0b';
      ctx.lineWidth = 3.2;
      ctx.beginPath(); ctx.moveTo(fsPlL.x, fsPlL.y); ctx.lineTo(fsPlR.x, fsPlR.y); ctx.stroke();

      // 【策略任务一·4：3D球场地板标出 AI 无法及时跑到的“绝对空当”光圈】
      if (GameState.phase === 'player_offense') {
        const openInfo = getAiOpenCourtInfo();
        if (openInfo) {
          const opPt = projectCourt(openInfo.normX, openInfo.normY, w, h);
          const pulse = 0.55 + 0.35 * Math.sin(now * 0.008);
          ctx.save();
          ctx.beginPath();
          ctx.ellipse(opPt.x, opPt.y, 34 * opPt.scale, 16 * opPt.scale, 0, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(16, 185, 129, ${(0.18 * pulse).toFixed(2)})`;
          ctx.fill();
          ctx.lineWidth = 2.4;
          ctx.strokeStyle = `rgba(253, 224, 71, ${pulse.toFixed(2)})`;
          ctx.setLineDash([5, 3]);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.font = 'italic 900 11px "Noto Serif SC", serif';
          ctx.fillStyle = '#fde047';
          ctx.textAlign = 'center';
          ctx.fillText(openInfo.label, opPt.x, opPt.y + 4);
          ctx.restore();
        }
      }
      ctx.restore();

      // 2.5 暴击金框特效（仅高亮边框，绝不压暗或模糊球场画面）
      if (GameState.bassDropTimer > 0) {
        const bdAlpha = Math.min(0.85, (GameState.bassDropTimer / 520));
        ctx.save();
        ctx.strokeStyle = `rgba(245, 158, 11, ${bdAlpha.toFixed(2)})`;
        ctx.lineWidth = 3;
        ctx.strokeRect(4, 4, w - 8, h - 8);
        ctx.restore();
      }

      // 3. 3D Badminton Net (y = 0.50) with #0f0f0f Thick Outline
      const netL = projectCourt(0, 0.5, w, h);
      const netR = projectCourt(1, 0.5, w, h);
      const netHeight = 25;
      ctx.save();
      ctx.fillStyle = 'rgba(15, 8, 28, 0.68)';
      ctx.fillRect(netL.x, netL.y - netHeight, netR.x - netL.x, netHeight);
      ctx.strokeStyle = '#0f0f0f';
      ctx.lineWidth = 5;
      ctx.beginPath();
      ctx.moveTo(netL.x, netL.y - netHeight);
      ctx.lineTo(netR.x, netR.y - netHeight);
      ctx.stroke();
      ctx.strokeStyle = '#f59e0b';
      ctx.lineWidth = 2.6;
      ctx.beginPath();
      ctx.moveTo(netL.x, netL.y - netHeight);
      ctx.lineTo(netR.x, netR.y - netHeight);
      ctx.stroke();
      ctx.restore();

      // 4. Opponent Featherblade 2D Composite Skeletal Rig + Featherblade Posture Bar
      const aiPt = projectCourt(GameState.aiVisual.x, GameState.aiVisual.y, w, h);
      drawBadmintonStickman(ctx, aiPt.x, aiPt.y, aiPt.scale, {
        isPlayer: false,
        visObj: GameState.aiVisual,
        color: st.avatarColor || '#f43f5e',
        poseType: GameState.aiVisual.poseType,
        swing: GameState.aiVisual.swingAnim,
        swingType: GameState.aiVisual.swingType,
        jump: GameState.aiVisual.jumpHeight,
        landingCrouch: GameState.aiVisual.landingCrouch,
        impactSpark: GameState.aiVisual.impactSpark,
        stride: GameState.aiVisual.stridePhase,
        moving: GameState.aiVisual.moveElapsed < GameState.aiVisual.moveDuration,
        hand: 'forehand',
        cog: 80,
        postureZero: GameState.phase === 'break_finisher' || GameState.aiStunTimer > 0,
        frameFactor
      });

      // Draw Featherblade Posture Bar above AI
      drawFeatherbladePostureBar(
        ctx,
        aiPt.x + (GameState.aiStaggerTimer > 0 ? Math.sin(now * 0.05) * 6 : 0),
        aiPt.y - 68 * aiPt.scale,
        118,
        8,
        GameState.aiPosture,
        GameState.phase === 'break_finisher'
          ? '💥 【重心崩溃】 (点击屏幕制胜扣杀!)'
          : (GameState.tacticalSuppressTimer > 0 ? '⚡ 战术压制！(AI踉跄1.0s)' : `${st.name} 破绽`),
        GameState.phase === 'break_finisher' || GameState.tacticalSuppressTimer > 0 || (GameState.timeScaleTimer > 0 && Math.floor(now / 40) % 2 === 0),
        GameState.aiPoisonTimer > 0
      );
      if (GameState.aiAnticipatedZone && GameState.phase === 'player_offense') {
        ctx.save();
        ctx.font = 'italic 900 11px "Noto Serif SC", serif';
        ctx.fillStyle = '#fda4af';
        ctx.textAlign = 'center';
        ctx.fillText('👁️ AI已预判此侧(变线或假动作可破)!', aiPt.x, aiPt.y - 82 * aiPt.scale);
        ctx.restore();
      }

      // AI Action Telegraph (危 / 软球破绽)
      if (GameState.aiDrawCard && GameState.aiDrawCard.life > 0) {
        const card = GameState.aiDrawCard;
        ctx.save();
        ctx.globalAlpha = Math.min(1, card.life * 1.25);

        if (card.isSmash) {
          ctx.font = 'italic 900 24px "Noto Serif SC", serif';
          ctx.strokeStyle = '#0f0f0f';
          ctx.lineWidth = 4;
          ctx.strokeText('危', aiPt.x, aiPt.y - 64 - (1 - card.life) * 14);
          ctx.fillStyle = '#f43f5e';
          ctx.shadowColor = '#f43f5e';
          ctx.shadowBlur = 0;
          ctx.textAlign = 'center';
          ctx.fillText('危', aiPt.x, aiPt.y - 64 - (1 - card.life) * 14);
        } else if (card.isSoft) {
          ctx.font = 'italic 900 13px "Noto Serif SC", serif';
          ctx.fillStyle = '#fde047';
          ctx.shadowColor = '#f59e0b';
          ctx.shadowBlur = 0;
          ctx.textAlign = 'center';
          ctx.fillText('✦⭐✦ 软球破绽!', aiPt.x, aiPt.y - 62 - (1 - card.life) * 12);
        } else {
          ctx.font = 'italic 800 11px "Noto Serif SC", serif';
          ctx.fillStyle = '#fef3c7';
          ctx.textAlign = 'center';
          ctx.fillText(card.text, aiPt.x, aiPt.y - 60 - (1 - card.life) * 12);
        }
        ctx.restore();
        card.life -= 0.020 * frameFactor;
        if (card.life <= 0) GameState.aiDrawCard = null;
      }

      // 5. Expedition 33 High-Pressure Shrinking QTE Circle & Featherblade Deflect Ring
      const pPt = projectCourt(GameState.playerVisual.x, GameState.playerVisual.y, w, h);

      if (GameState.phase === 'ai_incoming' && GameState.incomingShot) {
        const inc = GameState.incomingShot;
        const tPt = projectCourt(inc.targetX, inc.targetY, w, h);
        const totalDur = Math.max(200, inc.overlapTime - inc.startTime);
        const ratio = (inc.overlapTime - now) / totalDur;
        const inReach = isPlayerInLandingCircle();
        const isPerfectWindowNow = Math.abs(ratio) <= 0.14;

        syncCenterFootworkCompass();
        const cdEl = document.getElementById('sensoryCountdownText');
        if (cdEl) {
          if (now < GameState.sensoryLockUntilMs) {
            cdEl.textContent = `失衡惩罚: ${((GameState.sensoryLockUntilMs - now) / 1000).toFixed(2)}s`;
            cdEl.className = 'text-[9px] text-rose-400 font-mono font-black';
          } else {
            cdEl.textContent = `慢动作窗口: ${Math.max(0, (inc.expireTime - now) / 1000).toFixed(1)}s`;
            cdEl.className = 'text-[8px] text-cyan-300 font-mono';
          }
        }
        const cursor = document.getElementById('qteBarCursor');
        if (cursor) {
          const pct = Math.max(0, Math.min(96, (1 - Math.max(-0.3, Math.min(1, ratio))) * 74));
          cursor.style.marginLeft = `${pct}%`;
        }

        // Missed entirely (Shuttle landed before player pressed Defense) -> 【Miss 破防】!
        if (!GameState.paused && now > inc.expireTime) {
          if (GameState.tutorialStep === 3) {
            handleDefenseInput({ key: '挡网', zoneRead: 'front', cost: 1, nextY: 0.62 });
          } else {
            GameState.perfectParryStreak = 0;
            addPlayerPosture(38);
            SoundEngine.playHit('miss');
            SoundEngine.triggerShake('extreme', 'rgba(244, 63, 94, 0.55)');
            spawnParticles(inc.targetX, inc.targetY, '#f43f5e', 28);
            spawnFloatingText(inc.targetX, inc.targetY - 0.05, '💔 MISS 破防! 自身破绽+38', '#f43f5e');
            showCanvasBanner('💔 【Miss 破防】未及时接球!', '球直接落地丢分，自身破绽条暴涨 +38！', '#f43f5e');
            scorePoint('ai', `Miss破防未接住对手的【${inc.name}】`);
          }
        } else {
          ctx.save();
          const threatR = inc.threatPx || (inc.isSmash ? 26 : 42);
          const ringColor = inc.isSoftBall ? '#fbbf24' : (inc.isSmash ? '#f43f5e' : '#f59e0b');

          // Outer spatial reach zone ellipse
          ctx.beginPath();
          ctx.ellipse(tPt.x, tPt.y, threatR * 1.15, threatR * 0.58, 0, 0, Math.PI * 2);
          ctx.fillStyle = inReach
            ? 'rgba(245, 158, 11, 0.25)'
            : 'rgba(244, 63, 94, 0.22)';
          ctx.fill();
          ctx.lineWidth = 4;
          ctx.strokeStyle = '#0f0f0f';
          ctx.stroke();
          ctx.lineWidth = inReach ? 2.5 : 2.0;
          ctx.strokeStyle = inReach ? '#fbbf24' : ringColor;
          ctx.stroke();

          // Fixed Golden Perfect Anchor Inner Ring
          const perfectAnchorR = Math.max(11, threatR * 0.48);
          ctx.beginPath();
          ctx.arc(tPt.x, tPt.y - 6, perfectAnchorR, 0, Math.PI * 2);
          ctx.strokeStyle = isPerfectWindowNow ? '#ffffff' : 'rgba(251, 191, 36, 0.85)';
          ctx.lineWidth = isPerfectWindowNow ? 5.0 : 2.4;
          if (isPerfectWindowNow) {
            ctx.shadowColor = '#fde047';
            ctx.shadowBlur = 0;
          }
          ctx.stroke();
          ctx.shadowBlur = 0;

          // High-Speed Shrinking QTE Ring (Expedition 33 style)
          const shrinkR = Math.max(6, perfectAnchorR + Math.max(-0.18, ratio) * threatR * 1.45);
          ctx.beginPath();
          ctx.arc(tPt.x, tPt.y - 6, shrinkR, 0, Math.PI * 2);
          ctx.strokeStyle = '#0f0f0f';
          ctx.lineWidth = 6.0;
          ctx.stroke();
          ctx.strokeStyle = isPerfectWindowNow ? '#fde047' : ringColor;
          ctx.lineWidth = isPerfectWindowNow ? 3.8 : 2.6;
          ctx.stroke();

          if (!inReach) {
            ctx.setLineDash([4, 4]);
            ctx.strokeStyle = 'rgba(251, 191, 36, 0.82)';
            ctx.lineWidth = 2.0;
            ctx.beginPath();
            ctx.moveTo(pPt.x, pPt.y - 10);
            ctx.lineTo(tPt.x, tPt.y - 6);
            ctx.stroke();
            ctx.setLineDash([]);
          }

          ctx.fillStyle = isPerfectWindowNow ? '#fde047' : (inReach ? '#fef08a' : '#fda4af');
          ctx.font = 'italic 900 11px "Noto Serif SC", serif';
          ctx.textAlign = 'center';
          ctx.shadowColor = '#000';
          ctx.shadowBlur = 0;
          const needRight = (inc.targetX - GameState.playerVisual.x) >= -0.02;
          const handHint = needRight ? '👉右推【正手接杀】' : '👈左推【反手接杀(窗口-20%)】';
          const zGateHint = GameState.shuttle.z >= 0.30 ? ` [高空Z=${GameState.shuttle.z.toFixed(2)}待下落]` : '';
          ctx.fillText(
            inc.isSoftBall
              ? '⚡ 软球破绽! 按【中国跳/马来步】或缩圈完美弹反!'
              : (inReach ? (isPerfectWindowNow ? `⚔️ ${handHint} · 完美弹反瞬间!` : `🛡️ ${handHint}${zGateHint}`) : `🏃 跑进圈 + ${handHint}!`),
            tPt.x,
            tPt.y - threatR - 14
          );
          ctx.restore();
        }
      }

      // 6. Player Featherblade 2D Composite Skeletal Rig + Featherblade Posture Bar
      drawBadmintonStickman(ctx, pPt.x, pPt.y, pPt.scale * 1.15, {
        isPlayer: true,
        visObj: GameState.playerVisual,
        color: hero.color,
        poseType: GameState.playerVisual.poseType,
        swing: GameState.playerVisual.swingAnim,
        swingType: GameState.playerVisual.swingType,
        jump: GameState.playerVisual.jumpHeight,
        landingCrouch: GameState.playerVisual.landingCrouch,
        impactSpark: GameState.playerVisual.impactSpark,
        stride: GameState.playerVisual.stridePhase,
        moving: Math.hypot(GameState.playerVisual.vx, GameState.playerVisual.vy) > 0.08 ||
                GameState.playerVisual.moveElapsed < GameState.playerVisual.moveDuration,
        hand: GameState.pHand,
        cog: GameState.pCog,
        postureZero: GameState.playerStunTimer > 0,
        frameFactor
      });

      drawFeatherbladePostureBar(
        ctx,
        pPt.x,
        pPt.y + 18,
        126,
        8,
        GameState.playerPosture,
        `${hero.name} 破绽`,
        GameState.playerStunTimer > 0,
        false
      );

      // 6.5 Finisher Interactive Target Reticle on Stunned AI
      if (GameState.phase === 'break_finisher') {
        ctx.save();
        const pulseR = 26 + Math.sin(now * 0.015) * 6;
        ctx.translate(aiPt.x, aiPt.y - 26);
        ctx.strokeStyle = '#0f0f0f';
        ctx.lineWidth = 6;
        ctx.beginPath();
        ctx.arc(0, 0, pulseR, 0, Math.PI * 2);
        ctx.stroke();

        ctx.strokeStyle = '#ef4444';
        ctx.lineWidth = 3.2;
        ctx.shadowColor = '#ef4444';
        ctx.shadowBlur = 0;
        ctx.beginPath();
        ctx.arc(0, 0, pulseR, 0, Math.PI * 2);
        ctx.stroke();

        ctx.font = 'italic 900 26px "Noto Serif SC", serif';
        ctx.fillStyle = '#fef08a';
        ctx.textAlign = 'center';
        ctx.fillText('制胜扣杀', 0, 9);
        ctx.restore();
      }

      // 7. 2D Pseudo-3D Spinning Shuttlecock + Multi-Layer Glow & Particle Trail + Shockwave Mach Cone + Squash Deformation
      if (GameState.shuttle.inFlight && !GameState.paused) {
        const sh = GameState.shuttle;
        const effFactor = (dtMs * GameState.timeScale) / 16.67;
        const dragSlowdown = sh.trajType === 'drop' && sh.progress > 0.45
          ? 0.52
          : (sh.trajType === 'high' && sh.progress > 0.68 ? 0.72 : 1.0);
        sh.progress = Math.min(1, sh.progress + sh.speed * dragSlowdown * effFactor);

        if (sh.squashTimer > 0) {
          sh.squashTimer = Math.max(0, sh.squashTimer - dtMs);
        }

        const pos3D = evaluateShuttle3D(sh, sh.progress);
        const prevX = sh.x;
        const prevY = sh.y;
        sh.x = pos3D.cx;
        sh.y = pos3D.cy;
        sh.z = pos3D.z;

        if (sh.spinType && GameState.phase === 'ai_incoming' && GameState.incomingShot) {
          GameState.incomingShot.targetX = sh.x;
        }

        const groundPt = projectCourt(sh.x, sh.y, w, h);
        const airY = groundPt.y - sh.z * h * 0.58;
        const targetPt = projectCourt(sh.targetX, sh.targetY, w, h);

        const perspScale = groundPt.scale;
        const shuttleRadius = (4.8 + sh.z * 5.6) * (0.80 + perspScale * 0.25);
        const shadowRx = (5.5 + sh.z * 20.0) * perspScale;
        const shadowRy = (2.6 + sh.z * 9.0) * perspScale;
        const shadowAlpha = Math.max(0.08, 0.58 * (1 - sh.z * 0.80));

        // 1. 【3D 旋转视觉 (Spin)】：根据球路更新 spinSpeed 与 spinAngle
        if (sh.trajType === 'smash' || sh.trajType === 'flat') {
          sh.spinSpeed = 0.48;
          sh.spinAngle += sh.spinSpeed * effFactor;
        } else if (sh.trajType === 'high') {
          // 高远球：spinSpeed 先快后慢，飞到最高点时球头偏转，下落时球头再次朝下
          sh.spinSpeed = 0.30 * (1 - sh.progress * 0.68);
          sh.spinAngle += sh.spinSpeed * effFactor;
        } else {
          sh.spinSpeed = 0.22 * (1 - sh.progress * 0.5);
          sh.spinAngle += sh.spinSpeed * effFactor;
        }

        const trailMaxLen = sh.trajType === 'smash' ? 22 : 15;
        sh.trail.push({ x: groundPt.x, y: airY, r: shuttleRadius });
        if (sh.trail.length > trailMaxLen) sh.trail.shift();

        // 2. 【高质感轨迹粒子生成 (Glow + Particle Dissipation)】：高画质上限 60，流畅模式降为 20
        const maxTrailCap = GameState.qualityMode === 'smooth' ? 20 : 60;
        while (GameState.trailParticles.length >= maxTrailCap) {
          GameState.trailParticles.shift();
        }
        const tpColor = sh.trajType === 'smash' ? '#f43f5e' : (sh.trajType === 'high' ? '#2dd4bf' : '#c084fc');
        GameState.trailParticles.push({
          x: groundPt.x + (Math.random() - 0.5) * 6,
          y: airY + (Math.random() - 0.5) * 6,
          vx: (Math.random() - 0.5) * (sh.trajType === 'high' ? 1.4 : 0.6),
          vy: sh.trajType === 'drop' ? (0.8 + Math.random() * 0.8) : ((Math.random() - 0.5) * 0.9),
          size: sh.trajType === 'smash' ? 3.2 : 2.5,
          color: tpColor,
          isFeather: sh.trajType === 'high',
          life: 1.0
        });

        if (sh.trajType === 'smash') {
          sh.ghosts.push({ x: groundPt.x, y: airY, r: shuttleRadius });
          if (sh.ghosts.length > 9) sh.ghosts.shift();
        }

        ctx.save();
        // Ground Shadow
        ctx.fillStyle = `rgba(0, 0, 0, ${shadowAlpha.toFixed(2)})`;
        ctx.beginPath();
        ctx.ellipse(groundPt.x, groundPt.y, shadowRx, shadowRy, 0, 0, Math.PI * 2);
        ctx.fill();

        // Multi-Layer Glow Ribbon Trail (多层光晕轨迹)
        if (sh.trail.length >= 2) {
          const glowCol = sh.spinType ? '#38bdf8' : (sh.trajType === 'smash' ? '#ef4444' : (sh.trajType === 'high' ? '#10b981' : '#c084fc'));
          ctx.save();
          ctx.shadowColor = glowCol;
          ctx.shadowBlur = GameState.qualityMode === 'smooth' ? 0 : (sh.trajType === 'smash' ? 16 : 10);
          for (let i = 1; i < sh.trail.length; i++) {
            const tRatio = i / sh.trail.length;
            const p0 = sh.trail[i - 1];
            const p1 = sh.trail[i];
            const spiralOffset = sh.spinType ? Math.sin(i * 1.35 + now * 0.025) * 6.5 * (1 - tRatio * 0.3) : 0;
            const dropArc = sh.trajType === 'drop' ? Math.sin(tRatio * Math.PI) * 3.5 : 0;

            // Outer Glow Layer
            ctx.beginPath();
            ctx.moveTo(p0.x + spiralOffset, p0.y + dropArc);
            ctx.lineTo(p1.x - spiralOffset, p1.y + dropArc);
            ctx.strokeStyle = glowCol;
            ctx.globalAlpha = tRatio * 0.55;
            ctx.lineWidth = (sh.trajType === 'smash' ? 13.0 : 8.0) * tRatio;
            ctx.lineCap = 'round';
            ctx.stroke();

            // Inner Sharp Core Layer
            ctx.beginPath();
            ctx.moveTo(p0.x + spiralOffset * 0.5, p0.y + dropArc);
            ctx.lineTo(p1.x - spiralOffset * 0.5, p1.y + dropArc);
            ctx.strokeStyle = '#ffffff';
            ctx.globalAlpha = tRatio * 0.85;
            ctx.lineWidth = (sh.trajType === 'smash' ? 4.2 : 2.4) * tRatio;
            ctx.stroke();
          }
          ctx.restore();
        }

        // 3 Smash Afterimages
        if (sh.trajType === 'smash' && sh.ghosts.length >= 3) {
          const ghostAlphaLevels = [0.60, 0.36, 0.16];
          for (let g = 0; g < 3; g++) {
            const idx = Math.max(0, sh.ghosts.length - 1 - (g + 1) * 2);
            const gp = sh.ghosts[idx];
            if (gp) {
              ctx.save();
              ctx.globalAlpha = ghostAlphaLevels[g];
              ctx.beginPath();
              ctx.arc(gp.x, gp.y, gp.r * (0.90 - g * 0.12), 0, Math.PI * 2);
              ctx.fillStyle = '#f43f5e';
              ctx.fill();
              ctx.restore();
            }
          }
        }

        // Pseudo-3D Rotating Shuttlecock + Shockwave Mach Cone + Impact Squash Deformation
        const prevGround = projectCourt(prevX, prevY, w, h);
        const prevAirY = prevGround.y - sh.z * h * 0.58;
        const flightAngle = Math.atan2(airY - prevAirY, groundPt.x - prevGround.x) || (sh.targetY > sh.startY ? Math.PI / 2 : -Math.PI / 2);

        ctx.save();
        ctx.translate(groundPt.x, airY);

        // 3. 【空气扰动视觉：音爆锥 (Shockwave Mach Cone)】：当球速极快(如杀球)时在球头正前方绘制半透明白色音爆锥
        if (sh.trajType === 'smash' || sh.speed >= 0.052) {
          ctx.save();
          ctx.rotate(flightAngle);
          const coneGrad = ctx.createLinearGradient(shuttleRadius * 1.8, 0, -shuttleRadius * 2.2, 0);
          coneGrad.addColorStop(0, 'rgba(255, 255, 255, 0.78)');
          coneGrad.addColorStop(0.45, 'rgba(254, 240, 138, 0.32)');
          coneGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
          ctx.fillStyle = coneGrad;
          ctx.beginPath();
          ctx.moveTo(shuttleRadius * 1.9, 0);
          ctx.quadraticCurveTo(0, -shuttleRadius * 2.1, -shuttleRadius * 2.4, -shuttleRadius * 2.8);
          ctx.lineTo(-shuttleRadius * 1.6, 0);
          ctx.lineTo(-shuttleRadius * 2.4, shuttleRadius * 2.8);
          ctx.quadraticCurveTo(0, shuttleRadius * 2.1, shuttleRadius * 1.9, 0);
          ctx.closePath();
          ctx.fill();
          ctx.restore();
        }

        // Apply 2D Pseudo-3D Spin Rotation & Racket-Shuttle Squash Deformation
        // 杀球/平抽球头朝向飞行下方/前方且剧烈旋转；高远球在顶点偏转、下落时球头朝下
        const headOrient = (sh.trajType === 'smash' || sh.progress > 0.55)
          ? (flightAngle + Math.sin(sh.spinAngle) * 0.22)
          : (flightAngle + sh.spinAngle);
        ctx.rotate(headOrient);

        // 【球拍与球的交互形变】：击球特写初段绘制羽毛球被拍线“压扁”的椭圆微小形变
        if (sh.squashTimer > 0 && GameState.camState.zoom > 1.08) {
          ctx.scale(0.64, 1.38);
        }

        // Conical Feather Skirt (羽毛裙锥形开口朝向飞行反方向 -X)
        ctx.beginPath();
        ctx.moveTo(0, -shuttleRadius * 0.55);
        ctx.lineTo(-shuttleRadius * 2.1, -shuttleRadius * 1.25);
        ctx.lineTo(-shuttleRadius * 1.75, 0);
        ctx.lineTo(-shuttleRadius * 2.1, shuttleRadius * 1.25);
        ctx.lineTo(0, shuttleRadius * 0.55);
        ctx.closePath();
        ctx.fillStyle = 'rgba(248, 250, 252, 0.92)';
        ctx.fill();
        ctx.lineWidth = 2.5;
        ctx.strokeStyle = '#0f0f0f';
        ctx.stroke();

        // Cork Head (球头)
        const shGrad = ctx.createRadialGradient(2, -1, 1, 2, 0, shuttleRadius);
        shGrad.addColorStop(0, '#ffffff');
        shGrad.addColorStop(0.6, '#fef08a');
        shGrad.addColorStop(1, sh.trajType === 'smash' ? '#f43f5e' : '#f59e0b');
        ctx.fillStyle = shGrad;
        ctx.strokeStyle = '#0f0f0f';
        ctx.lineWidth = 3.5;
        ctx.beginPath();
        ctx.arc(shuttleRadius * 0.35, 0, shuttleRadius * 0.85, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
        ctx.restore();
        ctx.restore();

        if (sh.progress >= 1 && !sh.landed) {
          sh.landed = true;
          spawnParticles(sh.targetX, sh.targetY, '#fbbf24', 12);
          if (GameState.phase !== 'ai_incoming') {
            sh.inFlight = false;
          }
        }
      }

      // Render Dissipating Trail Particles (发光消散轨迹微粒)
      for (let i = GameState.trailParticles.length - 1; i >= 0; i--) {
        const tp = GameState.trailParticles[i];
        tp.x += tp.vx * frameFactor;
        tp.y += tp.vy * frameFactor;
        ctx.save();
        ctx.globalAlpha = Math.max(0, tp.life * 0.85);
        ctx.fillStyle = tp.color;
        ctx.shadowColor = tp.color;
        ctx.shadowBlur = GameState.qualityMode === 'smooth' ? 0 : 8;
        ctx.beginPath();
        if (tp.isFeather) {
          ctx.ellipse(tp.x, tp.y, tp.size * 1.5, tp.size * 0.6, tp.life * 2, 0, Math.PI * 2);
        } else {
          ctx.arc(tp.x, tp.y, tp.size * tp.life, 0, Math.PI * 2);
        }
        ctx.fill();
        ctx.restore();
        tp.life -= 0.055 * frameFactor;
        if (tp.life <= 0) GameState.trailParticles.splice(i, 1);
      }

      // 7.5 Zeus Lightning Bolt Effect
      if (GameState.lightningBolt && GameState.lightningBolt.life > 0) {
        const lb = GameState.lightningBolt;
        ctx.save();
        ctx.globalAlpha = Math.min(1, lb.life * 1.4);
        ctx.strokeStyle = '#fde047';
        ctx.shadowColor = '#f59e0b';
        ctx.shadowBlur = 0;
        ctx.lineWidth = 6;
        ctx.beginPath();
        lb.points.forEach((pt, idx) => {
          const p = projectCourt(pt.nx, pt.ny, w, h);
          const py = idx === 0 ? 0 : p.y;
          if (idx === 0) ctx.moveTo(p.x, py);
          else ctx.lineTo(p.x, py);
        });
        ctx.stroke();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 2.5;
        ctx.stroke();
        ctx.restore();
      }

      // 8. Right-Hand Hold-Swipe Real-Time Trajectory Preview Curve
      if (GameState.pressSwipe.active && GameState.pressSwipe.shot) {
        const s = GameState.pressSwipe.shot;
        const dy = GameState.pressSwipe.deltaY;
        const pct = Math.round(GameState.pressSwipe.chargePct * 100);
        let arcMsg = `⚡ 蓄力 ${pct}% · 标准弧线 (松手出球)`;
        let arcCol = '#fbbf24';
        if (dy < -40) { arcMsg = `↗️ 拉高深球弧线 (${Math.round(dy)}px)`; arcCol = '#4ade80'; }
        if (dy < -95) { arcMsg = `⚠️ 上滑过猛 (${Math.round(dy)}px) 小心底线出界!`; arcCol = '#fb7185'; }
        if (dy > 40)  { arcMsg = `↘️ 压平快攻弧线 (+${Math.round(dy)}px)`; arcCol = '#f59e0b'; }
        if (dy > 95)  { arcMsg = `⚠️ 下滑过猛 (+${Math.round(dy)}px) 小心下网!`; arcCol = '#fb7185'; }

        const previewTx = GameState.aiVisual.x < 0.5 ? 0.74 : 0.26;
        let previewTy = s.trajType === 'drop' ? 0.36 : (s.trajType === 'high' ? 0.14 : 0.22);
        if (dy < -40) previewTy = Math.max(0.08, previewTy - 0.06);
        if (dy > 40)  previewTy = Math.min(0.44, previewTy + 0.06);
        const destPt = projectCourt(previewTx, previewTy, w, h);
        const midX = (pPt.x + destPt.x) * 0.5;
        const archLift = (s.trajType === 'high' ? 115 : (s.trajType === 'smash' ? 28 : 65)) - dy * 0.45;
        const midY = Math.min(pPt.y, destPt.y) - Math.max(15, archLift);

        ctx.save();
        ctx.setLineDash([6, 4]);
        ctx.lineWidth = 2.8;
        ctx.strokeStyle = arcCol;
        ctx.beginPath();
        ctx.moveTo(pPt.x, pPt.y - 28);
        ctx.quadraticCurveTo(midX, midY, destPt.x, destPt.y);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.beginPath();
        ctx.arc(destPt.x, destPt.y, 7, 0, Math.PI * 2);
        ctx.fillStyle = arcCol;
        ctx.fill();

        ctx.font = 'italic 800 13px "Noto Serif SC", serif';
        ctx.fillStyle = arcCol;
        ctx.textAlign = 'center';
        ctx.shadowColor = '#000';
        ctx.shadowBlur = 0;
        ctx.fillText(arcMsg, pPt.x, pPt.y - 68);
        ctx.restore();
      }

      // 9. Task 3: High-Contrast Polygon Shard Particles with Gravity & Rotation
      for (let i = GameState.particles.length - 1; i >= 0; i--) {
        const pt = GameState.particles[i];
        pt.vy += (pt.gravity || 0.24) * frameFactor;
        pt.px = (pt.px || 0) + pt.vx * frameFactor;
        pt.py = (pt.py || 0) + pt.vy * frameFactor;
        pt.rot = (pt.rot || 0) + (pt.vRot || 0.2) * frameFactor;

        const proj = projectCourt(pt.x, pt.y, w, h);
        ctx.save();
        ctx.globalAlpha = Math.max(0, pt.life);
        ctx.translate(proj.x + pt.px * 4.2, proj.y - 18 + pt.py * 4.2);
        ctx.rotate(pt.rot);
        ctx.scale(Math.max(0.2, pt.life), Math.max(0.2, pt.life));

        const r = pt.size;
        const sides = pt.sides || 3;
        ctx.beginPath();
        for (let s = 0; s < sides; s++) {
          const a = (s / sides) * Math.PI * 2;
          const sx = Math.cos(a) * r;
          const sy = Math.sin(a) * r;
          if (s === 0) ctx.moveTo(sx, sy);
          else ctx.lineTo(sx, sy);
        }
        ctx.closePath();
        ctx.fillStyle = pt.color;
        ctx.fill();
        ctx.lineWidth = 2.0;
        ctx.strokeStyle = '#0f0f0f';
        ctx.stroke();
        ctx.restore();

        pt.life -= 0.042 * frameFactor;
        if (pt.life <= 0) GameState.particles.splice(i, 1);
      }

      // 【维度二·任务3：击球特效三段分级光圈 (白圈 / 金光圈 / 制胜红圈)】
      for (let i = GameState.impactRings.length - 1; i >= 0; i--) {
        const ir = GameState.impactRings[i];
        const proj = projectCourt(ir.x, ir.y, w, h);
        const curR = (1 - ir.life) * ir.maxR + 6;
        ctx.save();
        ctx.globalAlpha = Math.max(0, ir.life);
        ctx.strokeStyle = ir.color;
        ctx.lineWidth = ir.width * ir.life;
        ctx.shadowColor = ir.color;
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.arc(proj.x, proj.y - 18, curR, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
        ir.life -= 0.065 * frameFactor;
        if (ir.life <= 0) GameState.impactRings.splice(i, 1);
      }

      // Floating Combat Texts
      for (let i = GameState.floatingTexts.length - 1; i >= 0; i--) {
        const ft = GameState.floatingTexts[i];
        const proj = projectCourt(ft.x, ft.y, w, h);
        ctx.save();
        ctx.globalAlpha = Math.max(0, ft.life);
        ctx.font = 'italic 900 14px "Cinzel", "Noto Serif SC", serif';
        ctx.strokeStyle = '#0f0f0f';
        ctx.lineWidth = 4;
        ctx.textAlign = 'center';
        const ty = proj.y - 34 - (1 - ft.life) * 28;
        ctx.strokeText(ft.text, proj.x, ty);
        ctx.fillStyle = ft.color;
        ctx.fillText(ft.text, proj.x, ty);
        ctx.restore();
        ft.life -= 0.024 * frameFactor;
        if (ft.life <= 0) GameState.floatingTexts.splice(i, 1);
      }

      // Reset transform so UI overlays, banners, and vignette are unaffected by camera zoom!
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // 10. 局部清透高光环（移除全屏泛白遮罩，保持画面通透清晰）
      if (GameState.bloomAlpha > 0.01) {
        ctx.save();
        const bloomPt = projectCourt(GameState.playerVisual.x, GameState.playerVisual.y, w, h);
        const bloomGrad = ctx.createRadialGradient(
          bloomPt.x, bloomPt.y - 24, 4,
          bloomPt.x, bloomPt.y - 24, 95
        );
        bloomGrad.addColorStop(0, `rgba(254, 240, 138, ${(GameState.bloomAlpha * 0.35).toFixed(2)})`);
        bloomGrad.addColorStop(1, 'rgba(245, 158, 11, 0)');
        ctx.fillStyle = bloomGrad;
        ctx.beginPath();
        ctx.arc(bloomPt.x, bloomPt.y - 24, 95, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      // 11. Task 4: Blood-Red Breathing Vignette when AI Posture Overflows (>= 85 or 【重心崩溃】)
      if (GameState.aiPosture >= 85 || GameState.phase === 'break_finisher' || GameState.playerPosture >= 85) {
        ctx.save();
        const pulse = 0.42 + 0.28 * Math.sin(now * 0.010);
        const vigGrad = ctx.createRadialGradient(w * 0.5, h * 0.5, Math.min(w, h) * 0.28, w * 0.5, h * 0.5, Math.max(w, h) * 0.72);
        vigGrad.addColorStop(0, 'rgba(0, 0, 0, 0)');
        vigGrad.addColorStop(0.65, `rgba(153, 27, 27, ${(pulse * 0.35).toFixed(2)})`);
        vigGrad.addColorStop(1, `rgba(220, 38, 38, ${(pulse * 0.78).toFixed(2)})`);
        ctx.fillStyle = vigGrad;
        ctx.fillRect(0, 0, w, h);
        ctx.restore();
      }

      // 12. Canvas-Internal Banner & Tutorial Prompt
      if (GameState.tutorialStep > 0) {
        const tutMsgs = {
          1: '🎓【引导 1/4】拖动左下角【虚拟摇杆】体验赛场神行步伐（或直接点击发球键）',
          2: '🎓【引导 2/4】点击右下角【贴网短发球】增加对手破绽值！',
          3: '🎓【引导 3/4】在缩圈重合瞬间(<100ms)点击【接球/防守】触发 完美弹反 暴涨AI破绽！',
          4: '🎓【引导 4/4】点击任意进攻键打满 AI 破绽(100)，触发2秒硬直并点击屏幕完成【制胜扣杀】！'
        };
        ctx.save();
        ctx.fillStyle = 'rgba(18, 9, 32, 0.92)';
        ctx.strokeStyle = '#f59e0b';
        ctx.lineWidth = 2.0;
        const bw = Math.min(w - 24, 620);
        ctx.beginPath();
        ctx.roundRect((w - bw) / 2, 8, bw, 28, 8);
        ctx.fill();
        ctx.stroke();
        ctx.fillStyle = '#fef3c7';
        ctx.font = 'italic 700 12px "Noto Serif SC", serif';
        ctx.textAlign = 'center';
        ctx.fillText(tutMsgs[GameState.tutorialStep] || '', w / 2, 26);
        ctx.restore();
      }

      if (GameState.canvasBanner.life > 0) {
        const cb = GameState.canvasBanner;
        ctx.save();
        ctx.globalAlpha = Math.min(1, cb.life * 1.4);
        ctx.font = 'italic 900 19px "Cinzel", "Noto Serif SC", serif';
        ctx.strokeStyle = '#0f0f0f';
        ctx.lineWidth = 5;
        ctx.textAlign = 'center';
        ctx.strokeText(cb.title, w / 2, h * 0.34);
        ctx.fillStyle = cb.color;
        ctx.fillText(cb.title, w / 2, h * 0.34);
        if (cb.sub) {
          ctx.font = 'italic 700 12px "Noto Serif SC", serif';
          ctx.strokeWidth = 3;
          ctx.strokeText(cb.sub, w / 2, h * 0.34 + 21);
          ctx.fillStyle = '#fef3c7';
          ctx.fillText(cb.sub, w / 2, h * 0.34 + 21);
        }
        ctx.restore();
        cb.life -= 0.022 * frameFactor;
      }

      // 胜利金色聚光灯照射特效 (Victory Golden Spotlight) & 惜败红边特效
      if (GameState.victorySpotlightActive) {
        ctx.save();
        ctx.globalCompositeOperation = 'screen';
        const spotX = w * 0.5 + Math.sin(now * 0.0025) * (w * 0.14);
        const spotGrad = ctx.createLinearGradient(spotX, 0, spotX, h);
        spotGrad.addColorStop(0, 'rgba(253, 224, 71, 0.55)');
        spotGrad.addColorStop(0.6, 'rgba(245, 158, 11, 0.24)');
        spotGrad.addColorStop(1, 'rgba(245, 158, 11, 0.05)');
        ctx.fillStyle = spotGrad;
        ctx.beginPath();
        ctx.moveTo(spotX - 45, 0);
        ctx.lineTo(spotX + 45, 0);
        ctx.lineTo(spotX + 210, h);
        ctx.lineTo(spotX - 210, h);
        ctx.closePath();
        ctx.fill();
        ctx.restore();
      }

      // 保持全域画面通透锐利，不再叠加全屏暗雾遮罩

      rafId = requestAnimationFrame(renderCourtLoop);
    }

    // 3D Q-Version Volumetric Capsule Limb & Bone Renderer with Specular Highlight + IK Bone Line
    function drawTaperedLimb(ctx, x1, y1, x2, y2, w1, w2, fillStyle, curveBend = 2.0, boneCoreColor = null) {
      const dx = x2 - x1;
      const dy = y2 - y1;
      const len = Math.hypot(dx, dy) || 1;
      const nx = -dy / len;
      const ny = dx / len;
      const midX = (x1 + x2) * 0.5 + nx * curveBend;
      const midY = (y1 + y2) * 0.5 + ny * curveBend;
      const midW = (w1 + w2) * 0.56;

      ctx.beginPath();
      ctx.moveTo(x1 + nx * w1, y1 + ny * w1);
      ctx.quadraticCurveTo(midX + nx * midW, midY + ny * midW, x2 + nx * w2, y2 + ny * w2);
      ctx.arc(x2, y2, w2, Math.atan2(ny, nx), Math.atan2(-ny, -nx), false);
      ctx.quadraticCurveTo(midX - nx * midW, midY - ny * midW, x1 - nx * w1, y1 - ny * w1);
      ctx.arc(x1, y1, w1, Math.atan2(-ny, -nx), Math.atan2(ny, nx), false);
      ctx.closePath();
      ctx.fillStyle = fillStyle;
      ctx.fill();
      ctx.lineWidth = 3.2;
      ctx.strokeStyle = '#0f0f0f';
      ctx.lineJoin = 'round';
      ctx.stroke();

      // 3D Q-Version Cylindrical Specular Highlight Strip
      ctx.beginPath();
      ctx.moveTo(x1 + nx * (w1 * 0.35), y1 + ny * (w1 * 0.35));
      ctx.quadraticCurveTo(midX + nx * (midW * 0.35), midY + ny * (midW * 0.35), x2 + nx * (w2 * 0.35), y2 + ny * (w2 * 0.35));
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.32)';
      ctx.lineWidth = Math.max(1.2, (w1 + w2) * 0.22);
      ctx.lineCap = 'round';
      ctx.stroke();

      // Internal IK Bone Line & Joint Nodes
      if (boneCoreColor) {
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.strokeStyle = boneCoreColor;
        ctx.lineWidth = 1.4;
        ctx.stroke();
      }
    }

    function draw3DShoe(ctx, ax, ay, angleRad, isPrimaryColor, isTipToe = false) {
      ctx.save();
      ctx.translate(ax, ay);
      ctx.rotate(angleRad + (isTipToe ? 0.42 : 0));
      // 3D Q-Version Badminton Shoe
      ctx.beginPath();
      ctx.roundRect(-5, -3.5, 13, 6.8, [3, 5, 2, 2]);
      ctx.fillStyle = isPrimaryColor ? '#f8fafc' : '#cbd5e1';
      ctx.fill();
      ctx.lineWidth = 2.6;
      ctx.strokeStyle = '#0f0f0f';
      ctx.stroke();
      // Gum Rubber Golden Sole
      ctx.beginPath();
      ctx.moveTo(-5, 2.8);
      ctx.lineTo(8, 2.8);
      ctx.strokeStyle = '#f59e0b';
      ctx.lineWidth = 2.4;
      ctx.stroke();
      ctx.restore();
    }

    // ==================== 3D Q版羽毛球运动员 + 8节点真实骨骼IK + 8向步伐与5大击球动作重构 ====================
    function drawBadmintonStickman(ctx, x, y, scale, opts) {
      ctx.save();
      const nowMs = performance.now();
      const staggerShakeX = (!opts.isPlayer && GameState.aiStaggerTimer > 0) ? Math.sin(nowMs * 0.045) * 5.5 : 0;
      ctx.translate(x + staggerShakeX, y);
      const qScale = scale * 1.12; // 放大 3D Q版角色与骨骼细节
      ctx.scale(qScale, qScale);

      const visObj = opts.visObj || GameState.playerVisual;
      const isOffBalance = opts.isPlayer && (opts.cog < 35);
      const isInSmashRecovery = opts.isPlayer && GameState.playerRecoveryTimer > 0 && GameState.recoveryType === 'smash_crouch';
      const isTurnStun = opts.isPlayer && GameState.turnaroundTimer > 0;
      const handDir = opts.hand === 'backhand' ? -1 : 1;
      const swing = opts.swing || 0;
      const swingType = opts.swingType || 'clear';
      const isSmashAir = opts.jump > 0.08 || (opts.poseType === 'jump_smash' && swing > 0.12) || (swingType === 'smash' && swing > 0.22);

      // 1. 地面光环与阴影
      ctx.beginPath();
      ctx.ellipse(0, 4, 24, 8.5, 0, 0, Math.PI * 2);
      ctx.fillStyle = (opts.postureZero || isInSmashRecovery)
        ? 'rgba(220, 38, 38, 0.52)'
        : (opts.isPlayer ? 'rgba(16, 185, 129, 0.26)' : 'rgba(244, 63, 94, 0.25)');
      ctx.fill();
      ctx.lineWidth = isInSmashRecovery ? 3.5 : 2.2;
      ctx.strokeStyle = (opts.postureZero || isInSmashRecovery) ? '#ef4444' : (opts.isPlayer ? '#f59e0b' : '#f43f5e');
      ctx.stroke();

      ctx.fillStyle = 'rgba(0, 0, 0, 0.55)';
      ctx.beginPath();
      ctx.ellipse(0, 4, 17 * (1 - opts.jump * 0.32), 6 * (1 - opts.jump * 0.32), 0, 0, Math.PI * 2);
      ctx.fill();

      const recoverySink = isInSmashRecovery ? 8.5 : 0;
      const crouchDrop = (opts.landingCrouch || 0) * 10 + recoverySink;
      const airOffset = -opts.jump * 36 + crouchDrop;
      ctx.translate(0, airOffset);

      // 起跳重杀与冲刺残影
      if (opts.isPlayer && (isSmashAir || (visObj.smashAfterimages && visObj.smashAfterimages.length > 0) || GameState.dashTimer > 0)) {
        const ghosts = (visObj.smashAfterimages && visObj.smashAfterimages.length)
          ? visObj.smashAfterimages
          : [
              { offsetX: -12 * handDir, offsetY: 11, alpha: 0.55 },
              { offsetX: -24 * handDir, offsetY: 22, alpha: 0.34 },
              { offsetX: -36 * handDir, offsetY: 33, alpha: 0.16 }
            ];
        ghosts.forEach((gh, idx) => {
          if (gh.alpha <= 0.02) return;
          ctx.save();
          ctx.globalAlpha = Math.max(0, gh.alpha);
          ctx.translate(gh.offsetX, gh.offsetY);
          ctx.fillStyle = idx % 2 === 0 ? 'rgba(244, 63, 94, 0.72)' : 'rgba(56, 189, 248, 0.65)';
          ctx.beginPath();
          ctx.arc(0, -52, 10, 0, Math.PI * 2);
          ctx.fill();
          ctx.beginPath();
          ctx.roundRect(-10, -40, 20, 22, 8);
          ctx.fill();
          ctx.restore();
        });
      }

      if (isOffBalance || opts.postureZero || (!opts.isPlayer && GameState.aiStaggerTimer > 0)) {
        ctx.rotate((opts.postureZero ? 16 : -11) * Math.PI / 180);
      }

      // ==================== 计算 8 节点骨骼目标姿态 (IK Target Nodes) ====================
      const vx = opts.isPlayer ? (visObj.vx || GameState.joyVx || 0) : ((visObj.targetX - visObj.x) * 8);
      const vy = opts.isPlayer ? (visObj.vy || GameState.joyVy || 0) : ((visObj.targetY - visObj.y) * 8);
      const walkPhase = opts.stride || 0;
      const idleBreath = Math.sin(nowMs * 0.006) * 1.4;

      // 初始标准微屈膝准备姿态 (8 Nodes: hip, leftKnee, leftAnkle, rightKnee, rightAnkle, leftShoulder, leftElbow, leftWrist, rightShoulder, rightElbow, rightWrist, head)
      const target = {
        hip:           { x: 0,             y: -20 + (opts.moving ? Math.sin(walkPhase) * 2.2 : idleBreath) },
        leftKnee:      { x: -9,            y: -10 },
        leftAnkle:     { x: -13,           y: 0 },
        rightKnee:     { x: 9,             y: -10 },
        rightAnkle:    { x: 13,            y: 0 },
        leftShoulder:  { x: -10 * handDir, y: -40 + idleBreath },
        leftElbow:     { x: -16 * handDir, y: -33 + idleBreath },
        leftWrist:     { x: -12 * handDir, y: -42 + idleBreath },
        rightShoulder: { x: 10 * handDir,  y: -40 + idleBreath },
        rightElbow:    { x: 16 * handDir,  y: -34 + idleBreath },
        rightWrist:    { x: 21 * handDir,  y: -46 + idleBreath },
        head:          { x: 0,             y: -55 + idleBreath },
        bellyArchX:    0,
        racketPitch:   -0.25 * handDir,
        tipToe:        false,
        footworkName:  '准备步'
      };

      // 【任务1：真实 8 向羽毛球步伐骨骼动态取样】
      if (opts.moving) {
        const isDiagonal = Math.abs(vx) > 0.45 && Math.abs(vy) > 0.45;
        if (isDiagonal) {
          if (vy < -0.45) {
            // ↖ / ↗ 左前/右前斜向大跨步（极限网前弓箭步）：前腿深弓跨出，后腿大幅拖拽几乎贴地，重心极低
            const dirSign = vx >= 0 ? 1 : -1;
            target.hip.x = dirSign * 5;
            target.hip.y = -14;
            if (dirSign > 0) {
              target.rightKnee  = { x: 22, y: -11 };
              target.rightAnkle = { x: 28, y: 1 };
              target.leftKnee   = { x: -12, y: -4 };
              target.leftAnkle  = { x: -23, y: 2 };
            } else {
              target.leftKnee   = { x: -22, y: -11 };
              target.leftAnkle  = { x: -28, y: 1 };
              target.rightKnee  = { x: 12, y: -4 };
              target.rightAnkle = { x: 23, y: 2 };
            }
            target.leftShoulder.x  += dirSign * 6;
            target.rightShoulder.x += dirSign * 6;
            target.head.x = dirSign * 10;
            target.head.y = -48;
            target.footworkName = dirSign > 0 ? '↗右网前大弓箭步' : '↖左网前大弓箭步';
          } else {
            // ↙ / ↘ 左后/右后斜向后退步（马来步/侧身大跨步后退）
            const dirSign = vx >= 0 ? 1 : -1;
            target.hip.x = dirSign * 4;
            target.hip.y = -17 + Math.sin(walkPhase) * 2;
            target.leftShoulder  = { x: -5 * handDir, y: -41 };
            target.rightShoulder = { x: 6 * handDir,  y: -39 };
            target.leftKnee   = { x: -14 + Math.sin(walkPhase) * 8, y: -9 };
            target.leftAnkle  = { x: vx * 18, y: 3 + Math.sin(walkPhase) * 5 };
            target.rightKnee  = { x: 14 - Math.sin(walkPhase) * 8, y: -8 };
            target.rightAnkle = { x: -vx * 12, y: 2 - Math.sin(walkPhase) * 5 };
            target.leftWrist  = { x: -16 * handDir, y: -58 };
            target.footworkName = dirSign > 0 ? '↘右后交叉跨步' : '↙左后马来步';
          }
        } else if (vy < -0.5) {
          // ↑ 向前移动（快速垫步上网）：脚尖点地，双脚高频交替小垫步，重心压在前脚
          target.tipToe = true;
          target.hip.y = -23;
          target.leftKnee   = { x: -8 + Math.sin(walkPhase) * 6,  y: -11 };
          target.leftAnkle  = { x: -10 + Math.sin(walkPhase) * 10, y: 0 };
          target.rightKnee  = { x: 8 + Math.cos(walkPhase) * 6,   y: -11 };
          target.rightAnkle = { x: 10 + Math.cos(walkPhase) * 10, y: 0 };
          target.head.y = -52;
          target.footworkName = '↑快速垫步上网';
        } else if (vy > 0.5) {
          // ↓ 向后移动（侧身交叉步/并步后退）：身体侧转，双脚前后交叉交替后退
          const cross = Math.sin(walkPhase);
          target.hip.y = -21;
          target.leftShoulder  = { x: -4 * handDir, y: -40 };
          target.rightShoulder = { x: 5 * handDir,  y: -40 };
          target.leftKnee   = { x: -6 + cross * 10, y: -10 };
          target.leftAnkle  = { x: -10 + cross * 14, y: 2 + Math.sin(walkPhase) * 6 };
          target.rightKnee  = { x: 6 - cross * 10,  y: -10 };
          target.rightAnkle = { x: 10 - cross * 14, y: 2 + Math.cos(walkPhase) * 6 };
          target.footworkName = '↓侧身交叉并步';
        } else if (vx > 0.5) {
          // → 向右移动（右滑步）：右腿先大步跨出，左腿快速滑步跟上
          target.hip.x = 4;
          target.hip.y = -18;
          target.rightKnee  = { x: 14 + Math.sin(walkPhase) * 5, y: -10 };
          target.rightAnkle = { x: 19 + Math.sin(walkPhase) * 8, y: 0 };
          target.leftKnee   = { x: -4 + Math.sin(walkPhase) * 4, y: -9 };
          target.leftAnkle  = { x: -5 + Math.sin(walkPhase) * 6, y: 1 };
          target.footworkName = '→右侧向滑步';
        } else if (vx < -0.5) {
          // ← 向左移动（左滑步）：左腿先大步跨出，右腿快速滑步跟上
          target.hip.x = -4;
          target.hip.y = -18;
          target.leftKnee   = { x: -14 + Math.sin(walkPhase) * 5, y: -10 };
          target.leftAnkle  = { x: -19 + Math.sin(walkPhase) * 8, y: 0 };
          target.rightKnee  = { x: 4 + Math.sin(walkPhase) * 4,   y: -9 };
          target.rightAnkle = { x: 5 + Math.sin(walkPhase) * 6,   y: 1 };
          target.footworkName = '←左侧向滑步';
        }
      }

      if (opts.isPlayer) {
        const fwLabel = document.getElementById('liveFootworkText');
        if (fwLabel) fwLabel.textContent = target.footworkName;
      }

      // 【任务2：世界级运动员 5 大核心击球姿态极度细节还原 (Clear / Smash / Drop / Net / Lift)】
      if (swing > 0.01) {
        const s = swing; // 1.0 (引拍蓄力) -> 0.5 (爆发击球) -> 0.0 (随挥收拍)
        if (swingType === 'clear' || swingType === 'high') {
          // 1.【高远球】：侧身极其明显（双肩侧对球网），左手高举指天，右手像拉满的巨弓，击球点极高
          target.leftShoulder  = { x: -4 * handDir, y: -42 };
          target.rightShoulder = { x: 5 * handDir,  y: -41 };
          target.leftElbow     = { x: -10 * handDir, y: -60 };
          target.leftWrist     = { x: -15 * handDir, y: -76 }; // 左手高举指天
          if (s > 0.52) {
            // 拉弓蓄力：右手肘后拉，拍头垂向后下方
            target.rightElbow = { x: -12 * handDir, y: -56 };
            target.rightWrist = { x: -20 * handDir, y: -46 };
            target.racketPitch = 1.15 * handDir;
            target.bellyArchX = -4 * handDir;
          } else {
            // 极高点击球与随挥
            target.rightElbow = { x: 14 * handDir, y: -64 };
            target.rightWrist = { x: 20 * handDir, y: -78 }; // 极高击球点
            target.racketPitch = -0.35 * handDir;
            target.bellyArchX = 3 * handDir;
          }
          target.head = { x: 5 * handDir, y: -56 };
        } else if (swingType === 'smash') {
          // 2.【杀球】：起跳后身体呈极限反弓（肚子挺出），双腿在空中向后收折，右臂猛烈下劈，落地深蹲
          target.hip.y = -30 - s * 10;
          target.leftShoulder  = { x: -5 * handDir, y: -44 - s * 6 };
          target.rightShoulder = { x: 7 * handDir,  y: -44 - s * 6 };
          target.leftElbow     = { x: -14 * handDir, y: -60 };
          target.leftWrist     = { x: -20 * handDir, y: -72 };
          // 空中双腿向后收折成C字反弓
          target.leftKnee   = { x: -8 * handDir,  y: -16 };
          target.leftAnkle  = { x: -18 * handDir, y: -22 };
          target.rightKnee  = { x: 4 * handDir,   y: -14 };
          target.rightAnkle = { x: -8 * handDir,  y: -17 };
          if (s > 0.50) {
            // 空中极限反弓挺腹蓄力
            target.bellyArchX = 8.5 * handDir;
            target.rightElbow = { x: -8 * handDir, y: -66 };
            target.rightWrist = { x: -18 * handDir, y: -58 };
            target.racketPitch = 1.25 * handDir;
          } else {
            // 猛烈收腹下劈鞭打
            target.bellyArchX = -5.5 * handDir;
            target.rightElbow = { x: 24 * handDir, y: -46 };
            target.rightWrist = { x: 32 * handDir, y: -28 };
            target.racketPitch = 0.55 * handDir;
          }
          target.head = { x: 6 * handDir, y: -58 - s * 4 };
        } else if (swingType === 'drop') {
          // 3.【吊球】：动作极其隐蔽，起手与高远球一样左手指天，身体甚至比高远球更直；最高点手腕突然“收力”和“包切”
          target.hip.x = 0;
          target.bellyArchX = 0; // 身体笔直极具欺骗性
          target.leftShoulder  = { x: -5 * handDir, y: -42 };
          target.rightShoulder = { x: 5 * handDir,  y: -42 };
          target.leftElbow     = { x: -10 * handDir, y: -60 };
          target.leftWrist     = { x: -15 * handDir, y: -75 };
          if (s > 0.48) {
            target.rightElbow = { x: -9 * handDir, y: -58 };
            target.rightWrist = { x: -16 * handDir, y: -50 };
            target.racketPitch = 0.95 * handDir;
          } else {
            // 最高点手腕突然收力内扣包切
            target.rightElbow = { x: 10 * handDir, y: -65 };
            target.rightWrist = { x: 5 * handDir,  y: -55 }; // 手腕内扣收力
            target.racketPitch = 0.42 * handDir;
          }
          target.head = { x: 2 * handDir, y: -56 };
        } else if (swingType === 'net' || swingType === 'lunge') {
          // 4.【搓球/放网】：拇指食指细腻发力（极小动作），双腿呈极限“网前大弓箭步”，前腿深弯，后腿几乎贴地，身体向网带前倾
          target.hip = { x: 8 * handDir, y: -13 }; // 重心极低
          target.leftKnee   = { x: -12 * handDir, y: -4 };
          target.leftAnkle  = { x: -24 * handDir, y: 2 };  // 后腿几乎贴地拖曳
          target.rightKnee  = { x: 25 * handDir,  y: -10 };
          target.rightAnkle = { x: 32 * handDir,  y: 1 };  // 前腿深弓箭步
          target.leftShoulder  = { x: 4 * handDir,  y: -31 };
          target.rightShoulder = { x: 14 * handDir, y: -30 };
          // 左手向后上方舒展保持身体平衡
          target.leftElbow = { x: -10 * handDir, y: -34 };
          target.leftWrist = { x: -22 * handDir, y: -38 };
          // 右手向前平伸至网前，拇指食指微捻搓球
          target.rightElbow = { x: 24 * handDir, y: -28 };
          target.rightWrist = { x: (34 + (1 - s) * 4) * handDir, y: -31 };
          target.racketPitch = -0.08 * handDir;
          target.head = { x: 16 * handDir, y: -44 }; // 身体极度向网带前倾
          target.bellyArchX = 4 * handDir;
        } else if (swingType === 'lift') {
          // 5.【挑球】：手腕向上极度上扬，重心在击球瞬间向后坐
          target.hip = { x: -7 * handDir, y: -14 }; // 重心明显向后坐
          target.leftKnee   = { x: -15 * handDir, y: -7 };
          target.leftAnkle  = { x: -19 * handDir, y: 2 };
          target.rightKnee  = { x: 16 * handDir,  y: -9 };
          target.rightAnkle = { x: 22 * handDir,  y: 1 };
          target.leftShoulder  = { x: -8 * handDir, y: -35 };
          target.rightShoulder = { x: 4 * handDir,  y: -34 };
          target.leftElbow = { x: -16 * handDir, y: -42 };
          target.leftWrist = { x: -22 * handDir, y: -48 };
          if (s > 0.50) {
            // 拍头先下沉抄底
            target.rightElbow = { x: 12 * handDir, y: -24 };
            target.rightWrist = { x: 18 * handDir, y: -14 };
            target.racketPitch = 0.85 * handDir;
          } else {
            // 手腕由下向上极度上扬挑球
            target.rightElbow = { x: 16 * handDir, y: -38 };
            target.rightWrist = { x: 24 * handDir, y: -56 };
            target.racketPitch = -0.95 * handDir; // 极度上扬
          }
          target.head = { x: -3 * handDir, y: -49 };
          target.bellyArchX = -3 * handDir;
        } else {
          // 平抽挡 (Drive)
          target.rightElbow = { x: 18 * handDir, y: -40 };
          target.rightWrist = { x: 28 * handDir, y: -44 };
          target.racketPitch = -0.15 * handDir;
        }
      } else if ((opts.landingCrouch || 0) > 0.1 || isInSmashRecovery) {
        // 杀球落地深蹲缓冲姿态
        target.hip = { x: 2 * handDir, y: -12 };
        target.leftKnee   = { x: -15, y: -5 };
        target.leftAnkle  = { x: -14, y: 2 };
        target.rightKnee  = { x: 15,  y: -5 };
        target.rightAnkle = { x: 14,  y: 2 };
        target.leftShoulder.y  = -30;
        target.rightShoulder.y = -30;
        target.head.y = -43;
      }

      // 【任务3：核心！8 节点动力链分层平滑插值 (腿 -> 腰 -> 肩 -> 肘 -> 腕 依次传递)】
      const ff = Math.min(2.2, opts.frameFactor || 1);
      if (!visObj.curJoints || !visObj.curJoints.hip) {
        visObj.curJoints = JSON.parse(JSON.stringify(target));
      } else {
        const cj = visObj.curJoints;
        // 动力链插值权重：腿踝(0.35) -> 髋腰(0.30) -> 双肩(0.26) -> 双肘(0.22) -> 双腕(0.19) -> 头部滞后跟随(0.16)
        const chainWeights = {
          leftKnee: 0.35, leftAnkle: 0.35, rightKnee: 0.35, rightAnkle: 0.35,
          hip: 0.30,
          leftShoulder: 0.26, rightShoulder: 0.26,
          leftElbow: 0.22, rightElbow: 0.22,
          leftWrist: 0.19, rightWrist: 0.19,
          head: 0.16
        };
        for (const nodeName in chainWeights) {
          const w = Math.min(1, chainWeights[nodeName] * ff);
          cj[nodeName].x = lerp(cj[nodeName].x, target[nodeName].x, w);
          cj[nodeName].y = lerp(cj[nodeName].y, target[nodeName].y, w);
        }
        cj.bellyArchX = lerp(cj.bellyArchX || 0, target.bellyArchX || 0, Math.min(1, 0.25 * ff));
        cj.racketPitch = lerp(cj.racketPitch || 0, target.racketPitch || 0, Math.min(1, 0.24 * ff));
        cj.tipToe = target.tipToe;
      }

      const j = visObj.curJoints;
      const midShoulderX = (j.leftShoulder.x + j.rightShoulder.x) * 0.5;
      const midShoulderY = (j.leftShoulder.y + j.rightShoulder.y) * 0.5;

      // 3D Q版色彩与高光材质渐变
      const jerseyGrad = ctx.createLinearGradient(-12, midShoulderY, 12, j.hip.y + 6);
      if (isInSmashRecovery && Math.floor(nowMs / 80) % 2 === 0) {
        jerseyGrad.addColorStop(0, '#f87171');
        jerseyGrad.addColorStop(0.5, '#dc2626');
        jerseyGrad.addColorStop(1, '#7f1d1d');
      } else if (opts.isPlayer) {
        jerseyGrad.addColorStop(0, '#34d399');
        jerseyGrad.addColorStop(0.45, '#10b981');
        jerseyGrad.addColorStop(1, '#065f46');
      } else {
        jerseyGrad.addColorStop(0, '#fb7185');
        jerseyGrad.addColorStop(0.45, '#e11d48');
        jerseyGrad.addColorStop(1, '#881337');
      }

      const skinGrad = ctx.createRadialGradient(j.head.x - 3, j.head.y - 4, 2, j.head.x, j.head.y, 13);
      skinGrad.addColorStop(0, '#fffbeb');
      skinGrad.addColorStop(0.55, '#fde68a');
      skinGrad.addColorStop(1, '#d97706');

      const shortsGrad = ctx.createLinearGradient(0, j.hip.y - 4, 0, j.hip.y + 10);
      shortsGrad.addColorStop(0, '#1e293b');
      shortsGrad.addColorStop(1, '#0f172a');

      const armSkinGrad = ctx.createLinearGradient(0, -55, 0, -20);
      armSkinGrad.addColorStop(0, '#fef3c7');
      armSkinGrad.addColorStop(1, '#f59e0b');

      // ==================== 骨骼分层绘制 (3D Q版运动角色 + IK骨骼高光内芯) ====================
      // 1. 左臂 (非持拍手：高远/吊球时高举指天，网前搓球时后展平衡)
      drawTaperedLimb(ctx, j.leftShoulder.x, j.leftShoulder.y, j.leftElbow.x, j.leftElbow.y, 4.2, 3.3, jerseyGrad, -1.5 * handDir, 'rgba(56,189,248,0.45)');
      drawTaperedLimb(ctx, j.leftElbow.x, j.leftElbow.y, j.leftWrist.x, j.leftWrist.y, 3.2, 2.5, armSkinGrad, -1.0 * handDir, 'rgba(56,189,248,0.65)');
      // Q版圆润左手拳
      ctx.beginPath();
      ctx.arc(j.leftWrist.x, j.leftWrist.y, 3.0, 0, Math.PI * 2);
      ctx.fillStyle = '#fef3c7';
      ctx.fill();
      ctx.lineWidth = 2;
      ctx.strokeStyle = '#0f0f0f';
      ctx.stroke();

      // 2. 双腿 (大腿短裤包裹 + 肌肉小腿 + 护膝 + 3D羽毛球战靴)
      // 左腿 (髋 -> 左膝 -> 左踝)
      drawTaperedLimb(ctx, j.hip.x - 4, j.hip.y, j.leftKnee.x, j.leftKnee.y, 5.4, 4.0, shortsGrad, -1.8, 'rgba(203,213,225,0.45)');
      drawTaperedLimb(ctx, j.leftKnee.x, j.leftKnee.y, j.leftAnkle.x, j.leftAnkle.y, 3.8, 2.6, armSkinGrad, 1.4, 'rgba(203,213,225,0.65)');
      draw3DShoe(ctx, j.leftAnkle.x, j.leftAnkle.y, 0, opts.isPlayer, j.tipToe);

      // 右腿 (髋 -> 右膝 -> 右踝)
      drawTaperedLimb(ctx, j.hip.x + 4, j.hip.y, j.rightKnee.x, j.rightKnee.y, 5.4, 4.0, shortsGrad, 1.8, 'rgba(203,213,225,0.45)');
      drawTaperedLimb(ctx, j.rightKnee.x, j.rightKnee.y, j.rightAnkle.x, j.rightAnkle.y, 3.8, 2.6, armSkinGrad, -1.4, 'rgba(203,213,225,0.65)');
      draw3DShoe(ctx, j.rightAnkle.x, j.rightAnkle.y, 0, opts.isPlayer, j.tipToe);

      // 膝关节发光IK护膝节点
      [j.leftKnee, j.rightKnee].forEach(kn => {
        ctx.beginPath();
        ctx.arc(kn.x, kn.y, 2.8, 0, Math.PI * 2);
        ctx.fillStyle = '#f59e0b';
        ctx.fill();
        ctx.lineWidth = 1.8;
        ctx.strokeStyle = '#0f0f0f';
        ctx.stroke();
      });

      // 3. 3D 躯干与球衣 (根据双肩间距自动表现正身/侧身转体，并根据 bellyArchX 表现杀球极限反弓挺腹!)
      const shoulderSpan = Math.max(5.5, Math.abs(j.rightShoulder.x - j.leftShoulder.x) * 0.55 + 4.5);
      const spineCtrlX = (midShoulderX + j.hip.x) * 0.5 + (j.bellyArchX || 0);
      const spineCtrlY = (midShoulderY + j.hip.y) * 0.5;

      ctx.beginPath();
      ctx.moveTo(midShoulderX - shoulderSpan, midShoulderY - 2);
      ctx.lineTo(midShoulderX + shoulderSpan, midShoulderY - 2);
      ctx.quadraticCurveTo(spineCtrlX + shoulderSpan * 0.85, spineCtrlY, j.hip.x + 7.5, j.hip.y + 3);
      ctx.lineTo(j.hip.x - 7.5, j.hip.y + 3);
      ctx.quadraticCurveTo(spineCtrlX - shoulderSpan * 0.85, spineCtrlY, midShoulderX - shoulderSpan, midShoulderY - 2);
      ctx.closePath();
      ctx.fillStyle = jerseyGrad;
      ctx.fill();
      ctx.lineWidth = 3.6;
      ctx.strokeStyle = '#0f0f0f';
      ctx.stroke();

      // 球衣V领与金色电竞战纹
      ctx.beginPath();
      ctx.moveTo(midShoulderX - 4, midShoulderY - 1);
      ctx.lineTo(midShoulderX, midShoulderY + 5);
      ctx.lineTo(midShoulderX + 4, midShoulderY - 1);
      ctx.strokeStyle = '#fef08a';
      ctx.lineWidth = 2.0;
      ctx.stroke();

      // 内部脊柱 IK 骨骼高光线
      ctx.beginPath();
      ctx.moveTo(midShoulderX, midShoulderY);
      ctx.quadraticCurveTo(spineCtrlX, spineCtrlY, j.hip.x, j.hip.y);
      ctx.strokeStyle = 'rgba(254, 240, 138, 0.55)';
      ctx.lineWidth = 1.8;
      ctx.stroke();

      // 4. 右臂 (持拍手：拉弓 -> 立肘 -> 小臂鞭打 / 网前细腻搓球 / 挑球上扬)
      drawTaperedLimb(ctx, j.rightShoulder.x, j.rightShoulder.y, j.rightElbow.x, j.rightElbow.y, 4.5, 3.5, jerseyGrad, 1.8 * handDir, 'rgba(244,63,94,0.55)');
      drawTaperedLimb(ctx, j.rightElbow.x, j.rightElbow.y, j.rightWrist.x, j.rightWrist.y, 3.4, 2.6, armSkinGrad, -1.5 * handDir, 'rgba(244,63,94,0.75)');

      // 肘部与腕部 IK 节点高光
      [j.rightElbow, j.rightWrist].forEach(pt => {
        ctx.beginPath();
        ctx.arc(pt.x, pt.y, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = '#fde047';
        ctx.fill();
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = '#0f0f0f';
        ctx.stroke();
      });

      // 5. 羽毛球拍 (从右腕延伸，随拍面内扣包切/上扬挑球动态变化倾角)
      const armAngle = Math.atan2(j.rightWrist.y - j.rightElbow.y, j.rightWrist.x - j.rightElbow.x);
      const rAngle = armAngle + (j.racketPitch || 0);
      const shaftEndX = j.rightWrist.x + Math.cos(rAngle) * 14;
      const shaftEndY = j.rightWrist.y + Math.sin(rAngle) * 14;
      const headCenterX = j.rightWrist.x + Math.cos(rAngle) * 24;
      const headCenterY = j.rightWrist.y + Math.sin(rAngle) * 24;

      ctx.beginPath();
      ctx.moveTo(j.rightWrist.x, j.rightWrist.y);
      ctx.lineTo(shaftEndX, shaftEndY);
      ctx.lineWidth = 5.0;
      ctx.strokeStyle = '#0f0f0f';
      ctx.stroke();
      ctx.lineWidth = 2.4;
      ctx.strokeStyle = '#f8fafc';
      ctx.stroke();

      ctx.save();
      ctx.translate(headCenterX, headCenterY);
      ctx.rotate(rAngle + Math.PI / 2);
      // 吊球/搓球包切时拍面呈现侧切椭圆透视
      const faceNarrow = (swingType === 'drop' || swingType === 'net') ? 5.2 : 7.5;
      ctx.beginPath();
      ctx.ellipse(0, 0, faceNarrow, 10.5, 0, 0, Math.PI * 2);
      ctx.fillStyle = opts.isPlayer ? 'rgba(56, 189, 248, 0.28)' : 'rgba(244, 63, 94, 0.28)';
      ctx.fill();
      ctx.lineWidth = 3.8;
      ctx.strokeStyle = '#0f0f0f';
      ctx.stroke();
      ctx.lineWidth = 2.0;
      ctx.strokeStyle = '#fbbf24';
      ctx.stroke();
      ctx.restore();

      if ((opts.impactSpark || 0) > 0.05 || (swing > 0.25 && swing < 0.55)) {
        const spAlpha = Math.max(opts.impactSpark || 0, (swing > 0.25 && swing < 0.55) ? 0.65 : 0);
        ctx.save();
        ctx.strokeStyle = '#fde047';
        ctx.lineWidth = 3.2;
        ctx.globalAlpha = spAlpha;
        ctx.beginPath();
        ctx.arc(headCenterX, headCenterY, 9 + (1 - spAlpha) * 16, 0, Math.PI * 2);
        ctx.stroke();
        ctx.restore();
      }

      // 6. 3D Q版大头娃娃运动员头部 (3D Spherical Shaded Chibi Head + Headband + Expressive Eyes + Spiky Hair)
      const hx = j.head.x;
      const hy = j.head.y;

      // 飘动运动发带尾部
      ctx.beginPath();
      ctx.moveTo(hx - 6 * handDir, hy - 2);
      ctx.quadraticCurveTo(
        hx - 15 * handDir,
        hy - 5,
        hx - 22 * handDir,
        hy + 2 + Math.sin(nowMs * 0.016) * 3.5
      );
      ctx.lineTo(hx - 18 * handDir, hy + 7 + Math.sin(nowMs * 0.016) * 3.5);
      ctx.closePath();
      ctx.fillStyle = opts.isPlayer ? '#f43f5e' : '#a855f7';
      ctx.fill();
      ctx.lineWidth = 2.8;
      ctx.strokeStyle = '#0f0f0f';
      ctx.stroke();

      // 3D Q版圆润头颅球体 (半径 11.2，打造可爱的 3D Q版二头身/三头身比例)
      ctx.beginPath();
      ctx.arc(hx, hy, 11.2, 0, Math.PI * 2);
      ctx.fillStyle = skinGrad;
      ctx.fill();
      ctx.lineWidth = 3.6;
      ctx.strokeStyle = '#0f0f0f';
      ctx.stroke();

      // Q版脸颊红晕与高光
      ctx.fillStyle = 'rgba(244, 63, 94, 0.35)';
      ctx.beginPath();
      ctx.ellipse(hx + 5 * handDir, hy + 2.5, 2.4, 1.4, 0, 0, Math.PI * 2);
      ctx.fill();

      // Q版竞技大眼睛 (带白色高光瞳孔)
      const eyeX = hx + 3.8 * handDir;
      const eyeY = hy - 0.5;
      ctx.fillStyle = '#0f172a';
      ctx.beginPath();
      ctx.ellipse(eyeX, eyeY, 2.0, 2.6, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(eyeX + 0.6 * handDir, eyeY - 0.8, 0.85, 0, Math.PI * 2);
      ctx.fill();

      // 运动发带正面 + 金色羽刃额饰
      ctx.beginPath();
      ctx.arc(hx, hy, 11.3, Math.PI * 1.08, Math.PI * 1.92);
      ctx.strokeStyle = opts.isPlayer ? '#ef4444' : '#9333ea';
      ctx.lineWidth = 4.2;
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(hx, hy, 11.3, Math.PI * 1.25, Math.PI * 1.75);
      ctx.strokeStyle = '#fbbf24';
      ctx.lineWidth = 2.2;
      ctx.stroke();

      // 3D Q版动感刺猬头发簇
      ctx.beginPath();
      ctx.moveTo(hx - 9, hy - 7);
      ctx.lineTo(hx - 5, hy - 16);
      ctx.lineTo(hx - 1, hy - 11);
      ctx.lineTo(hx + 3, hy - 17);
      ctx.lineTo(hx + 6, hy - 11);
      ctx.lineTo(hx + 10, hy - 14);
      ctx.lineTo(hx + 9, hy - 6);
      ctx.closePath();
      ctx.fillStyle = opts.isPlayer ? '#0f172a' : '#31102f';
      ctx.fill();
      ctx.lineWidth = 2.6;
      ctx.strokeStyle = '#0f0f0f';
      ctx.stroke();

      // 头顶状态提示文字
      if (opts.postureZero) {
        ctx.font = 'italic 900 12px "Noto Serif SC", serif';
        ctx.strokeStyle = '#0f0f0f';
        ctx.lineWidth = 4;
        ctx.textAlign = 'center';
        ctx.strokeText('💫 【重心崩溃】 2.0s!', 0, hy - 20);
        ctx.fillStyle = '#fde047';
        ctx.fillText('💫 【重心崩溃】 2.0s!', 0, hy - 20);
      } else if (!opts.isPlayer && GameState.aiStaggerTimer > 0) {
        ctx.font = 'italic 900 12px "Noto Serif SC", serif';
        ctx.strokeStyle = '#0f0f0f';
        ctx.lineWidth = 4;
        ctx.textAlign = 'center';
        ctx.strokeText('⚡ 战术压制·踉跄!', 0, hy - 20);
        ctx.fillStyle = '#fde047';
        ctx.fillText('⚡ 战术压制·踉跄!', 0, hy - 20);
      } else if (opts.isPlayer && GameState.playerRecoveryTimer > 0) {
        ctx.font = 'italic 900 11px "Noto Serif SC", serif';
        ctx.strokeStyle = '#0f0f0f';
        ctx.lineWidth = 4;
        ctx.textAlign = 'center';
        const recMsg = isInSmashRecovery ? '⚠️ 后摇破绽! (深蹲0.4s)' : '⚠️ 后摇破绽! (前冲惯性0.2s)';
        ctx.strokeText(recMsg, 0, hy - 20);
        ctx.fillStyle = '#facc15';
        ctx.fillText(recMsg, 0, hy - 20);
      } else if (isTurnStun) {
        ctx.font = 'italic 900 10px "Noto Serif SC", serif';
        ctx.fillStyle = '#38bdf8';
        ctx.textAlign = 'center';
        ctx.fillText('👟 急停转身 0.15s', 0, hy - 19);
      } else if (opts.isPlayer) {
        const sym = GameState.cogSymbol || '0';
        const symCol = GameState.cogImbalanced ? '#f43f5e' : (sym === '+' ? '#fbbf24' : (sym === '-' ? '#38bdf8' : '#34d399'));
        ctx.font = '900 11px "Noto Sans SC", sans-serif';
        ctx.strokeStyle = '#0f0f0f';
        ctx.lineWidth = 3.5;
        ctx.textAlign = 'center';
        const badgeTxt = GameState.cogImbalanced
          ? `⚠️失衡[${sym}] (慢0.5s) · ${GameState.lastRacketActionText}`
          : `重心[${sym}] · ${GameState.lastRacketActionText}`;
        ctx.strokeText(badgeTxt, 0, hy - 20);
        ctx.fillStyle = symCol;
        ctx.fillText(badgeTxt, 0, hy - 20);
      }

      ctx.restore();
    }
    const drawSkeleton = drawBadmintonStickman;

    // ==================== 14. EVENT LISTENERS ====================
    function bindAllControls() {
      // Click anywhere on the Canvas during 【重心崩溃】 (Finisher state) to immediately execute!
      canvas.addEventListener('pointerdown', (e) => {
        if (GameState.phase === 'break_finisher' && !GameState.paused) {
          e.preventDefault();
          executeBreakFinisher({ name: '🩸 制胜扣杀·赛场断头扣杀' });
        }
      });

      document.getElementById('btnSkipTutorial').addEventListener('click', () => {
        GameState.tutorialStep = 0;
        GameState.tutorialActive = false;
        updateAllUI();
        renderActionDeck();
      });

      document.getElementById('btnResetSave').addEventListener('click', resetSaveData);

      // 【任务一 ~ 任务四：八方位吸附摇杆 (8-Way Snap Joystick)】
      const joyZone = document.getElementById('joystickZone');
      const joyKnob = document.getElementById('joystickKnob');
      const joyFlickStream = document.getElementById('joyFlickStream');
      const joySpokes = document.querySelectorAll('#joySpokesGroup path');

      function updateJoySpokeHighlight(activeIdx) {
        joySpokes.forEach((pathEl, idx) => {
          if (idx === activeIdx) {
            pathEl.setAttribute('stroke', '#fde047');
            pathEl.setAttribute('stroke-width', '2.1');
          } else {
            pathEl.setAttribute('stroke', 'rgba(254, 243, 199, 0.52)');
            pathEl.setAttribute('stroke-width', '1.05');
          }
        });
      }

      function handleJoyMove(clientX, clientY) {
        const rect = joyZone.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const maxR = rect.width * 0.36;
        const dx = clientX - cx;
        const dy = clientY - cy;
        const dist = Math.hypot(dx, dy);

        // 自动过滤微小手指抖动死区
        if (dist < 7) {
          GameState.joyVx = 0;
          GameState.joyVy = 0;
          joyKnob.style.transform = 'translate(0px, 0px)';
          return;
        }

        // 1. 计算角度 angle = Math.atan2(dy, dx)
        const angle = Math.atan2(dy, dx);
        const stepRad = Math.PI / 4; // 45 度倍数

        // 防抖迟滞修正，避免临界角微颤
        let snapIdx = ((Math.round(angle / stepRad) % 8) + 8) % 8;
        if (GameState.joySnapIdx !== -1) {
          const prevRad = GameState.joySnapIdx * stepRad;
          const diff = Math.atan2(Math.sin(angle - prevRad), Math.cos(angle - prevRad));
          if (Math.abs(diff) < (Math.PI / 8 + 0.09)) {
            snapIdx = GameState.joySnapIdx;
          }
        }

        // 2. 将角度强制吸附到最近的 45 度倍数上 (0, 45, 90, 135, 180, 225, 270, 315)
        const snappedRad = snapIdx * stepRad;
        const snappedDeg = snapIdx * 45;

        // 3. 根据吸附后的角度输出固定移动向量 (vx, vy)，如正上方(0, -1)，右上方(0.707, -0.707)
        const fixedVx = Number(Math.cos(snappedRad).toFixed(3));
        const fixedVy = Number(Math.sin(snappedRad).toFixed(3));
        GameState.joyVx = Object.is(fixedVx, -0) ? 0 : fixedVx;
        GameState.joyVy = Object.is(fixedVy, -0) ? 0 : fixedVy;
        if (GameState.joyVx !== 0) {
          GameState.lastActiveJoyVx = GameState.joyVx;
          GameState.lastActiveJoyTime = performance.now();
        }

        // 向外圈拨动时触发爆发起步
        if (dist >= maxR * 0.65 && GameState.joySnapIdx !== snapIdx) {
          GameState.joyBurstTimer = 180;
        }

        // 【双击冲刺 Dash (0.2s内同方向连续拨动两次)】 & 【0.15s 二次启动急停转身硬直】 & 【拨动流光特效】
        if (GameState.joySnapIdx !== snapIdx) {
          const nowMs = performance.now();
          // 1. 检测双击冲刺：0.2秒(200ms)内连续两次拨向同一方位
          if (GameState.joySnapIdx === -1 && GameState.lastJoySnapIdx === snapIdx && (nowMs - GameState.lastJoyTapTime) <= 220 && GameState.pStamina >= 12) {
            GameState.dashTimer = 220;
            GameState.dashVx = GameState.joyVx;
            GameState.dashVy = GameState.joyVy;
            GameState.pStamina = Math.max(0, GameState.pStamina - 10);
            spawnPlayerSmashAfterimages();
            SoundEngine.playDash();
            spawnFloatingText(GameState.playerVisual.x, GameState.playerVisual.y - 0.05, '⚡爆发冲刺 DASH! (2x移速)', '#38bdf8');
          }

          // 2. 检测二次启动急停转身惩罚：正在高速移动时突然反向拨动摇杆 (夹角 > 120度，即方位差 3~5 格)
          if (GameState.joySnapIdx !== -1) {
            const dirDiff = Math.abs(snapIdx - GameState.joySnapIdx);
            const wrappedDiff = Math.min(dirDiff, 8 - dirDiff);
            if (wrappedDiff >= 3 && GameState.moveStartupMs >= 50) {
              GameState.turnaroundTimer = 150; // 0.15秒急停转身硬直
              GameState.moveStartupMs = 0;
              spawnParticles(GameState.playerVisual.x, GameState.playerVisual.y, '#38bdf8', 8);
              spawnFloatingText(GameState.playerVisual.x, GameState.playerVisual.y - 0.04, '👟急停转身 0.15s', '#38bdf8');
            }
          }

          GameState.joySnapIdx = snapIdx;
          GameState.lastJoySnapIdx = snapIdx;
          GameState.lastJoyTapTime = nowMs;
          GameState.joyFlickAngleDeg = snappedDeg;
          GameState.joyFlickAlpha = 1.0;
          if (joyFlickStream) {
            joyFlickStream.setAttribute('transform', `rotate(${snappedDeg})`);
            joyFlickStream.setAttribute('opacity', '1');
          }
          updateJoySpokeHighlight(snapIdx);
          SoundEngine.playJoyFlick();
        }

        const clampedDist = Math.min(dist, maxR);
        const snapDx = Math.cos(snappedRad) * clampedDist;
        const snapDy = Math.sin(snappedRad) * clampedDist;
        joyKnob.classList.remove('joy-knob-snap');
        joyKnob.classList.add('joy-knob-dragging');
        joyKnob.style.transform = `translate(${snapDx.toFixed(1)}px, ${snapDy.toFixed(1)}px)`;
      }

      function resetJoy() {
        GameState.joyActive = false;
        GameState.joyVx = 0;
        GameState.joyVy = 0;
        GameState.joySnapIdx = -1;
        updateJoySpokeHighlight(-1);
        joyKnob.classList.remove('joy-knob-dragging');
        joyKnob.classList.add('joy-knob-snap');
        joyKnob.style.transform = 'translate(0px, 0px)';
      }

      joyZone.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        GameState.joyActive = true;
        try { joyZone.setPointerCapture(e.pointerId); } catch (err) {}
        handleJoyMove(e.clientX, e.clientY);
      });
      joyZone.addEventListener('pointermove', (e) => {
        if (!GameState.joyActive) return;
        handleJoyMove(e.clientX, e.clientY);
      });
      joyZone.addEventListener('pointerup', resetJoy);
      joyZone.addEventListener('pointercancel', resetJoy);

      // ==================== 八向步伐键盘 (8-Way Footwork D-Pad) 输入引擎 ====================
      const dpadBtns = document.querySelectorAll('#dPad .dpad-btn');
      const activeDirs = new Set();
      let lastDpadDir = '';
      let lastDpadTapTime = 0;

      const dirSnapIndexMap = {
        right: 0, dr: 1, down: 2, dl: 3, left: 4, ul: 5, up: 6, ur: 7
      };

      function syncDpadMovement() {
        let vx = 0, vy = 0;
        if (activeDirs.has('up')) vy -= 1;
        if (activeDirs.has('down')) vy += 1;
        if (activeDirs.has('left')) vx -= 1;
        if (activeDirs.has('right')) vx += 1;
        if (activeDirs.has('ul')) { vx -= 0.707; vy -= 0.707; }
        if (activeDirs.has('ur')) { vx += 0.707; vy -= 0.707; }
        if (activeDirs.has('dl')) { vx -= 0.707; vy += 0.707; }
        if (activeDirs.has('dr')) { vx += 0.707; vy += 0.707; }

        const mag = Math.hypot(vx, vy);
        if (mag > 1.0) {
          vx = Number((vx / mag).toFixed(3));
          vy = Number((vy / mag).toFixed(3));
        }
        GameState.joyVx = vx;
        GameState.joyVy = vy;
        GameState.joyActive = (vx !== 0 || vy !== 0);
        if (vx !== 0) {
          GameState.lastActiveJoyVx = vx;
          GameState.lastActiveJoyTime = performance.now();
        }
      }

      dpadBtns.forEach(btn => {
        const dir = btn.dataset.dir;
        btn.addEventListener('pointerdown', (e) => {
          e.preventDefault();
          if (GameState.phase === 'ai_incoming') {
            handleSensoryFootworkSelect(dir);
            return;
          }
          const nowMs = performance.now();
          // 双击同一方向键触发 2.0x 爆发冲刺 (Dash)
          if (!activeDirs.has(dir) && lastDpadDir === dir && (nowMs - lastDpadTapTime) <= 240 && GameState.pStamina >= 12) {
            btn.classList.add('active');
            activeDirs.add(dir);
            syncDpadMovement();
            GameState.dashTimer = 220;
            GameState.dashVx = GameState.joyVx;
            GameState.dashVy = GameState.joyVy;
            GameState.pStamina = Math.max(0, GameState.pStamina - 10);
            spawnPlayerSmashAfterimages();
            SoundEngine.playDash();
            spawnFloatingText(GameState.playerVisual.x, GameState.playerVisual.y - 0.05, '⚡八向爆发跨步 DASH!', '#38bdf8');
          } else {
            // 检测高速移动中突然反向按步伐键触发 0.15s 急停转身
            const snapIdx = dirSnapIndexMap[dir] ?? -1;
            if (GameState.joySnapIdx !== -1 && snapIdx !== -1) {
              const dirDiff = Math.abs(snapIdx - GameState.joySnapIdx);
              const wrappedDiff = Math.min(dirDiff, 8 - dirDiff);
              if (wrappedDiff >= 3 && GameState.moveStartupMs >= 50) {
                GameState.turnaroundTimer = 150;
                GameState.moveStartupMs = 0;
                spawnParticles(GameState.playerVisual.x, GameState.playerVisual.y, '#38bdf8', 8);
                spawnFloatingText(GameState.playerVisual.x, GameState.playerVisual.y - 0.04, '👟急停转身 0.15s', '#38bdf8');
              }
            }
            GameState.joySnapIdx = snapIdx;
            btn.classList.add('active');
            activeDirs.add(dir);
            syncDpadMovement();
            SoundEngine.playJoyFlick();
          }
          lastDpadDir = dir;
          lastDpadTapTime = nowMs;
        });

        const releaseDir = () => {
          btn.classList.remove('active');
          activeDirs.delete(dir);
          if (activeDirs.size === 0) GameState.joySnapIdx = -1;
          syncDpadMovement();
        };
        btn.addEventListener('pointerup', releaseDir);
        btn.addEventListener('pointerleave', releaseDir);
        btn.addEventListener('pointercancel', releaseDir);
      });

      // Expose window.triggerShot for direct shot pose testing ('high' | 'clear' | 'smash' | 'drop' | 'net' | 'lift')
      window.triggerShot = (type) => {
        const mapped = type === 'high' ? 'clear' : type;
        GameState.playerVisual.swingType = mapped;
        GameState.playerVisual.swingAnim = 1.0;
        if (mapped === 'smash') {
          GameState.playerVisual.poseType = 'jump_smash';
          GameState.playerVisual.jumpHeight = 1.0;
          spawnPlayerSmashAfterimages();
        } else if (mapped === 'net') {
          GameState.playerVisual.poseType = 'deep_lunge';
        } else {
          GameState.playerVisual.poseType = 'clear_retreat';
        }
        SoundEngine.playSwish();
      };

      // Global Pointer Move / Up for Right-Hand Hold & Swipe
      window.addEventListener('pointermove', (e) => {
        if (GameState.pressSwipe.active) {
          GameState.pressSwipe.deltaY = e.clientY - GameState.pressSwipe.startY;
        }
      });
      window.addEventListener('pointerup', () => {
        if (!GameState.pressSwipe.active) return;
        const now = performance.now();
        const ps = { ...GameState.pressSwipe };
        GameState.pressSwipe.active = false;
        if (GameState.swingLock || now - GameState.pressSwipe.lastFiredAt < 180) return;
        GameState.pressSwipe.lastFiredAt = now;
        if (ps.shot && GameState.phase === 'player_offense') {
          executePlayerOffenseShot(ps.shot, ps.chargePct, ps.deltaY);
