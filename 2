    // ==================== 5. LOCALSTORAGE SAVE & LOAD ====================
    function loadSaveData() {
      try {
        const raw = localStorage.getItem(SAVE_STORAGE_KEY) || localStorage.getItem('featherblade_v5_save') || localStorage.getItem('featherblade_v4_save');
        if (!raw) return;
        const data = JSON.parse(raw);
        if (typeof data.maxUnlockedStage === 'number') {
          GameState.maxUnlockedStage = Math.max(0, Math.min(STAGES.length - 1, data.maxUnlockedStage));
        }
        if (data.attrs && typeof data.attrs.power === 'number') {
          GameState.attrs.power = data.attrs.power;
          GameState.attrs.control = data.attrs.control;
          GameState.attrs.sense = data.attrs.sense || data.attrs.feel || 40;
        }
        if (data.permBonus && typeof data.permBonus.staminaMax === 'number') {
          GameState.permBonus.staminaMax = data.permBonus.staminaMax || 0;
          GameState.permBonus.windowPct = data.permBonus.windowPct || 0;
          GameState.permBonus.postureDmgPct = data.permBonus.postureDmgPct || 0;
        }
        if (Array.isArray(data.boons)) {
          GameState.boons = data.boons.filter(id => TACTICAL_CARDS.some(b => b.id === id));
        }
        if (Array.isArray(data.unlockedShots)) {
          GameState.unlockedShots = [...INITIAL_UNLOCKED_SHOTS];
          data.unlockedShots.forEach(s => {
            if (!GameState.unlockedShots.includes(s)) GameState.unlockedShots.push(s);
          });
        }
        if (typeof data.xp === 'number') GameState.xp = data.xp;
      } catch (e) {}
    }

    function saveGameData() {
      try {
        const payload = {
          maxUnlockedStage: GameState.maxUnlockedStage,
          attrs: GameState.attrs,
          permBonus: GameState.permBonus,
          boons: GameState.boons,
          unlockedShots: GameState.unlockedShots,
          xp: GameState.xp
        };
        localStorage.setItem(SAVE_STORAGE_KEY, JSON.stringify(payload));
      } catch (e) {}
    }

    function resetSaveData() {
      try {
        localStorage.removeItem(SAVE_STORAGE_KEY);
        localStorage.removeItem('featherblade_v5_save');
        localStorage.removeItem('featherblade_v4_save');
      } catch (e) {}
      GameState.maxUnlockedStage = 0;
      GameState.attrs = { power: 45, control: 40, sense: 40 };
      GameState.permBonus = { staminaMax: 0, windowPct: 0, postureDmgPct: 0 };
      GameState.boons = [];
      GameState.unlockedShots = [...INITIAL_UNLOCKED_SHOTS];
      GameState.xp = 120;
      initStage(0);
      openMapModal();
    }

    // ==================== 6. HELPER FUNCTIONS ====================
    function getCurrentHero() { return HEROES[GameState.heroIdx] || HEROES[0]; }
    function getCurrentStage() { return STAGES[GameState.stageIdx] || STAGES[0]; }

    function getAdrenalineInfo(combo) {
      if (combo >= 12) return { mult: 2.2, name: '白热' };
      if (combo >= 8)  return { mult: 1.8, name: '狂热' };
      if (combo >= 5)  return { mult: 1.5, name: '燃烧' };
      if (combo >= 2)  return { mult: 1.2, name: '专注' };
      return { mult: 1.0, name: '平静' };
    }

    const GRID_NAMES = ['前左(0)', '前中(1)', '前右(2)', '中左(3)', '中中(4)', '中右(5)', '后左(6)', '后中(7)', '后右(8)'];

    function updatePlayerGridFromCoords() {
      const px = GameState.playerVisual.x;
      const py = GameState.playerVisual.y;
      const col = px < 0.38 ? 0 : (px > 0.62 ? 2 : 1);
      const row = py < 0.67 ? 0 : (py > 0.79 ? 2 : 1);
      GameState.pGridIdx = row * 3 + col;
      GameState.pPos = row === 0 ? 'front' : (row === 2 ? 'back' : 'mid');
      GameState.pHand = col === 0 ? 'backhand' : 'forehand';
    }

    function spawnImpactRing(normX, normY, tier = 'normal') {
      if (GameState.impactRings.length >= 16) GameState.impactRings.shift();
      const cfg = tier === 'finisher'
        ? { color: '#ef4444', maxR: 68, width: 5.5 }
        : (tier === 'perfect' ? { color: '#fde047', maxR: 48, width: 4.2 } : { color: '#ffffff', maxR: 26, width: 2.5 });
      GameState.impactRings.push({
        x: normX,
        y: normY,
        life: 1.0,
        color: cfg.color,
        maxR: cfg.maxR,
        width: cfg.width
      });
    }

    function spawnFeatherShatter(normX, normY) {
      spawnImpactRing(normX, normY, 'finisher');
      spawnParticles(normX, normY, '#ffffff', 22);
      spawnParticles(normX, normY, '#fde047', 22);
      spawnParticles(normX, normY, '#ef4444', 20);
    }

    function getAiOpenCourtInfo() {
      // Detect if AI is positioned far forward (leaving backcourt open) or deep back (leaving front net open)
      const aiY = GameState.aiVisual.y;
      const aiX = GameState.aiVisual.x;
      const openX = aiX < 0.5 ? 0.76 : 0.24;
      if (GameState.aiPos === 'front' || aiY >= 0.29) {
        return {
          type: 'back',
          label: '🎯 抓后场空当',
          normX: openX,
          normY: 0.14,
          shots: ['高远球', '平高球', '挑球']
        };
      }
      if (GameState.aiPos === 'back' || aiY <= 0.20) {
        return {
          type: 'front',
          label: '🎯 抓网前空当',
          normX: openX,
          normY: 0.36,
          shots: ['放网', '吊球', '搓球', '劈吊', '滑板', '勾对角']
        };
      }
      return null;
    }

    function isPlayerInLandingCircle() {
      if (GameState.phase !== 'ai_incoming' || !GameState.incomingShot) return true;
      const inc = GameState.incomingShot;
      const athenaBonus = (hasBoon('athena') || hasBoon('ironwall')) ? 1.30 : 1.0;
      const dist = Math.hypot(GameState.playerVisual.x - inc.targetX, GameState.playerVisual.y - inc.targetY);
      return dist <= inc.reachRadius * athenaBonus;
    }

    function showCanvasBanner(title, sub = '', color = '#fbbf24') {
      GameState.canvasBanner = { title, sub, color, life: 1.0 };
    }

    // Featherblade High-Contrast Shards with Gravity & Angular Rotation (Capped at 120 to prevent memory leaks)
    function spawnParticles(normX, normY, color = '#fbbf24', count = 20) {
      const palette = [color, '#fbbf24', '#f43f5e', '#fef08a'];
      const maxParticlesCap = GameState.qualityMode === 'smooth' ? 20 : 60;
      const actualCount = GameState.qualityMode === 'smooth' ? Math.min(count, 10) : count;
      for (let i = 0; i < actualCount; i++) {
        if (GameState.particles.length >= maxParticlesCap) {
          GameState.particles.shift();
        }
        const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.45;
        const speed = 2.0 + Math.random() * 5.8;
        GameState.particles.push({
          x: normX,
          y: normY,
          px: Math.cos(angle) * speed,
          py: Math.sin(angle) * speed - 2.2,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 2.6,
          gravity: 0.24 + Math.random() * 0.14,
          rot: Math.random() * Math.PI * 2,
          vRot: (Math.random() - 0.5) * 0.36,
          life: 1.0,
          color: palette[i % palette.length],
          size: 3.5 + Math.random() * 4.5,
          sides: (i % 2 === 0) ? 3 : 4
        });
      }
    }

    function spawnFloatingText(normX, normY, text, color = '#fde047') {
      if (GameState.floatingTexts.length >= 24) {
        GameState.floatingTexts.shift();
