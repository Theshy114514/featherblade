  <script>
    /********************************************************************
     * 《羽刃》FEATHERBLADE v6.0 — 终极融合版 (v6.0 博弈骨架 + v5.5 表现血肉)
     *
     * 【本次 P0 核心硬伤修复 & P1 体验全面升级】
     * 1. [P0-1] 彻底废弃所有 setTimeout + 增加挥拍状态锁 (swingLock)：
     *    - 引入基于 dtMs 的全局动作计时器队列 GameState.actionTimers (scheduleAction)，
     *      暂停游戏 (GameState.paused = true) 时所有前摇、AI抽卡与屏幕特效 100% 同步冻结！
     *    - 引入 GameState.swingLock，防止 110ms 挥拍前摇内连点触发多次出球。
     * 2. [P0-2] 物理帧率解耦 (frameFactor = dtMs / 16.67)：
     *    - 羽毛球飞行进度、摇杆步伐速度、体力消耗、粒子与飘字衰减全部乘 frameFactor，
     *      确保 60Hz / 120Hz / 144Hz 屏幕下球速与手感完全一致！
     * 3. [P0-3] AI 牌库按 trajType 科学分类 + 软球变量修复 + 动作特写预警：
     *    - AI 牌库严格根据玩家上一拍的 trajType（high/flat -> 后场牌库；drop -> 网前牌库；smash -> 防守牌库）加权抽卡。
     *    - 动态修正：抓空当（玩家靠前加后场权重，靠后加网前权重）、防背板（连续同球路克制牌权重×2.2）。
     *    - 修复软球触发条件为 AI 自身破绽/体力低下 (aiPostureRatio < 0.42 || aiStamRatio < 0.38)。
     *    - 动作特写预警：杀球脚下闪现红色【危】字、软球头顶环绕金色眩晕星 `✦⭐✦`、吊球大幅前倾。
     * 4. [P0-4] 进攻与防守双重真实音游判定：
     *    - 废除进攻随机判定字，根据蓄力节奏/重心与时机进行真实判定（金色 PERFECT! / 蓝色 GREAT!）。
     * 5. [P0-5] 存档完整性与单回合连击重置：
     *    - saveGameData / loadSaveData 完整保存并读取 permBonus (体力上限等永久加成)。
     *    - resetSaveData 彻底重置 unlockedShots 为初始球路列表。
     *    - 单回合结束 (scorePoint) 重置本回合连击，杜绝跨回合滚雪球。
     * 6. [P1-1 ~ P1-5] 四维过滤灰显带锁提示、落点金色 Perfect 内圈锚点、按住滑动实时预测轨迹虚线、树状分支连招、火柴人关节坐标平滑插值 (lerp) 与击球光晕/落地尘土粒子。
     ********************************************************************/

    const SAVE_STORAGE_KEY = 'featherblade_v6_save';
    const INITIAL_UNLOCKED_SHOTS = ['放网', '挑球', '搓球', '推球', '平抽', '正手过渡', '反手过渡', '高远球', '吊球', '点杀', '重杀'];

    function easeOutCubic(t) {
      const clamped = Math.max(0, Math.min(1, t));
      return 1 - Math.pow(1 - clamped, 3);
    }

    function lerp(a, b, t) {
      return a + (b - a) * t;
    }

    // ==================== 1. FRAME-ACCURATE ACTION TIMER ENGINE (NO setTimeout) ====================
    function scheduleAction(delayMs, callback, tag = '') {
      if (tag) {
        GameState.actionTimers = GameState.actionTimers.filter(t => t.tag !== tag);
      }
      GameState.actionTimers.push({
        remainingMs: Math.max(0, delayMs),
        callback,
        tag
      });
    }

    function clearActionTimers(tagPrefix = '') {
      if (!tagPrefix) {
        GameState.actionTimers = [];
      } else {
        GameState.actionTimers = GameState.actionTimers.filter(t => !t.tag || !t.tag.startsWith(tagPrefix));
      }
    }

    function updateActionTimers(dtMs) {
      if (GameState.paused || !GameState.actionTimers.length) return;
      for (let i = GameState.actionTimers.length - 1; i >= 0; i--) {
        const timer = GameState.actionTimers[i];
        timer.remainingMs -= dtMs;
        if (timer.remainingMs <= 0) {
          GameState.actionTimers.splice(i, 1);
          try {
            timer.callback();
          } catch (err) {
            console.error(err);
          }
        }
      }
    }

    // ==================== 2. WEB AUDIO SYNTHESIS & HAPTICS ====================
    const SoundEngine = {
      ctx: null,
      bgmEnabled: true,
      vibMode: 2,
      bgmNoteAccMs: 0,
      bgmStep: 0,
      crowdStarted: false,
      squeakAccMs: 0,

      init() {
        if (!this.ctx) {
          const AudioCtx = window.AudioContext || window.webkitAudioContext;
          if (AudioCtx) this.ctx = new AudioCtx();
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      },

      startCrowdAmbience() {
        this.init();
        if (!this.ctx || this.crowdStarted) return;
        try {
          const sampleRate = this.ctx.sampleRate;
          const bufLen = sampleRate * 2;
          const buf = this.ctx.createBuffer(1, bufLen, sampleRate);
          const data = buf.getChannelData(0);
          for (let i = 0; i < bufLen; i++) {
            data[i] = (Math.random() * 2 - 1) * 0.5;
          }
          const src = this.ctx.createBufferSource();
          src.buffer = buf;
          src.loop = true;
          const lp = this.ctx.createBiquadFilter();
          lp.type = 'lowpass';
          lp.frequency.setValueAtTime(420, this.ctx.currentTime);
          const g = this.ctx.createGain();
          g.gain.setValueAtTime(0.014, this.ctx.currentTime);
          src.connect(lp);
          lp.connect(g);
          g.connect(this.ctx.destination);
          src.start();
          this.crowdStarted = true;
        } catch (e) {}
      },

      playShoeSqueak() {
        this.init();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const bp = this.ctx.createBiquadFilter();
        const g = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(2950, now);
        osc.frequency.exponentialRampToValueAtTime(3750, now + 0.022);
        osc.frequency.exponentialRampToValueAtTime(2350, now + 0.045);
        bp.type = 'bandpass';
        bp.frequency.setValueAtTime(3200, now);
        bp.Q.setValueAtTime(6.0, now);
        g.gain.setValueAtTime(0.055, now);
        g.gain.exponentialRampToValueAtTime(0.001, now + 0.048);
        osc.connect(bp);
        bp.connect(g);
        g.connect(this.ctx.destination);
        osc.onended = () => { try { osc.disconnect(); bp.disconnect(); g.disconnect(); } catch (e) {} };
        osc.start(now);
        osc.stop(now + 0.05);
      },

      playRefereeWhistle() {
        this.init();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        // Crisp dual-tone referee whistle on scorePoint
        [2820, 3140].forEach((freq, idx) => {
          const osc = this.ctx.createOscillator();
          const g = this.ctx.createGain();
          osc.type = 'sine';
          const startT = now + idx * 0.09;
          const dur = idx === 0 ? 0.07 : 0.22;
          osc.frequency.setValueAtTime(freq, startT);
          osc.frequency.linearRampToValueAtTime(freq + 90, startT + dur * 0.5);
          osc.frequency.linearRampToValueAtTime(freq - 40, startT + dur);
          g.gain.setValueAtTime(0.11, startT);
          g.gain.exponentialRampToValueAtTime(0.001, startT + dur);
          osc.connect(g);
          g.connect(this.ctx.destination);
          osc.onended = () => { try { osc.disconnect(); g.disconnect(); } catch (e) {} };
          osc.start(startT);
          osc.stop(startT + dur + 0.01);
        });
      },

      playStringTension() {
        this.init();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        // Ultra-high-frequency string tension ping on close-up impact
        const osc = this.ctx.createOscillator();
        const g = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(3400, now);
        osc.frequency.exponentialRampToValueAtTime(4950, now + 0.028);
        g.gain.setValueAtTime(0.09, now);
        g.gain.exponentialRampToValueAtTime(0.001, now + 0.030);
        osc.connect(g);
        g.connect(this.ctx.destination);
        osc.onended = () => { try { osc.disconnect(); g.disconnect(); } catch (e) {} };
        osc.start(now);
        osc.stop(now + 0.032);
      },

      playBassDrop() {
        this.init();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        // 扣杀震撼音：sawtooth 从 150Hz 骤降到 40Hz 叠加金属完美弹反声
        const sub = this.ctx.createOscillator();
        const subGain = this.ctx.createGain();
        sub.type = 'sawtooth';
        sub.frequency.setValueAtTime(150, now);
        sub.frequency.exponentialRampToValueAtTime(40, now + 0.42);
        subGain.gain.setValueAtTime(0.40, now);
        subGain.gain.exponentialRampToValueAtTime(0.001, now + 0.44);
        sub.connect(subGain);
        subGain.connect(this.ctx.destination);
        sub.onended = () => { try { sub.disconnect(); subGain.disconnect(); } catch (e) {} };
        sub.start(now);
        sub.stop(now + 0.45);
        this.playMetalPing('parry');
      },

      playBackhandParry() {
        this.init();
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
