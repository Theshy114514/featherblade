    // ==================== 8. P1-1: 4D FILTERING WITH GRAYED-OUT LOCK REASONS & BRANCHING COMBO TREE ====================
    function getZoneShotsWithLockReason(pos) {
      const cog = GameState.pCog;
      const { power, control, sense } = GameState.attrs;

      const zoneUnlocked = GameState.unlockedShots.filter(k => {
        const s = SHOTS[k];
        return s && s.pos.includes(pos);
      });

      const evaluated = zoneUnlocked.map(k => {
        const s = SHOTS[k];
        const reasons = [];
        if (cog < 35 && s.trajType === 'smash') {
          reasons.push(`需重心≥35`);
        } else if (cog < (s.minCog || 0)) {
          reasons.push(`需重心≥${s.minCog}`);
        }
        const req = s.reqAttr || { power: 0, control: 0, sense: 0 };
        if (power < (req.power || 0)) reasons.push(`🔒力量${power}/${req.power}`);
        if (control < (req.control || 0)) reasons.push(`🔒控球${control}/${req.control}`);
        if (sense < (req.sense || 0)) reasons.push(`🔒球感${sense}/${req.sense}`);

        return {
          key: k,
          shot: s,
          locked: reasons.length > 0,
          lockReason: reasons[0] || ''
        };
      });

      evaluated.sort((a, b) => Number(a.locked) - Number(b.locked));
      return evaluated.slice(0, 4);
    }

    function isShotRecommendedForCombo(shotName) {
      const rec = GameState.recentShots;
      if (rec.length === 1) {
        const s1 = rec[0];
        if ((s1 === '高远球' || s1 === '平高球' || s1 === '挑球') &&
            (shotName === '吊球' || shotName === '劈吊' || shotName === '放网' || shotName === '搓球')) return true;
        if ((s1 === '放网' || s1 === '吊球') &&
            (shotName === '搓球' || shotName === '勾对角' || shotName === '挑球' || shotName === '高远球')) return true;
      } else if (rec.length >= 2) {
        const s1 = rec[rec.length - 2];
        const s2 = rec[rec.length - 1];
        if ((s1 === '高远球' || s1 === '平高球') && (s2 === '吊球' || s2 === '劈吊') &&
            (shotName === '重杀' || shotName === '点杀' || shotName === '劈杀')) return true;
        if ((s1 === '高远球' || s1 === '平高球' || s1 === '挑球') && (s2 === '放网' || s2 === '搓球' || s2 === '吊球') &&
            (shotName === '扑球' || shotName === '推球' || shotName === '平抽')) return true;
        if (s1 === '放网' && (s2 === '搓球' || s2 === '勾对角') &&
            (shotName === '扑球' || shotName === '推球' || shotName === '平抽')) return true;
        if ((s1 === '放网' || s1 === '吊球') && (s2 === '挑球' || s2 === '高远球') &&
            (shotName === '重杀' || shotName === '点杀' || shotName === '劈杀')) return true;
      }
      return false;
    }

